---
// src/components/VisualizationMarquee.astro
// Full-bleed showcase: every visualization type, scrolling right→left, hover-to-pause.
// Static. No runtime deps. Wispr Flow aesthetic. See Phase 5.8 spec.

import { CATEGORIES } from '../data/visualizations.js';

interface Props {
  /** "default" = 3 rows (gallery), "compact" = 2 rows (home band) */
  variant?: 'default' | 'compact';
  /** Show the eyebrow + headline above the rows */
  heading?: boolean;
  /** Background tone for the section block */
  tone?: 'cream' | 'cream-darker';
}

const {
  variant = 'default',
  heading = true,
  tone = 'cream-darker',
} = Astro.props;

const ROWS = variant === 'compact' ? 2 : 3;

const ACCENT: Record<string, string> = {
  mindmap: '#4824DE', brainstorming: '#4824DE', business: '#4824DE',
  metaphors: '#4824DE', narrative: '#4824DE',
  process: '#8CC8EE', hierarchy: '#8CC8EE',
  data: '#C8DC2E', cause: '#C8DC2E',
  timelines: '#EF8CBD', parts: '#EF8CBD',
  comparison: '#E85A28', problems: '#E85A28',
};
const FALLBACK_ACCENT = '#4824DE';
const PLACEHOLDER_SVG =
  '<svg viewBox="0 0 96 96" fill="none" stroke="#1F2D24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="28" y="28" width="40" height="40" rx="6"/><line x1="38" y1="48" x2="58" y2="48"/></svg>';

const allTypes = CATEGORIES.flatMap((cat: any) =>
  cat.types.map((t: any) => ({
    id: t.id,
    name: t.name,
    categoryId: cat.id,
    categoryName: cat.name,
    accent: ACCENT[cat.id] || FALLBACK_ACCENT,
    iconSvg: t.iconSvg || PLACEHOLDER_SVG,
  }))
);

// Build-time guard: catch a data regression loudly.
if (allTypes.length !== 76) {
  console.warn(
    `[VisualizationMarquee] Expected 76 types, got ${allTypes.length}. ` +
    `Check CATEGORIES / ICON_SVGS wiring.`
  );
}

// Round-robin distribute so each row mixes categories (and accents).
const rows: any[][] = Array.from({ length: ROWS }, () => []);
allTypes.forEach((t, i) => rows[i % ROWS].push(t));

// Per-row target speed (px/sec). Intentionally non-monotonic for organic feel.
const ROW_SPEEDS = [34, 42, 30, 38];

const sectionBg = tone === 'cream' ? 'bg-cream' : 'bg-cream-darker';
---

<section
  class={`vmq ${sectionBg}`}
  aria-roledescription="carousel"
  aria-label="Every visualization type VisualCraft can help you create"
>
  {heading && (
    <div class="container-page vmq-head">
      <span class="pill-lavender vmq-eyebrow">76 visualization types</span>
      <h2 class="headline-h2 vmq-title">
        Every visual. One click away.
      </h2>
      <p class="vmq-sub">
        Hover to pause. Click to build.
      </p>
    </div>
  )}

  <div class="vmq-viewport" data-vmq-viewport>
    {rows.map((row, rowIndex) => (
      <div
        class="vmq-row"
        data-vmq-row
        data-speed={ROW_SPEEDS[rowIndex % ROW_SPEEDS.length]}
      >
        <div class="vmq-track" data-vmq-track>
          {/* Set A — real, focusable links */}
          {row.map((t) => (
            <a
              class="vmq-card"
              href={`/generate?type=${t.id}&category=${t.categoryId}&from=marquee`}
              style={`--accent:${t.accent}`}
              aria-label={`Use the ${t.name} template (${t.categoryName})`}
            >
              <div class="vmq-art" set:html={t.iconSvg}></div>
              <div class="vmq-meta">
                <span class="vmq-name">{t.name}</span>
                <span class="vmq-cat">{t.categoryName}</span>
              </div>
              <span class="vmq-use" aria-hidden="true">Use →</span>
            </a>
          ))}
          {/* Set B — visual duplicate for seamless loop; hidden from a11y + tab order */}
          {row.map((t) => (
            <a
              class="vmq-card"
              href={`/generate?type=${t.id}&category=${t.categoryId}&from=marquee`}
              style={`--accent:${t.accent}`}
              aria-hidden="true"
              tabindex="-1"
            >
              <div class="vmq-art" set:html={t.iconSvg}></div>
              <div class="vmq-meta">
                <span class="vmq-name">{t.name}</span>
                <span class="vmq-cat">{t.categoryName}</span>
              </div>
              <span class="vmq-use" aria-hidden="true">Use →</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* ── Section shell ─────────────────────────────────────────── */
  .vmq {
    width: 100%;
    padding-block: 4rem;
    overflow: hidden; /* contain the full-bleed track */
  }
  @media (min-width: 768px) {
    .vmq { padding-block: 5.5rem; }
  }

  .vmq-head {
    text-align: center;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }
  .vmq-eyebrow { align-self: center; }
  .vmq-title { margin: 0; }
  .vmq-sub {
    max-width: 34rem;
    margin: 0;
    color: var(--ink-secondary, #5C5546);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ── Viewport (edge fade + full bleed) ─────────────────────── */
  .vmq-viewport {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  @media (min-width: 768px) {
    .vmq-viewport { gap: 1rem; }
    .vmq-viewport {
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
              mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
    }
  }

  /* ── Row + track ───────────────────────────────────────────── */
  .vmq-row { overflow: hidden; }

  .vmq-track {
    display: flex;
    width: max-content;
    /* fallback duration if JS disabled; JS overrides per measured width */
    animation: vmq-scroll var(--vmq-duration, 60s) linear infinite;
    will-change: transform;
  }

  /* Pause this row on hover / keyboard focus */
  .vmq-row:hover .vmq-track,
  .vmq-row:focus-within .vmq-track,
  .vmq-row.is-touch-paused .vmq-track {
    animation-play-state: paused;
  }

  /* Pause everything when off-screen / tab hidden (toggled by JS) */
  .vmq.is-frozen .vmq-track {
    animation-play-state: paused;
  }

  @keyframes vmq-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Card ──────────────────────────────────────────────────── */
  .vmq-card {
    --w: 150px;
    --h: 172px;
    --art-h: 96px;
    --vmq-gap: 12px;

    flex: 0 0 var(--w);
    width: var(--w);
    height: var(--h);
    margin-right: var(--vmq-gap); /* gap lives on the card — required for seamless loop */
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    background: var(--cream-lightest, #FDFBF5);
    border: 1px solid #E0DAC8;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  @media (min-width: 768px) {
    .vmq-card {
      --w: 196px;
      --h: 210px;
      --art-h: 128px;
      --vmq-gap: 16px;
    }
  }

  /* subtle hand-placed rotation, straightens on hover */
  .vmq-card:nth-child(odd)  { transform: rotate(-0.6deg); }
  .vmq-card:nth-child(even) { transform: rotate(0.6deg); }

  .vmq-card:hover,
  .vmq-card:focus-visible {
    transform: rotate(0deg) translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.10);
    border-color: #C8C0AC;
    z-index: 2;
  }
  .vmq-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ── Art zone ──────────────────────────────────────────────── */
  .vmq-art {
    height: var(--art-h);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-bottom: 1px solid #E0DAC8;
  }
  .vmq-art :global(svg) {
    width: 68%;
    height: 68%;
    display: block;
  }

  /* ── Meta ──────────────────────────────────────────────────── */
  .vmq-meta {
    flex: 1;
    padding: 0.55rem 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .vmq-name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--ink-primary, #0A0A0A);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vmq-cat {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-tertiary, #8A8270);
  }

  /* ── "Use →" reveal ───────────────────────────────────────── */
  .vmq-use {
    position: absolute;
    right: 0.7rem;
    bottom: 0.55rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 160ms ease, transform 160ms ease;
    pointer-events: none;
  }
  .vmq-card:hover .vmq-use,
  .vmq-card:focus-visible .vmq-use {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Reduced motion: stop the animation, allow manual scroll ── */
  @media (prefers-reduced-motion: reduce) {
    .vmq-track {
      animation: none !important;
      transform: none !important;
    }
    /* hide the duplicate Set B so it isn't dead weight when not looping */
    .vmq-track > .vmq-card[aria-hidden='true'] { display: none; }
    .vmq-row {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }
    .vmq-card { scroll-snap-align: start; }
    .vmq-card:nth-child(odd),
    .vmq-card:nth-child(even) { transform: none; }
  }
</style>

<script>
  // Progressive enhancement only. If this never runs, CSS still animates + hover-pauses.
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.vmq'));
    if (!sections.length) return;

    sections.forEach((section) => {
      const rows = Array.from(section.querySelectorAll<HTMLElement>('[data-vmq-row]'));

      // 1) Normalize speed: duration = setWidth / pxPerSec, so every row reads
      //    at a consistent pace regardless of card count.
      const isMobile = window.matchMedia('(max-width: 640px)').matches;
      const mobileMul = isMobile ? 0.8 : 1;

      const applyDurations = () => {
        if (reduce) return;
        rows.forEach((row) => {
          const track = row.querySelector<HTMLElement>('[data-vmq-track]');
          if (!track) return;
          const speed = (parseFloat(row.dataset.speed || '34') || 34) * mobileMul;
          // Track holds 2 identical sets → one set is half the scrollWidth.
          const setWidth = track.scrollWidth / 2;
          if (setWidth > 0 && speed > 0) {
            const duration = setWidth / speed; // seconds
            track.style.setProperty('--vmq-duration', `${duration}s`);
          }
        });
      };

      applyDurations();
      // Recompute after web fonts settle (card widths are fixed, but be safe).
      if ((document as any).fonts?.ready) {
        (document as any).fonts.ready.then(applyDurations).catch(() => {});
      }
      window.addEventListener('resize', debounce(applyDurations, 200));

      // 2) Touch: pause the touched row briefly so it can be read, then resume.
      rows.forEach((row) => {
        let t: number | undefined;
        row.addEventListener(
          'touchstart',
          () => {
            row.classList.add('is-touch-paused');
            window.clearTimeout(t);
            t = window.setTimeout(() => row.classList.remove('is-touch-paused'), 2500);
          },
          { passive: true }
        );
      });

      // 3) Freeze whole section when off-screen (battery / GPU saver).
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              section.classList.toggle('is-frozen', !e.isIntersecting);
            });
          },
          { rootMargin: '120px 0px' }
        );
        io.observe(section);
      }
    });

    // 4) Freeze on hidden tab (applies to all sections).
    document.addEventListener('visibilitychange', () => {
      const frozen = document.hidden;
      sections.forEach((s) => {
        // don't fight the IntersectionObserver: only force-freeze on hide,
        // and on show let IO reassert correct state next tick.
        if (frozen) s.classList.add('is-frozen');
      });
      if (!frozen) {
        // brief defer so IO can re-evaluate visibility
        requestAnimationFrame(() => {
          sections.forEach((s) => {
            const r = s.getBoundingClientRect();
            const onScreen = r.bottom > -120 && r.top < window.innerHeight + 120;
            s.classList.toggle('is-frozen', !onScreen);
          });
        });
      }
    });

    function debounce<T extends (...a: any[]) => void>(fn: T, ms: number) {
      let id: number | undefined;
      return (...args: Parameters<T>) => {
        window.clearTimeout(id);
        id = window.setTimeout(() => fn(...args), ms);
      };
    }
  })();
</script>
