---
// LandingWalkthrough.astro
// Interactive walkthrough: step cards on the left; a browser mockup on the right that
// plays recorded videos of the real /generate flow (auto-advancing per step), and can
// swap to the live, interactive /generate app via the "Try it live" toggle.
---

<div class="landing-walkthrough grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mt-12 md:mt-16 text-left">
  <!-- Left: Step Selection Cards -->
  <div class="lg:col-span-5 flex flex-col gap-4">
    <!-- Step 1 Card -->
    <button
      type="button"
      data-walkthrough-step="1"
      class="walkthrough-card active text-left p-6 rounded-card border-1.5 border-white bg-white/5 transition-all hover:bg-white/10"
      aria-label="Step 1: Pick your visual"
    >
      <div class="flex items-start gap-4">
        <span class="walkthrough-num flex-shrink-0 w-10 h-10 rounded-full bg-accent-lime text-ink-primary font-serif font-bold text-lg flex items-center justify-center border-1.5 border-ink-primary shadow-hard-sm">
          1
        </span>
        <div>
          <h3 class="font-serif text-lg font-semibold text-white leading-snug">Pick your visual</h3>
          <p class="text-sm text-ink-on-dark-muted mt-2 leading-relaxed">
            76 types across 13 categories.<br />
            Mindmaps, charts, frameworks, timelines — it's all here.
          </p>
        </div>
      </div>
    </button>

    <!-- Step 2 Card -->
    <button
      type="button"
      data-walkthrough-step="2"
      class="walkthrough-card text-left p-6 rounded-card border-1.5 border-transparent bg-transparent transition-all hover:bg-white/5"
      aria-label="Step 2: Choose your style"
    >
      <div class="flex items-start gap-4">
        <span class="walkthrough-num flex-shrink-0 w-10 h-10 rounded-full bg-cream-lightest text-ink-secondary font-serif font-bold text-lg flex items-center justify-center border-1.5 border-ink-primary/20 opacity-60">
          2
        </span>
        <div>
          <h3 class="font-serif text-lg font-semibold text-ink-on-dark-muted leading-snug transition-colors walkthrough-title">Choose your style</h3>
          <p class="text-sm text-ink-on-dark-muted/60 mt-2 leading-relaxed transition-colors walkthrough-desc">
            Colors, connectors, mood.<br />
            Make it yours.
          </p>
        </div>
      </div>
    </button>

    <!-- Step 3 Card -->
    <button
      type="button"
      data-walkthrough-step="3"
      class="walkthrough-card text-left p-6 rounded-card border-1.5 border-transparent bg-transparent transition-all hover:bg-white/5"
      aria-label="Step 3: Copy. Paste. Done."
    >
      <div class="flex items-start gap-4">
        <span class="walkthrough-num flex-shrink-0 w-10 h-10 rounded-full bg-cream-lightest text-ink-secondary font-serif font-bold text-lg flex items-center justify-center border-1.5 border-ink-primary/20 opacity-60">
          3
        </span>
        <div>
          <h3 class="font-serif text-lg font-semibold text-ink-on-dark-muted leading-snug transition-colors walkthrough-title">Copy. Paste. Done.</h3>
          <p class="text-sm text-ink-on-dark-muted/60 mt-2 leading-relaxed transition-colors walkthrough-desc">
            Works with ChatGPT, Claude, Gemini, Midjourney, DALL·E.<br />
            One prompt. Any tool.
          </p>
        </div>
      </div>
    </button>
  </div>

  <!-- Right: Premium Browser Mockup Container -->
  <div class="lg:col-span-7">
    <div class="browser-mockup rounded-[16px] border-2 border-white/20 bg-forest-darkest shadow-2xl overflow-hidden relative transition-all duration-300">
      <!-- Browser Top bar -->
      <div class="browser-header flex items-center gap-3 px-4 py-3 bg-forest-darker/60 border-b border-white/10">
        <!-- Control dots -->
        <div class="flex gap-1.5 flex-shrink-0">
          <span class="w-3 h-3 rounded-full bg-[#FF5F56]"></span>
          <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
          <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
        </div>
        <!-- Address Bar -->
        <div class="flex-1 bg-forest-darkest/50 border border-white/5 rounded-md text-[11px] text-ink-on-dark-muted/60 py-1 px-4 text-center select-none font-mono tracking-tight truncate">
          illustratewords.com/generate
        </div>
        <!-- Try it live / Back to tour toggle -->
        <button
          type="button"
          id="walkthrough-live-toggle"
          class="flex-shrink-0 inline-flex items-center gap-1.5 rounded-full bg-accent-lime text-ink-primary font-sans text-xs font-bold px-3 py-1.5 border-1.5 border-ink-primary/20 shadow-hard-sm transition-transform hover:-translate-y-px"
          aria-pressed="false"
        >
          <svg class="w-3 h-3" data-live-icon-play fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
          <svg class="w-3 h-3 hidden" data-live-icon-back fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5 5-5M18 12H6" /></svg>
          <span data-live-label>Try it live</span>
        </button>
      </div>
      <!-- Browser Window Content -->
      <div class="browser-content aspect-[16/10] bg-forest-darker relative overflow-hidden flex items-center justify-center">
        <!-- Tour mode: recorded step videos -->
        <div id="walkthrough-tour" class="absolute inset-0">
          <div class="absolute inset-0 transition-opacity duration-500 active-slide" id="slide-1">
            <video class="w-full h-full object-cover object-top select-none" data-step-video muted playsinline preload="auto" poster="/images/walkthrough/step_1.jpg" aria-label="Stage 1: pick your visualization type">
              <source src="/images/walkthrough/step_1.webm" type="video/webm" />
              <source src="/images/walkthrough/step_1.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="absolute inset-0 transition-opacity duration-500 opacity-0" id="slide-2">
            <video class="w-full h-full object-cover object-top select-none" data-step-video muted playsinline preload="none" poster="/images/walkthrough/step_2.jpg" aria-label="Stage 2: choose palette and style">
              <source src="/images/walkthrough/step_2.webm" type="video/webm" />
              <source src="/images/walkthrough/step_2.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="absolute inset-0 transition-opacity duration-500 opacity-0" id="slide-3">
            <video class="w-full h-full object-cover object-top select-none" data-step-video muted playsinline preload="none" poster="/images/walkthrough/step_3.jpg" aria-label="Stage 3: generate and copy your prompt">
              <source src="/images/walkthrough/step_3.webm" type="video/webm" />
              <source src="/images/walkthrough/step_3.mp4" type="video/mp4" />
            </video>
          </div>
          <!-- Click-to-interact hint -->
          <button type="button" id="walkthrough-interact-hint" class="group absolute inset-0 z-20 flex items-end justify-center pb-5 bg-transparent cursor-pointer">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-forest-darkest/80 backdrop-blur-sm text-white text-xs font-semibold px-4 py-2 border border-white/15 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200">
              Click to try it yourself
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </button>
        </div>
        <!-- Live mode: the real interactive app (iframe loaded on demand) -->
        <div id="walkthrough-live" class="absolute inset-0 hidden overflow-hidden bg-cream-lightest"></div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Step card hover and active transitions */
  .walkthrough-card.active {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3);
  }
  .walkthrough-card.active .walkthrough-title {
    color: #ffffff !important;
  }
  .walkthrough-card.active .walkthrough-desc {
    color: rgba(245, 241, 230, 0.85) !important;
  }
  .walkthrough-card:not(.active) {
    cursor: pointer;
  }
  .walkthrough-card:not(.active):hover {
    background-color: rgba(255, 255, 255, 0.04);
  }

  .browser-mockup {
    transform: perspective(1000px) rotateY(-2deg) rotateX(1deg);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .browser-mockup:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg);
  }
</style>

<script>
  (function() {
    const cards = document.querySelectorAll('.walkthrough-card');
    const slides = [
      document.getElementById('slide-1'),
      document.getElementById('slide-2'),
      document.getElementById('slide-3')
    ].filter(Boolean);
    const videos = slides.map((s) => s.querySelector('[data-step-video]'));
    const tour = document.getElementById('walkthrough-tour');
    const live = document.getElementById('walkthrough-live');
    const liveToggle = document.getElementById('walkthrough-live-toggle');
    const interactHint = document.getElementById('walkthrough-interact-hint');
    let activeIndex = 0;
    let fallbackTimer = null;
    let isLive = false;

    // ---- Tour: play one step video at a time, advance when it ends ----------
    function playActiveVideo() {
      videos.forEach((v, i) => {
        if (!v) return;
        if (i === activeIndex) {
          try { v.currentTime = 0; } catch (e) {}
          const p = v.play();
          if (p && p.catch) p.catch(() => {});
        } else {
          v.pause();
        }
      });
      // Safety net in case a video's `ended` event never fires (autoplay blocked, etc.)
      clearTimeout(fallbackTimer);
      fallbackTimer = setTimeout(() => advance(), 14000);
    }

    function setStep(idx, opts) {
      opts = opts || {};
      if (idx === activeIndex && !opts.force) return;

      cards.forEach((card, i) => {
        const num = card.querySelector('.walkthrough-num');
        if (i === idx) {
          card.classList.add('active');
          card.style.borderColor = 'rgba(255, 255, 255, 0.2)';
          if (num) {
            num.className = 'walkthrough-num flex-shrink-0 w-10 h-10 rounded-full bg-accent-lime text-ink-primary font-serif font-bold text-lg flex items-center justify-center border-1.5 border-ink-primary shadow-hard-sm';
            num.style.opacity = '1';
          }
        } else {
          card.classList.remove('active');
          card.style.borderColor = 'transparent';
          if (num) {
            num.className = 'walkthrough-num flex-shrink-0 w-10 h-10 rounded-full bg-cream-lightest text-ink-secondary font-serif font-bold text-lg flex items-center justify-center border-1.5 border-ink-primary/20';
            num.style.opacity = '0.6';
          }
        }
      });

      slides.forEach((slide, i) => {
        if (i === idx) {
          slide.classList.remove('opacity-0');
          slide.classList.add('active-slide');
          slide.style.opacity = '1';
          slide.style.zIndex = '10';
        } else {
          slide.classList.add('opacity-0');
          slide.classList.remove('active-slide');
          slide.style.opacity = '0';
          slide.style.zIndex = '1';
        }
      });

      activeIndex = idx;
      if (!isLive) playActiveVideo();
    }

    function advance() {
      if (isLive) return;
      setStep((activeIndex + 1) % slides.length);
    }

    // Advance as soon as the current step's video finishes.
    videos.forEach((v, i) => {
      if (!v) return;
      v.addEventListener('ended', () => { if (!isLive && i === activeIndex) advance(); });
    });

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => { if (isLive) exitLive(); setStep(idx, { force: true }); });
    });

    // ---- Live mode: swap in the real, interactive /generate app ------------
    function enterLive() {
      if (isLive) return;
      isLive = true;
      clearTimeout(fallbackTimer);
      videos.forEach((v) => v && v.pause());
      if (!live.querySelector('iframe')) {
        const frame = document.createElement('iframe');
        frame.src = '/generate';
        frame.title = 'Try the Illustrate Words prompt builder';
        frame.loading = 'lazy';
        // Render the app at ~2x the container width, then scale to fit, so the
        // embedded wizard shows its full desktop layout instead of a cramped one.
        frame.className = 'border-0 bg-cream-lightest';
        frame.style.width = '200%';
        frame.style.height = '200%';
        frame.style.transformOrigin = 'top left';
        frame.style.transform = 'scale(0.5)';
        live.appendChild(frame);
      }
      tour.classList.add('hidden');
      live.classList.remove('hidden');
      liveToggle.setAttribute('aria-pressed', 'true');
      liveToggle.querySelector('[data-live-label]').textContent = 'Back to tour';
      liveToggle.querySelector('[data-live-icon-play]').classList.add('hidden');
      liveToggle.querySelector('[data-live-icon-back]').classList.remove('hidden');
    }

    function exitLive() {
      if (!isLive) return;
      isLive = false;
      live.classList.add('hidden');
      tour.classList.remove('hidden');
      liveToggle.setAttribute('aria-pressed', 'false');
      liveToggle.querySelector('[data-live-label]').textContent = 'Try it live';
      liveToggle.querySelector('[data-live-icon-play]').classList.remove('hidden');
      liveToggle.querySelector('[data-live-icon-back]').classList.add('hidden');
      playActiveVideo();
    }

    liveToggle.addEventListener('click', () => { isLive ? exitLive() : enterLive(); });
    if (interactHint) interactHint.addEventListener('click', enterLive);

    // ---- Kick off: only start playing once the section is in view ----------
    function start() { setStep(0, { force: true }); }
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { start(); io.disconnect(); }
        });
      }, { threshold: 0.35 });
      io.observe(tour);
    } else {
      start();
    }
  })();
</script>
