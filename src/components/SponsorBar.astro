---
// SponsorBar.astro — Sponsor advertisement component
// Replicates trustmrr.com ad display system for illustratewords.com

let initialSponsors = [];
try {
  const siteUrl = Astro.site ? Astro.site.origin : 'https://illustratewords.com';
  const response = await fetch(`${siteUrl}/api/sponsors`);
  if (response.ok) {
    const data = await response.json();
    initialSponsors = data.sponsors || [];
  }
} catch (e) {
  initialSponsors = [];
}
---

<div 
  id="sponsor-bar-root" 
  data-initial={JSON.stringify(initialSponsors)}
  class="contents"
>
  <!-- Desktop Left Sidebar (5 rotating cards) -->
  <aside 
    class="sponsor-bar-container hidden xl:flex flex-col fixed left-4 top-[100px] w-[180px] z-40" 
    aria-label="Sponsors Left"
  >
    <div class="text-[10px] uppercase tracking-wider text-ink-tertiary font-bold mb-2 text-center select-none">
      ✦ Sponsors
    </div>
    <div id="left-sidebar-cards" class="space-y-3">
      <!-- Generated Client-Side -->
    </div>
  </aside>

  <!-- Desktop Right Sidebar (5 rotating cards + Advertise button) -->
  <aside 
    class="sponsor-bar-container hidden xl:flex flex-col fixed right-4 top-[100px] w-[180px] z-40" 
    aria-label="Sponsors Right"
  >
    <div class="text-[10px] uppercase tracking-wider text-ink-tertiary font-bold mb-2 text-center select-none">
      ✦ Sponsors
    </div>
    <div id="right-sidebar-cards" class="space-y-3">
      <!-- Generated Client-Side -->
    </div>
    <!-- Advertise Link at the bottom of the right sidebar -->
    <button 
      id="open-advertise-modal"
      class="mt-3 text-[11px] font-semibold text-ink-secondary hover:text-ink-primary text-center select-none flex items-center justify-center gap-1 w-full hover:underline focus:outline-none cursor-pointer"
    >
      📢 Advertise
    </button>
  </aside>

  <!-- Mobile Top Banner -->
  <aside 
    class="sponsor-bar-container flex xl:hidden fixed top-0 left-0 w-full h-[56px] bg-cream-lighter border-b border-ink-primary/10 items-center justify-between px-4 z-40" 
    aria-label="Sponsors Top"
  >
    <span class="text-[9px] uppercase tracking-wider text-ink-tertiary font-bold select-none">Sponsor</span>
    <div id="top-banner-card" class="flex-1 max-w-md mx-auto px-4 flex justify-center">
      <!-- Generated Client-Side -->
    </div>
  </aside>

  <!-- Mobile Bottom Banner -->
  <aside 
    class="sponsor-bar-container flex xl:hidden fixed bottom-0 left-0 w-full h-[56px] bg-cream-lighter border-t border-ink-primary/10 items-center justify-between px-4 z-40" 
    aria-label="Sponsors Bottom"
  >
    <span class="text-[9px] uppercase tracking-wider text-ink-tertiary font-bold select-none">Sponsor</span>
    <div id="bottom-banner-card" class="flex-1 max-w-md mx-auto px-4 flex justify-center">
      <!-- Generated Client-Side -->
    </div>
  </aside>

  <!-- Advertise Modal (Matches TrustMRR modal screenshot in Wispr-Editorial theme) -->
  <div 
    id="advertise-modal" 
    class="fixed inset-0 bg-ink-primary/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4"
  >
    <div class="bg-cream border-1.5 border-ink-primary rounded-[20px] max-w-md w-full p-6 relative shadow-hard animate-modal-in">
      <!-- Close Button -->
      <button 
        id="close-advertise-modal" 
        class="absolute top-4 right-4 text-ink-secondary hover:text-ink-primary font-bold text-lg select-none cursor-pointer focus:outline-none"
        aria-label="Close modal"
      >
        ✕
      </button>

      <h3 class="font-serif text-2xl font-bold text-ink-primary mb-1">
        Advertise on <em>Illustrate Words</em>
      </h3>
      <p class="text-xs text-ink-secondary mb-6">
        Reach thousands of digital creators, designers, and consultants every month.
      </p>

      <!-- Stats Cards Grid -->
      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="bg-cream-lighter border border-ink-primary/10 rounded-[12px] p-3 text-center">
          <div class="text-[10px] font-bold uppercase text-ink-tertiary mb-1">Traffic</div>
          <div class="text-sm font-serif font-bold text-ink-primary">10K+</div>
          <div class="text-[9px] text-ink-secondary">Monthly visitors</div>
        </div>
        <div class="bg-cream-lighter border border-ink-primary/10 rounded-[12px] p-3 text-center">
          <div class="text-[10px] font-bold uppercase text-ink-tertiary mb-1">Audience</div>
          <div class="text-sm font-serif font-bold text-ink-primary">High-Intent</div>
          <div class="text-[9px] text-ink-secondary">Visual builders</div>
        </div>
        <div class="bg-cream-lighter border border-ink-primary/10 rounded-[12px] p-3 text-center">
          <div class="text-[10px] font-bold uppercase text-ink-tertiary mb-1">Slots</div>
          <div class="text-sm font-serif font-bold text-ink-primary">
            <span id="modal-available-count">20</span>/20
          </div>
          <div class="text-[9px] text-ink-secondary">Spots left</div>
        </div>
      </div>

      <!-- How it works -->
      <h4 class="text-xs font-bold uppercase text-ink-primary mb-2">How it works</h4>
      <p class="text-xs text-ink-secondary leading-relaxed mb-6">
        Your product appears in rotating sponsor slots on desktop sidebars and mobile banners across all pages. Sponsors rotate every 10 seconds to ensure fair visibility among all advertisers.
      </p>

      <!-- Pricing Box -->
      <div class="bg-cream-lighter border border-ink-primary/10 rounded-[12px] p-4 mb-6">
        <div class="flex justify-between items-center mb-1">
          <span class="text-xs font-bold text-ink-primary">Monthly rate</span>
          <span class="text-sm font-serif font-bold text-ink-primary">$50/month</span>
        </div>
        <p class="text-[10px] text-ink-secondary leading-relaxed" id="modal-pricing-note">
          Cancel anytime. Ad goes live within 24 hours of asset submission.
        </p>
      </div>

      <!-- Stripe CTA Button -->
      <a 
        href="STRIPE_PAYMENT_LINK_PLACEHOLDER" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-accent w-full py-3 text-center block text-sm font-semibold shadow-btn hover:shadow-btn-hover select-none"
      >
        Reserve Sponsor Slot ($50/month) ✦
      </a>
    </div>
  </div>
</div>

<style is:global>
  /* Dynamic body padding applied only when mobile banners are active */
  body.has-sponsor-banners {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  @media (min-width: 1280px) {
    body.has-sponsor-banners {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
  }

  /* Modal animation keyframe entry */
  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-modal-in {
    animation: modalIn 0.2s ease-out forwards;
  }
</style>

<script>
  // Escapes text safely to prevent XSS vulnerability
  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Formats a single sponsor card HTML block
  function renderCard(sponsor) {
    if (!sponsor) return '';

    const logoHtml = sponsor.logo_url
      ? `<img src="${escapeHtml(sponsor.logo_url)}" alt="${escapeHtml(sponsor.name)} logo" class="w-10 h-10 object-contain rounded-md border border-ink-primary/5" />`
      : `<div class="w-10 h-10 rounded-md bg-accent-lavender flex items-center justify-center font-serif font-bold text-ink-primary text-sm select-none">${escapeHtml(sponsor.name[0] || '✦')}</div>`;

    return `
      <a 
        href="${escapeHtml(sponsor.website_url)}" 
        target="_blank" 
        rel="noopener sponsored" 
        class="flex items-center gap-3 p-3 bg-cream-lighter border border-ink-primary/15 rounded-[12px] hover:-translate-y-0.5 hover:shadow-card transition-all duration-200 w-full"
      >
        ${logoHtml}
        <div class="flex-1 min-w-0">
          <div class="text-[12px] font-bold text-ink-primary truncate">${escapeHtml(sponsor.name)}</div>
          <div class="text-[10px] text-ink-secondary truncate leading-tight">${escapeHtml(sponsor.tagline)}</div>
        </div>
      </a>
    `;
  }

  async function initSponsorBars() {
    const root = document.getElementById('sponsor-bar-root');
    if (!root) return;

    let sponsors = [];

    // Try to fetch current active list dynamically from the D1 edge API
    try {
      const res = await fetch('/api/sponsors');
      if (res.ok) {
        const data = await res.json();
        sponsors = data.sponsors || [];
      }
    } catch (e) {
      // Fall back to server-side built state if network fails
      try {
        sponsors = JSON.parse(root.getAttribute('data-initial') || '[]');
      } catch (err) {
        sponsors = [];
      }
    }

    // If no sponsors are currently active, hide all containers completely (silent fallback)
    if (sponsors.length === 0) {
      document.querySelectorAll('.sponsor-bar-container').forEach(el => el.classList.add('hidden'));
      document.body.classList.remove('has-sponsor-banners');
      return;
    }

    // Activate mobile body paddings
    document.body.classList.add('has-sponsor-banners');

    const total = sponsors.length;

    // --- Desktop Layout Configuration (5 stacks per sidebar) ---
    let leftIndex = 0;
    let rightIndex = Math.min(5, total % 5); // Offset start of right sidebar to avoid exact duplicate stacks

    function updateDesktopLeft() {
      const container = document.getElementById('left-sidebar-cards');
      if (!container) return;
      
      let html = '';
      for (let i = 0; i < 5; i++) {
        const sponsor = sponsors[(leftIndex + i) % total];
        html += renderCard(sponsor);
      }
      container.innerHTML = html;
    }

    function updateDesktopRight() {
      const container = document.getElementById('right-sidebar-cards');
      if (!container) return;

      let html = '';
      for (let i = 0; i < 5; i++) {
        const sponsor = sponsors[(rightIndex + i) % total];
        html += renderCard(sponsor);
      }
      container.innerHTML = html;
    }

    // --- Mobile Layout Configuration ---
    let topIndex = 0;
    let bottomIndex = Math.min(1, total % 2);

    function updateMobileTop() {
      const container = document.getElementById('top-banner-card');
      if (container) {
        container.innerHTML = renderCard(sponsors[topIndex % total]);
      }
    }

    function updateMobileBottom() {
      const container = document.getElementById('bottom-banner-card');
      if (container) {
        container.innerHTML = renderCard(sponsors[bottomIndex % total]);
      }
    }

    // Initial Renders
    updateDesktopLeft();
    updateDesktopRight();
    updateMobileTop();
    updateMobileBottom();

    // Start Rotation intervals
    // Desktop rotation: every 10s. Right sidebar starts 5s later.
    setInterval(() => {
      leftIndex = (leftIndex + 1) % total;
      updateDesktopLeft();
    }, 10000);

    setTimeout(() => {
      setInterval(() => {
        rightIndex = (rightIndex + 1) % total;
        updateDesktopRight();
      }, 10000);
    }, 5000);

    // Mobile rotation: every 8s. Bottom starts 4s later.
    setInterval(() => {
      topIndex = (topIndex + 1) % total;
      updateMobileTop();
    }, 8000);

    setTimeout(() => {
      setInterval(() => {
        bottomIndex = (bottomIndex + 1) % total;
        updateMobileBottom();
      }, 8000);
    }, 4000);

    // --- Advertise Modal Toggle Logics ---
    const openBtn = document.getElementById('open-advertise-modal');
    const closeBtn = document.getElementById('close-advertise-modal');
    const modal = document.getElementById('advertise-modal');

    if (openBtn && closeBtn && modal) {
      openBtn.addEventListener('click', () => {
        modal.classList.remove('hidden');
        
        // Dynamic calculations inside modal metrics
        const modalCountEl = document.getElementById('modal-available-count');
        if (modalCountEl) {
          const available = Math.max(0, 20 - total);
          modalCountEl.textContent = String(available);
          
          const pricingNote = document.getElementById('modal-pricing-note');
          if (pricingNote) {
            if (available === 0) {
              pricingNote.innerHTML = '<span class="text-accent-orange font-bold">All spots are currently filled for this month.</span> Join our waiting list by emailing sponsors@illustratewords.com.';
            } else {
              pricingNote.textContent = 'Cancel anytime. Ad goes live within 24 hours of asset submission.';
            }
          }
        }
      });

      closeBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
      });

      // Close modal when clicking on the overlay background
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    }
  }

  // Initialize once DOM is ready (runs both on direct load or navigation checks)
  document.addEventListener('DOMContentLoaded', initSponsorBars);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initSponsorBars();
  }
</script>
