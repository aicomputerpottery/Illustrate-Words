---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Product',
    links: [
      { href: '/generate', label: 'Generate' },
      { href: '/gallery', label: 'Gallery' },
      { href: '/about', label: 'About' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Categories',
    links: [
      { href: '/generate?category=mindmap', label: 'Mindmaps' },
      { href: '/generate?category=data', label: 'Charts' },
      { href: '/generate?category=business', label: 'Frameworks' },
      { href: '/generate?category=process', label: 'Process' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
    ],
  },
  {
    title: 'Works with',
    links: [
      { href: 'https://gemini.google.com', label: 'Gemini', external: true },
      { href: 'https://chatgpt.com', label: 'ChatGPT', external: true },
      { href: 'https://claude.ai', label: 'Claude', external: true },
      { href: 'https://midjourney.com', label: 'Midjourney', external: true },
    ],
  },
  {
    title: 'Other Works',
    links: [
      { href: 'https://www.letstalkbuildinghouses.com/', label: "Let's Talk Building Houses", external: true },
      { href: 'https://www.letstalkislambooks.com/', label: "let's talk islam books.com", external: true },
    ],
  },
];
---

<footer class="bg-forest text-ink-on-dark mt-auto relative overflow-hidden">

  <div class="container-page py-20 md:py-24 relative">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      <div class="md:col-span-4">
        <a href="/" class="inline-block group">
          <Logo variant="dark" size={32} withWordmark />
        </a>
        <p class="mt-6 text-ink-on-dark-muted text-base max-w-sm leading-relaxed">
          One tool. One job. Free forever.<br />
          Build AI-ready visualization prompts in seconds.
        </p>
      </div>

      <div class="md:col-span-8 grid grid-cols-2 sm:grid-cols-5 gap-8">
        {footerSections.map((section) => (
          <div>
            <h3 class="text-xs font-semibold tracking-wider uppercase text-white mb-4">{section.title}</h3>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="text-ink-on-dark-muted hover:text-white transition-colors text-sm inline-flex items-center gap-1.5"
                  >
                    {link.label}
                    {link.external && (
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-cream-darkest/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-ink-on-dark-muted text-sm">
        © {currentYear} Illustrate Words. Free and open source.
      </p>
    </div>
  </div>
</footer>
