---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Product',
    links: [
      { href: '/generate', label: 'Generate' },
      { href: '/gallery', label: 'Gallery' },
      { href: '/about', label: 'About' },
    ],
  },
  {
    title: 'Categories',
    links: [
      { href: '/generate?category=mindmap', label: 'Mindmaps' },
      { href: '/generate?category=data', label: 'Charts' },
      { href: '/generate?category=business', label: 'Frameworks' },
      { href: '/generate?category=process', label: 'Process' },
    ],
  },
  {
    title: 'Works with',
    links: [
      { href: 'https://gemini.google.com', label: 'Gemini', external: true },
      { href: 'https://chatgpt.com', label: 'ChatGPT', external: true },
      { href: 'https://claude.ai', label: 'Claude', external: true },
      { href: 'https://midjourney.com', label: 'Midjourney', external: true },
    ],
  },
];
---

<footer class="bg-forest text-cream mt-auto relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none opacity-20">
    <div class="absolute top-12 left-12 w-3 h-3 rounded-full bg-accent-lavender"></div>
    <div class="absolute top-32 right-24 w-2 h-2 rounded-full bg-accent-lime"></div>
    <div class="absolute bottom-32 left-1/4 w-2.5 h-2.5 rounded-full bg-accent-pink"></div>
    <div class="absolute top-1/2 right-1/3 w-2 h-2 rounded-full bg-accent-orange"></div>
  </div>

  <div class="container-page py-20 md:py-24 relative">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-2.5 group">
          <div class="w-10 h-10 rounded-full bg-accent-lavender border-1.5 border-cream flex items-center justify-center transition-transform duration-200 group-hover:rotate-12">
            <svg viewBox="0 0 24 24" class="w-5 h-5 text-ink-primary" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="6" cy="6" r="2"></circle>
              <circle cx="18" cy="6" r="2"></circle>
              <circle cx="12" cy="18" r="2"></circle>
              <line x1="6" y1="8" x2="11" y2="15.5"></line>
              <line x1="18" y1="8" x2="13" y2="15.5"></line>
              <line x1="8" y1="6" x2="16" y2="6"></line>
            </svg>
          </div>
          <span class="font-serif text-2xl font-medium">VisualCraft</span>
        </a>
        <p class="mt-6 text-ink-on-dark-secondary text-base max-w-sm leading-relaxed">
          The free alternative to Napkin AI. Turn any idea into a stunning visualization with AI-ready prompts.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="pill bg-accent-lavender text-ink-primary border-cream/30 text-xs">
            ✨ Free forever
          </span>
          <span class="pill bg-accent-lime text-ink-primary border-cream/30 text-xs">
            🔓 No login
          </span>
        </div>
      </div>

      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
        {footerSections.map((section) => (
          <div>
            <h3 class="font-serif text-lg mb-4">{section.title}</h3>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="text-ink-on-dark-secondary hover:text-accent-lavender transition-colors text-sm inline-flex items-center gap-1.5"
                  >
                    {link.label}
                    {link.external && (
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-cream/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-ink-on-dark-secondary text-sm">
        © {currentYear} VisualCraft. Free and open source.
      </p>
      <p class="text-ink-on-dark-secondary text-sm flex items-center gap-2">
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-accent-lavender hover:text-cream transition-colors font-medium">
          Astro
        </a>
        and
        <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="text-accent-lime hover:text-cream transition-colors font-medium">
          Tailwind
        </a>
      </p>
    </div>
  </div>
</footer>
