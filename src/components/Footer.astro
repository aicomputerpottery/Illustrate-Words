---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
const repoUrl = 'https://github.com/aicomputerpottery/LTI';

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/generate', label: 'Generate' },
      { href: '/gallery', label: 'Gallery' },
      { href: '/about', label: 'About' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Categories',
    links: [
      { href: '/generate?category=mindmap', label: 'Mindmaps' },
      { href: '/generate?category=data', label: 'Charts' },
      { href: '/generate?category=business', label: 'Frameworks' },
      { href: '/generate?category=process', label: 'Process' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
      { href: repoUrl, label: 'Source code', external: true },
    ],
  },
  {
    title: 'More from us',
    links: [
      { href: 'https://www.letstalkbuildinghouses.com/', label: 'Building Houses', external: true },
      { href: 'https://www.letstalkislambooks.com/', label: 'Islam Books', external: true },
    ],
  },
];

// AI tools we plug into — brand-marked, clickable.
const aiTools = [
  {
    label: 'Gemini',
    href: 'https://gemini.google.com',
    color: '#7AA2FF',
    svg: '<path d="M12 2c.45 3.9 1.35 5.7 3 7.35S18.1 11.55 22 12c-3.9.45-5.7 1.35-7.35 3S12.45 18.1 12 22c-.45-3.9-1.35-5.7-3-7.35S5.9 12.45 2 12c3.9-.45 5.7-1.35 7.35-3S11.55 5.9 12 2z"/>',
  },
  {
    label: 'ChatGPT',
    href: 'https://chatgpt.com',
    color: '#5BD6AE',
    svg: '<path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997z"/>',
  },
  {
    label: 'Claude',
    href: 'https://claude.ai',
    color: '#E39069',
    svg: '<g stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M12 3v18"/><path d="M3 12h18"/><path d="M5.6 5.6l12.8 12.8"/><path d="M18.4 5.6L5.6 18.4"/></g>',
  },
  {
    label: 'Midjourney',
    href: 'https://midjourney.com',
    color: '#C9C4FF',
    svg: '<path d="M12 2.2 4.6 15.5h7.4V2.2zm1.7 3.1v10.2h5.7L13.7 5.3zM3 17.4c2.7 1.5 5.4 1.5 8.1 0l.9.5.9-.5c2.7 1.5 5.4 1.5 8.1 0l-1.7 4.4H4.7L3 17.4z"/>',
  },
];
---

<footer class="bg-forest text-ink-on-dark mt-auto relative overflow-hidden">

  <!-- Ambient glow accents -->
  <div class="absolute inset-0 pointer-events-none opacity-60" aria-hidden="true">
    <div class="absolute -top-24 left-1/4 w-96 h-96 rounded-full bg-accent-lavender/10 blur-[120px]"></div>
    <div class="absolute -bottom-24 right-1/4 w-96 h-96 rounded-full bg-accent-lime/10 blur-[120px]"></div>
  </div>

  <div class="container-page py-16 md:py-20 relative">

    <!-- Top: brand + link columns -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">

      <!-- Brand -->
      <div class="md:col-span-4">
        <a href="/" class="inline-block group transition-transform hover:-translate-y-0.5">
          <Logo variant="dark" size={32} withWordmark />
        </a>
        <p class="mt-5 text-ink-on-dark-muted text-base max-w-xs leading-relaxed">
          One tool. One job. Free forever. Build AI-ready visualization prompts in seconds.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="/generate"
            class="inline-flex items-center gap-1.5 rounded-full bg-accent-lime text-ink-primary text-sm font-bold px-4 py-2 border-2 border-transparent transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(200,220,46,0.35)]"
          >
            Start generating
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View source on GitHub"
            class="inline-flex items-center gap-2 rounded-full border border-white/15 text-ink-on-dark-muted text-sm font-semibold px-4 py-2 transition-all hover:text-white hover:border-white/40 hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
            Open source
          </a>
        </div>
      </div>

      <!-- Link columns -->
      <nav class="md:col-span-8 grid grid-cols-2 sm:grid-cols-4 gap-8" aria-label="Footer">
        {columns.map((section) => (
          <div>
            <h3 class="text-xs font-bold tracking-wider uppercase text-white mb-4">{section.title}</h3>
            <ul class="space-y-2.5">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="footer-link group inline-flex items-center gap-1.5 text-ink-on-dark-muted hover:text-white transition-colors text-sm"
                  >
                    <span class="footer-arrow inline-block w-0 opacity-0 -ml-1.5 overflow-hidden transition-all duration-200 text-accent-lime">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </span>
                    <span>{link.label}</span>
                    {link.external && (
                      <svg class="w-3 h-3 flex-shrink-0 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <!-- Works-with band -->
    <div class="mt-14 pt-10 border-t border-white/10">
      <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-8">
        <div class="lg:max-w-[200px]">
          <h3 class="font-serif text-lg font-medium text-white leading-tight">Plug into any AI</h3>
          <p class="text-ink-on-dark-muted text-sm mt-1">One prompt, your tool of choice.</p>
        </div>
        <div class="flex-1 grid grid-cols-2 sm:grid-cols-4 gap-3">
          {aiTools.map((tool) => (
            <a
              href={tool.href}
              target="_blank"
              rel="noopener noreferrer"
              class="ai-chip group flex items-center gap-2.5 rounded-xl border border-white/12 bg-white/[0.03] px-4 py-3 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white/[0.07] hover:border-white/30"
            >
              <span class="ai-chip-icon flex-shrink-0 w-6 h-6 transition-transform duration-200 group-hover:scale-110" style={`color:${tool.color}`}>
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" set:html={tool.svg}></svg>
              </span>
              <span class="text-sm font-semibold text-ink-on-dark-muted group-hover:text-white transition-colors">{tool.label}</span>
              <svg class="w-3.5 h-3.5 ml-auto text-white/25 group-hover:text-white/70 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8"/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-ink-on-dark-muted text-sm">
        © {currentYear} Illustrate Words. Free and open source.
      </p>
      <div class="flex items-center gap-2 text-ink-on-dark-muted text-sm">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-accent-lime animate-pulse"></span>
          No login. No tracking. No catch.
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link:hover .footer-arrow {
    width: 0.75rem;
    opacity: 1;
    margin-left: 0;
  }
</style>
