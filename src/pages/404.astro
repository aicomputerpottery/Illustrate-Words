---
import Layout from '../layouts/Layout.astro';
import Squiggle from '../components/Squiggle.astro';
---

<Layout 
  title="Page Not Found (404) — Illustrate Words"
  description="Sorry, the page you are looking for does not exist or has been moved. Return to Illustrate Words to build your diagram prompts."
  noindex={true}
>
  <section class="min-h-[80vh] flex items-center justify-center bg-cream relative overflow-hidden py-16 px-4">
    <!-- Floating background decorative elements -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute top-1/4 left-10 w-4 h-4 rounded-full bg-accent-lavender animate-float"></div>
      <div class="absolute bottom-1/4 right-10 w-3 h-3 rounded-full bg-accent-lime animate-float delay-200"></div>
      <div class="absolute top-1/3 right-1/4 w-3.5 h-3.5 rounded-full bg-accent-pink animate-float delay-500"></div>
      <div class="absolute bottom-1/3 left-1/4 w-2.5 h-2.5 rounded-full bg-accent-orange animate-float delay-100"></div>
    </div>

    <div class="max-w-2xl w-full text-center relative z-10">
      <!-- Animated Visual Illustration -->
      <div class="flex justify-center mb-8 relative">
        <div class="w-32 h-32 rounded-full bg-accent-lavender border-2 border-ink-primary flex items-center justify-center relative animate-pulse shadow-card">
          <!-- Inner disconnected nodes illustration -->
          <svg viewBox="0 0 24 24" class="w-16 h-16 text-ink-primary" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <!-- Central Node (Main) -->
            <circle cx="12" cy="7" r="2.5" fill="currentColor"></circle>
            <!-- Disconnected Bottom Left Node -->
            <circle cx="6" cy="18" r="2.5"></circle>
            <!-- Disconnected Bottom Right Node -->
            <circle cx="18" cy="18" r="2.5" fill="#EE7A53"></circle>
            <!-- Broken/dotted lines -->
            <path stroke-dasharray="3 3" d="M10 9L7.5 15.5"></path>
            <path stroke-dasharray="3 3" d="M14 9l2.5 6.5"></path>
            <!-- Cross mark in middle to denote broken state -->
            <path d="M11 13l2 2m0-2l-2 2" stroke="#EE7A53" stroke-width="2.5"></path>
          </svg>

          <!-- Floating badge: 404 -->
          <span class="absolute -top-3 -right-3 pill bg-accent-lime text-ink-primary font-bold text-xs uppercase border-ink-primary px-3 py-1 shadow-card rotate-12">
            Lost
          </span>
        </div>
      </div>

      <!-- Large Typography Header -->
      <h1 class="font-serif text-8xl md:text-9xl font-bold text-ink-primary tracking-tight leading-none">
        404
      </h1>
      
      <h2 class="mt-6 font-serif text-3xl md:text-4xl font-medium text-ink-primary">
        Node <em>disconnected</em>.
      </h2>

      <p class="mt-4 body-base text-ink-secondary max-w-md mx-auto">
        The page you are looking for has either been moved, deleted, or was mapped to a path that doesn't exist.
      </p>

      <div class="mt-8 flex justify-center">
        <Squiggle color="#EE7A53" width="120" />
      </div>

      <!-- Navigation Actions -->
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/generate" class="btn-primary text-base px-8 py-3.5 shadow-card hover:-translate-y-0.5 hover:shadow-card-hover active:translate-y-0 transition-all">
          Start Generating
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/" class="btn-secondary text-base px-8 py-3.5">
          Back to Homepage
        </a>
      </div>

      <!-- Quick category routes to help engagement -->
      <div class="mt-16 pt-8 border-t border-ink-primary/10">
        <p class="text-sm font-medium text-ink-tertiary uppercase tracking-wider mb-4">
          Jump to categories
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          <a href="/generate?category=mindmap" class="pill bg-cream-lighter text-ink-primary hover:bg-accent-lavender border-ink-primary text-sm shadow-card hover:shadow-card-hover transition-all">
            🧠 Mindmaps
          </a>
          <a href="/generate?category=process" class="pill bg-cream-lighter text-ink-primary hover:bg-accent-lime border-ink-primary text-sm shadow-card hover:shadow-card-hover transition-all">
            🔄 Process flows
          </a>
          <a href="/generate?category=data" class="pill bg-cream-lighter text-ink-primary hover:bg-accent-sky border-ink-primary text-sm shadow-card hover:shadow-card-hover transition-all">
            📊 Charts
          </a>
          <a href="/generate?category=business" class="pill bg-cream-lighter text-ink-primary hover:bg-accent-pink border-ink-primary text-sm shadow-card hover:shadow-card-hover transition-all">
            💼 Frameworks
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
