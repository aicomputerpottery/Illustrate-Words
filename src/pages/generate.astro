---
import Layout from '../layouts/Layout.astro';
import {
  CATEGORIES,
  PALETTES,
  CONNECTOR_STYLES,
  ICON_STYLES,
  LAYOUT_MOODS,
} from '../data/visualizations.js';

// Procedural vector illustration generator for the 76 visualization types
function getVisualizationSvg(typeId, categoryId) {
  if (categoryId === 'mindmap') {
    if (typeId === 'fishbone-mindmap') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="15" y1="50" x2="80" y2="50" /><polygon points="80,45 88,50 80,55" fill="currentColor" stroke="none"/><line x1="30" y1="50" x2="45" y2="25" /><line x1="50" y1="50" x2="65" y2="25" /><line x1="30" y1="50" x2="45" y2="75" /><line x1="50" y1="50" x2="65" y2="75" /><line x1="38" y1="38" x2="48" y2="38" /><line x1="38" y1="62" x2="48" y2="62" /></svg>`;
    }
    if (typeId === 'tree-mindmap') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="42" y="12" width="16" height="8" rx="1.5" fill="currentColor" fill-opacity="0.1"/><rect x="15" y="42" width="16" height="8" rx="1.5"/><rect x="42" y="42" width="16" height="8" rx="1.5"/><rect x="69" y="42" width="16" height="8" rx="1.5"/><path d="M50 20 v 12 M23 32 h 54 M23 32 v 10 M50 32 v 10 M77 32 v 10"/></svg>`;
    }
    if (typeId === 'concept-web') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="30" cy="30" r="6" fill="currentColor" fill-opacity="0.1"/><circle cx="70" cy="30" r="6"/><circle cx="50" cy="68" r="6" fill="currentColor" fill-opacity="0.05"/><circle cx="20" cy="70" r="6"/><circle cx="80" cy="70" r="6"/><line x1="35.5" y1="32.5" x2="44.5" y2="62.5"/><line x1="64.5" y1="32.5" x2="55.5" y2="62.5"/><line x1="36" y1="30" x2="64" y2="30"/><line x1="25.5" y1="35.5" x2="20.5" y2="64.5"/><line x1="74.5" y1="35.5" x2="79.5" y2="64.5"/></svg>`;
    }
    // Default mindmap (central-node-map)
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="50" cy="50" r="10" fill="currentColor" fill-opacity="0.15"/><path d="M50 40 C 50 25, 25 25, 25 25 M50 60 C 50 75, 25 75, 25 75 M60 50 C 75 50, 75 25, 75 25 M60 50 C 75 50, 75 75, 75 75"/><circle cx="25" cy="25" r="4.5" fill="currentColor"/><circle cx="25" cy="75" r="4.5" fill="currentColor"/><circle cx="75" cy="25" r="4.5" fill="currentColor"/><circle cx="75" cy="75" r="4.5" fill="currentColor"/></svg>`;
  }

  if (categoryId === 'process') {
    if (typeId === 'circular-process') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><path d="M 50 15 A 35 35 0 0 1 85 50" /><path d="M 85 50 A 35 35 0 0 1 50 85"/><path d="M 50 85 A 35 35 0 0 1 15 50"/><path d="M 15 50 A 35 35 0 0 1 50 15"/><circle cx="50" cy="15" r="3" fill="currentColor"/><circle cx="85" cy="50" r="3" fill="currentColor"/><circle cx="50" cy="85" r="3" fill="currentColor"/><circle cx="15" cy="50" r="3" fill="currentColor"/></svg>`;
    }
    if (typeId === 'funnel-chart' || typeId === 'funnel-diagram') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><polygon points="15,20 85,20 65,80 35,80" fill="currentColor" fill-opacity="0.05"/><line x1="20" y1="38" x2="80" y2="38"/><line x1="27" y1="59" x2="73" y2="59"/></svg>`;
    }
    if (typeId === 'swimlane-diagram') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="10" y1="20" x2="90" y2="20" /><line x1="10" y1="50" x2="90" y2="50" /><line x1="10" y1="80" x2="90" y2="80" /><line x1="10" y1="20" x2="10" y2="80" /><line x1="90" y1="20" x2="90" y2="80" /><rect x="20" y="30" width="15" height="10" rx="1.5" fill="currentColor" fill-opacity="0.05"/><rect x="45" y="60" width="15" height="10" rx="1.5"/><path d="M35 35 h 10 v 25"/></svg>`;
    }
    if (typeId === 'user-journey-map') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><path d="M 15 50 Q 30 20, 50 55 T 85 45" /><circle cx="15" cy="50" r="3" fill="currentColor"/><circle cx="50" cy="55" r="3" fill="currentColor"/><circle cx="85" cy="45" r="3" fill="currentColor"/><path d="M15 50 v 25 M50 55 v 20 M85 45 v 30" stroke-dasharray="2 2"/></svg>`;
    }
    // Default process
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="10" y="42" width="18" height="16" rx="2" fill="currentColor" fill-opacity="0.05"/><rect x="41" y="42" width="18" height="16" rx="2"/><rect x="72" y="42" width="18" height="16" rx="2"/><line x1="28" y1="50" x2="41" y2="50" /><polygon points="37,47 41,50 37,53" fill="currentColor" stroke="none"/><line x1="59" y1="50" x2="72" y2="50" /><polygon points="68,47 72,50 68,53" fill="currentColor" stroke="none"/></svg>`;
  }

  if (categoryId === 'data' || categoryId === 'comparison') {
    if (typeId === 'radar-chart') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><polygon points="50,15 80,35 80,65 50,85 20,65 20,35" fill="currentColor" fill-opacity="0.05"/><polygon points="50,30 70,42 70,58 50,70 30,58 30,42" stroke-dasharray="2 2"/><line x1="50" y1="50" x2="50" y2="15" /><line x1="50" y1="50" x2="80" y2="35" /><line x1="50" y1="50" x2="80" y2="65" /><line x1="50" y1="50" x2="50" y2="85" /><line x1="50" y1="50" x2="20" y2="65" /><line x1="50" y1="50" x2="20" y2="35" /><polygon points="50,22 72,40 68,62 50,75 28,60 38,40" stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.1"/></svg>`;
    }
    if (typeId === 'pie-chart' || typeId === 'donut-chart') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="50" cy="50" r="35" fill="currentColor" fill-opacity="0.05"/><line x1="50" y1="50" x2="50" y2="15" /><line x1="50" y1="50" x2="80" y2="65" /><line x1="50" y1="50" x2="19" y2="40" /></svg>`;
    }
    if (typeId === 'scatter-plot' || typeId === 'bubble-chart') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="15" y1="85" x2="85" y2="85" /><line x1="15" y1="15" x2="15" y2="85" /><circle cx="30" cy="70" r="3" fill="currentColor"/><circle cx="45" cy="55" r="4.5" fill="currentColor"/><circle cx="55" cy="40" r="3"/><circle cx="70" cy="25" r="6" fill="currentColor" fill-opacity="0.2"/><circle cx="35" cy="45" r="3.5"/><circle cx="60" cy="65" r="5" fill="currentColor" fill-opacity="0.1"/></svg>`;
    }
    if (typeId === 'line-chart' || typeId === 'area-chart') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="15" y1="85" x2="85" y2="85" /><line x1="15" y1="15" x2="15" y2="85" /><path d="M15 70 L 30 50 L 48 65 L 68 30 L 85 45" stroke-width="2"/><circle cx="30" cy="50" r="2.5" fill="currentColor"/><circle cx="48" cy="65" r="2.5" fill="currentColor"/><circle cx="68" cy="30" r="2.5" fill="currentColor"/></svg>`;
    }
    // Default bar chart
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="15" y1="85" x2="85" y2="85" /><line x1="15" y1="15" x2="15" y2="85" /><rect x="25" y="45" width="10" height="40" fill="currentColor" fill-opacity="0.1"/><rect x="45" y="25" width="10" height="60" fill="currentColor" fill-opacity="0.3"/><rect x="65" y="60" width="10" height="25" fill="currentColor" fill-opacity="0.05"/></svg>`;
  }

  if (categoryId === 'timeline') {
    if (typeId === 'gantt-chart') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="15" y1="20" x2="15" y2="80"/><line x1="15" y1="80" x2="85" y2="80"/><rect x="25" y="28" width="25" height="8" rx="1.5" fill="currentColor" fill-opacity="0.3"/><rect x="45" y="44" width="30" height="8" rx="1.5" fill="currentColor" fill-opacity="0.1"/><rect x="35" y="60" width="20" height="8" rx="1.5" fill="currentColor" fill-opacity="0.2"/></svg>`;
    }
    // Default timeline
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="10" y1="50" x2="90" y2="50" /><circle cx="25" cy="50" r="5" fill="currentColor"/><circle cx="50" cy="50" r="5" fill="currentColor"/><circle cx="75" cy="50" r="5" fill="currentColor"/><line x1="25" y1="50" x2="25" y2="35"/><line x1="50" y1="50" x2="50" y2="65"/><line x1="75" y1="50" x2="75" y2="35"/></svg>`;
  }

  if (categoryId === 'business') {
    if (typeId === 'swot-analysis') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="15" y="15" width="35" height="35" fill="currentColor" fill-opacity="0.05"/><rect x="50" y="15" width="35" height="35" /><rect x="15" y="50" width="35" height="35" /><rect x="50" y="50" width="35" height="35" fill="currentColor" fill-opacity="0.05"/><text x="32" y="38" font-size="18" font-family="serif" font-weight="bold" fill="currentColor" text-anchor="middle">S</text><text x="67" y="38" font-size="18" font-family="serif" font-weight="bold" fill="currentColor" text-anchor="middle">W</text><text x="32" y="73" font-size="18" font-family="serif" font-weight="bold" fill="currentColor" text-anchor="middle">O</text><text x="67" y="73" font-size="18" font-family="serif" font-weight="bold" fill="currentColor" text-anchor="middle">T</text></svg>`;
    }
    // Default business grid
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="10" y="15" width="80" height="70" rx="2" fill="currentColor" fill-opacity="0.02"/><line x1="26" y1="15" x2="26" y2="85"/><line x1="42" y1="15" x2="42" y2="85"/><line x1="58" y1="15" x2="58" y2="85"/><line x1="74" y1="15" x2="74" y2="85"/><line x1="26" y1="50" x2="74" y2="50"/></svg>`;
  }

  if (categoryId === 'structures') {
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="42" y="15" width="16" height="12" rx="1.5" fill="currentColor" fill-opacity="0.1"/><rect x="18" y="48" width="16" height="12" rx="1.5"/><rect x="42" y="48" width="16" height="12" rx="1.5"/><rect x="66" y="48" width="16" height="12" rx="1.5"/><path d="M50 27 v 10 M26 37 h 48 M26 37 v 11 M50 37 v 11 M74 37 v 11"/></svg>`;
  }

  if (categoryId === 'cycles') {
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="50" cy="50" r="32" stroke-dasharray="6 6"/><path d="M 50 18 A 32 32 0 0 1 82 50" stroke-width="2"/><path d="M 82 50 A 32 32 0 0 1 50 82" stroke-width="2"/><path d="M 50 82 A 32 32 0 0 1 18 50" stroke-width="2"/><path d="M 18 50 A 32 32 0 0 1 50 18" stroke-width="2"/><polygon points="50,14 56,18 50,22" fill="currentColor" stroke="none"/><polygon points="86,50 82,56 78,50" fill="currentColor" stroke="none"/></svg>`;
  }

  if (categoryId === 'parts') {
    if (typeId === 'venn-diagram') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="40" cy="50" r="22" fill="currentColor" fill-opacity="0.05"/><circle cx="60" cy="50" r="22" fill="currentColor" fill-opacity="0.05"/></svg>`;
    }
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="50" cy="50" r="30" fill="currentColor" fill-opacity="0.05"/><line x1="50" y1="50" x2="50" y2="20"/><line x1="50" y1="50" x2="76" y2="65"/><line x1="50" y1="50" x2="24" y2="65"/></svg>`;
  }

  if (categoryId === 'cause') {
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="30" cy="50" r="10" /><circle cx="70" cy="50" r="10" /><path d="M40 45 Q 50 35, 60 45" /><polygon points="58,40 60,45 55,46" fill="currentColor" stroke="none"/><path d="M60 55 Q 50 65, 40 55" /><polygon points="42,60 40,55 45,54" fill="currentColor" stroke="none"/><text x="50" y="32" font-size="8" text-anchor="middle" fill="currentColor">+</text><text x="50" y="74" font-size="8" text-anchor="middle" fill="currentColor">-</text></svg>`;
  }

  if (categoryId === 'metaphors') {
    if (typeId === 'bridge-diagram') {
      return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><path d="M 5 60 H 25 V 85 H 5 Z" fill="currentColor" fill-opacity="0.1"/><path d="M 75 60 H 95 V 85 H 75 Z" fill="currentColor" fill-opacity="0.1"/><path d="M 25 60 Q 50 52, 75 60 M 25 64 Q 50 56, 75 64" fill="currentColor" fill-opacity="0.05"/><line x1="38" y1="58" x2="38" y2="85" /><line x1="62" y1="58" x2="62" y2="85" /></svg>`;
    }
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><polygon points="50,15 85,80 15,80" fill="currentColor" fill-opacity="0.05"/><line x1="33" y1="50" x2="67" y2="50"/><line x1="42" y1="32" x2="58" y2="32"/><line x1="24" y1="65" x2="76" y2="65"/></svg>`;
  }

  if (categoryId === 'brainstorming') {
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="18" y="20" width="20" height="20" rx="1" fill="currentColor" fill-opacity="0.05" transform="rotate(-5 28 30)"/><rect x="52" y="25" width="22" height="18" rx="1" fill="currentColor" fill-opacity="0.1" transform="rotate(3 63 34)"/><rect x="30" y="55" width="20" height="22" rx="1" fill="currentColor" fill-opacity="0.02" transform="rotate(-2 40 66)"/></svg>`;
  }

  if (categoryId === 'narratives') {
    return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><path d="M15 75 L 30 75 Q 50 75, 55 50 T 70 25 L 85 75" stroke-width="2"/><line x1="10" y1="75" x2="90" y2="75"/><circle cx="55" cy="50" r="3.5" fill="currentColor"/><circle cx="70" cy="25" r="3.5" fill="currentColor"/></svg>`;
  }

  return `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><circle cx="50" cy="50" r="30" /><path d="M35 50 h 30 M50 35 v 30" /></svg>`;
}

// Flatten all types with their category metadata for easy rendering
const allTypes = CATEGORIES.flatMap((cat) =>
  cat.types.map((type) => ({
    ...type,
    categoryId: cat.id,
    categoryName: cat.name,
    categoryIcon: cat.icon,
    iconSvg: getVisualizationSvg(type.id, cat.id),
  }))
);

const steps = [
  { n: 1, title: 'Visualization', subtitle: 'Pick your type' },
  { n: 2, title: 'Palette', subtitle: 'Choose your colors' },
  { n: 3, title: 'Style', subtitle: 'Set the mood' },
  { n: 4, title: 'Prompt', subtitle: 'Copy and paste' },
];
---

<Layout title="Generate — Illustrate Words" hideFooter={true}>

  <div class="bg-cream min-h-screen pb-20">
    <div class="container-page py-6 md:py-10">

      <!-- ============================================== -->
      <!-- MOBILE PROGRESS BAR                            -->
      <!-- ============================================== -->
      <div class="md:hidden mb-6">
        <div class="flex gap-1.5">
          {steps.map((step) => (
            <div
              data-mobile-step={step.n}
              class="flex-1 h-2 rounded-full bg-ink-primary/10 transition-colors duration-300"
            ></div>
          ))}
        </div>
        <p class="mt-3 text-sm text-ink-secondary text-center font-medium">
          Step <span id="mobile-step-number">1</span> of 4 — <span id="mobile-step-title">Visualization</span>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

        <!-- ============================================== -->
        <!-- SIDEBAR (desktop only)                         -->
        <!-- ============================================== -->
        <aside class="hidden md:block md:col-span-3">
          <div class="sticky top-24 space-y-3">

            {steps.map((step) => (
              <button
                type="button"
                data-step-indicator={step.n}
                class="step-btn w-full flex items-center gap-3 p-4 rounded-card border-1.5 border-ink-primary bg-cream-lighter transition-all text-left hover:-translate-y-0.5"
              >
                <div class="step-circle w-10 h-10 rounded-full border-1.5 border-ink-primary flex items-center justify-center font-serif font-medium text-base flex-shrink-0">
                  <span class="step-number">{step.n}</span>
                </div>
                <div class="min-w-0">
                  <div class="font-serif font-medium text-base leading-tight">{step.title}</div>
                  <div class="text-xs text-ink-secondary mt-0.5">{step.subtitle}</div>
                </div>
              </button>
            ))}

            <!-- Selections summary -->
            <div class="mt-6 p-5 rounded-card border-1.5 border-ink-primary bg-cream-darker">
              <div class="label mb-3">Your selections</div>
              <div id="summary-content" class="space-y-2 text-sm">
                <div class="text-ink-secondary italic">Nothing selected yet</div>
              </div>
            </div>

          </div>
        </aside>

        <!-- ============================================== -->
        <!-- MAIN CONTENT                                   -->
        <!-- ============================================== -->
        <main class="md:col-span-9 wizard-main">

          <!-- ============================================== -->
          <!-- STEP 1: TYPE PICKER                           -->
          <!-- ============================================== -->
          <section data-step-content="1">

            <!-- Header -->
            <div class="mb-8">
              <span class="pill-lavender">Step 1 of 4</span>
              <h1 class="mt-4 headline-h1">
                What do you want to <em>visualize</em>?
              </h1>
              <p class="mt-3 body-base">
                Choose from 76 visualization types across 13 categories.
                Use the search or filter by category.
              </p>
            </div>

            <!-- Search bar -->
            <div class="relative mb-6">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                id="search-input"
                type="text"
                placeholder="Search visualization types..."
                class="w-full pl-12 pr-4 py-3.5 rounded-full bg-cream-lighter border-1.5 border-ink-primary text-ink-primary placeholder:text-ink-tertiary font-medium focus:outline-none focus:ring-2 focus:ring-accent-lavender"
              />
            </div>

            <!-- Category filter pills (horizontal scroll on mobile) -->
            <div class="flex gap-2 overflow-x-auto scrollbar-hide pb-2 mb-8">
              <button
                type="button"
                data-category-filter="all"
                class="cat-pill flex-shrink-0 px-4 py-2 rounded-full border-1.5 border-ink-primary font-medium text-sm transition-all flex items-center gap-1.5"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                All
              </button>
              {CATEGORIES.map((cat) => (
                <button
                  type="button"
                  data-category-filter={cat.id}
                  class="cat-pill flex-shrink-0 px-4 py-2 rounded-full border-1.5 border-ink-primary font-medium text-sm transition-all whitespace-nowrap flex items-center gap-1.5 animate-fade-in"
                >
                  <Fragment set:html={cat.iconSvg} />
                  <span>{cat.name}</span>
                </button>
              ))}
            </div>

            <!-- Type cards grid -->
            <div id="type-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
