---
import Layout from '../layouts/Layout.astro';
import StepFlow from '../components/StepFlow.astro';
import {
  CATEGORIES,
  PALETTES,
  CONNECTOR_STYLES,
  ICON_STYLES,
  LAYOUT_MOODS,
} from '../data/visualizations.js';


// Flatten all types with their category metadata for easy rendering
const allTypes = CATEGORIES.flatMap((cat) =>
  cat.types.map((type) => ({
    ...type,
    categoryId: cat.id,
    categoryName: cat.name,
    categoryIcon: cat.icon,
  }))
);

const steps = [
  { n: 1, title: 'Visualization', subtitle: 'Pick your type' },
  { n: 2, title: 'Palette', subtitle: 'Choose your colors' },
  { n: 3, title: 'Style', subtitle: 'Set the mood' },
  { n: 4, title: 'Prompt', subtitle: 'Copy and paste' },
];
---

<Layout
  title="Create a Visualization Prompt — VisualCraft"
  description="Build a tailored AI prompt in four steps: choose from 76 visualization types, 42 palettes, and style controls. Copy, paste into any AI, done."
  hideFooter={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "VisualCraft",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Free four-step builder that generates copy-paste AI prompts for charts, mindmaps, timelines, and more.",
      "url": new URL("/generate", Astro.site || 'https://illustratewords.com').href
    })} />
  </Fragment>

  <div class="bg-cream-lightest min-h-screen pb-20">
    <h1 class="sr-only">VisualCraft - AI Visualization Prompt Generator</h1>
    <!-- Breadcrumb -->
    <div id="gallery-breadcrumb" class="hidden bg-cream border-b border-border-light py-2.5">
      <div class="container-page">
        <a href="/gallery" class="text-xs font-semibold text-ink-secondary font-sans hover:text-ink-primary flex items-center gap-1">
          ← Back to Gallery
        </a>
      </div>
    </div>

    <div class="container-page py-6 md:py-10">

      <!-- Animated Step Flow -->
      <div class="mb-8 md:mb-12">
        <StepFlow />
      </div>

      <!-- ============================================== -->
      <!-- MOBILE PROGRESS BAR                            -->
      <!-- ============================================== -->
      <div class="md:hidden mb-6">
        <div class="flex gap-1.5">
          {steps.map((step) => (
            <div
              data-mobile-step={step.n}
              class="flex-1 h-2 rounded-full bg-ink-primary/10 transition-colors duration-300"
            ></div>
          ))}
        </div>
        <p class="mt-3 text-sm text-ink-secondary text-center font-medium">
          Step <span id="mobile-step-number">1</span> of 4 — <span id="mobile-step-title">Visualization</span>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

        <!-- ============================================== -->
        <!-- SIDEBAR (desktop only)                         -->
        <!-- ============================================== -->
        <aside class="hidden md:block md:col-span-3">
          <div class="sticky top-24 space-y-3">

            {steps.map((step) => (
              <button
                type="button"
                data-step-indicator={step.n}
                class="step-btn w-full flex items-center gap-3 p-4 rounded-card border-1.5 border-border-medium bg-cream-darker text-ink-tertiary transition-all text-left hover:-translate-y-0.5"
              >
                <div class="step-circle w-10 h-10 rounded-full border-1.5 border-border-medium bg-cream-lightest flex items-center justify-center font-serif font-medium text-base flex-shrink-0">
                  <span class="step-number">{step.n}</span>
                </div>
                <div class="min-w-0">
                  <div class="font-serif font-medium text-base leading-tight">{step.title}</div>
                  <div class="text-xs text-ink-tertiary mt-0.5">{step.subtitle}</div>
                </div>
              </button>
            ))}

            <!-- Selections summary -->
            <div class="mt-6 p-5 rounded-card border-1.5 border-border-medium bg-cream-darker">
              <div class="text-xs font-semibold tracking-wider uppercase text-ink-secondary mb-3">Your selections</div>
              <div id="summary-content" class="space-y-2 text-sm">
                <div class="text-ink-secondary italic">Nothing selected yet</div>
              </div>
            </div>

          </div>
        </aside>

        <!-- ============================================== -->
        <!-- MAIN CONTENT                                   -->
        <!-- ============================================== -->
        <main class="md:col-span-9 wizard-main">

          <!-- ============================================== -->
          <!-- STEP 1: TYPE PICKER                           -->
          <!-- ============================================== -->
          <section data-step-content="1">

            <!-- Header -->
            <div class="mb-8">
              <span class="pill-lavender">Step 1 of 4</span>
              <h2 class="mt-4 headline-h1 text-ink-primary">
                What do you want to <em>visualize</em>?
              </h2>
              <p class="mt-3 body-base">
                Choose from 76 visualization types across 13 categories.
                Use the search or filter by category.
              </p>
            </div>

            <!-- Search bar -->
            <div class="relative mb-6">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                id="search-input"
                type="text"
                placeholder="Search visualization types..."
                class="w-full pl-12 pr-4 py-3.5 rounded-full bg-cream border-1.5 border-border-medium text-ink-primary placeholder:text-ink-tertiary font-medium focus:outline-none focus:ring-2 focus:ring-accent-lavender"
              />
            </div>

            <!-- Category filter pills (horizontal scroll on mobile) -->
            <div class="flex gap-2 overflow-x-auto scrollbar-hide pb-2 mb-8">
              <button
                type="button"
                data-category-filter="all"
                class="cat-pill flex-shrink-0 px-4 py-2 rounded-full border border-border-medium text-ink-secondary hover:bg-cream-darker transition-all flex items-center gap-1.5"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                All
              </button>
              {CATEGORIES.map((cat) => (
                <button
                  type="button"
                  data-category-filter={cat.id}
                  class="cat-pill flex-shrink-0 px-4 py-2 rounded-full border border-border-medium text-ink-secondary hover:bg-cream-darker transition-all whitespace-nowrap flex items-center gap-1.5 animate-fade-in"
                >
                  <Fragment set:html={cat.iconSvg} />
                  <span>{cat.name}</span>
                </button>
              ))}
            </div>

            <!-- Type cards grid -->
            <div id="type-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
              {allTypes.map((type) => (
                <button
                  type="button"
                  data-type-card
                  data-type-id={type.id}
                  data-category-id={type.categoryId}
                  data-type-name={type.name.toLowerCase()}
                  class="type-card group text-left flex flex-col relative"
                >
                  <!-- Icon area -->
                  <div class="type-card-art">
                    <div class="w-[70%] h-[70%]" set:html={type.iconSvg}></div>
                  </div>

                  <!-- Text area -->
                  <div class="px-1 pt-3 pb-1 text-center w-full">
                    <div class="font-serif font-medium text-ink-primary text-[15px] leading-tight">{type.name}</div>
                    <div class="text-[11px] font-sans text-ink-tertiary mt-0.5">{type.categoryName}</div>
                  </div>

                  <!-- Selected state checkmark (hidden by default) -->
                  <div class="check-icon hidden absolute top-2 right-2 w-6 h-6 rounded-full bg-accent-lavender border border-cream flex items-center justify-center text-cream">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </button>
              ))}
            </div>

            <!-- Empty state -->
            <div id="type-empty-state" class="hidden text-center py-16">
              <div class="text-5xl mb-4">🔍</div>
              <p class="font-serif text-xl font-medium">No types match your search</p>
              <p class="text-ink-secondary mt-2">Try a different keyword or category</p>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-10 flex justify-end">
              <button
                type="button"
                data-go-next
                disabled
                class="btn-primary disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-y-0"
              >
                Next: Palette
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </button>
            </div>

          </section>

          <!-- ============================================== -->
          <!-- STEP 2: PALETTE PICKER                        -->
          <!-- ============================================== -->
          <section data-step-content="2" class="hidden">

            <div class="step-header mb-8">
              <div class="flex items-center gap-3 mb-2">
                <span class="pill-lime">Step 2 of 4</span>
              </div>
              <h2 id="step2-heading" class="headline-h1 text-ink-primary mb-2">
                Choose a color <em>palette</em>
              </h2>
              <p class="text-ink-secondary text-base max-w-xl">
                Your palette shapes the entire mood of the visualization. Pick something that fits the context — professional decks call for different energy than brainstorming sessions.
              </p>
            </div>

            <!-- ── FILTER BAR ── -->
            <div class="filter-section mb-6">

              <!-- Mood filter row -->
              <div class="filter-row-label mb-1.5">
                <span class="text-xs font-medium text-ink-tertiary uppercase tracking-wider">Mood</span>
              </div>
              <div class="filter-chips-row flex flex-wrap gap-2 mb-4" id="moodFilterChips" role="group" aria-label="Filter by mood">
                <!-- Generated by JS: renderMoodFilterChips() -->
              </div>

              <!-- Vibe filter row -->
              <div class="filter-row-label mb-1.5">
                <span class="text-xs font-medium text-ink-tertiary uppercase tracking-wider">Vibe</span>
              </div>
              <div class="filter-chips-row flex flex-wrap gap-2 mb-3" id="vibeFilterChips" role="group" aria-label="Filter by vibe">
                <!-- Generated by JS: renderVibeFilterChips() -->
              </div>

              <!-- Result count -->
              <p class="text-sm text-ink-tertiary" id="paletteCountLabel" aria-live="polite">
                Showing 42 palettes
              </p>
            </div>

            <!-- ── PALETTE GRID ── -->
            <div
              class="palette-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 mb-8"
              id="paletteGrid"
              role="radiogroup"
              aria-label="Color palettes"
            >
              <!-- Generated by JS: renderPaletteGrid() -->
            </div>

            <!-- ── SELECTED PALETTE SUMMARY (shown when a palette is chosen) ── -->
            <div id="selectedPaletteSummary" class="hidden mb-8 p-4 rounded-card border-1.5 border-ink-primary bg-cream-lighter">
              <div class="flex items-center gap-4">
                <div class="selected-palette-swatches flex rounded-btn overflow-hidden border-1.5 border-ink-primary" style="height:40px;width:160px;">
                  <!-- populated by JS -->
                </div>
                <div class="min-w-0 flex-1">
                  <p class="font-serif font-medium text-ink-primary" id="selectedPaletteName">Ocean Blue</p>
                  <p class="text-sm text-ink-secondary truncate" id="selectedPaletteDesc">Classic ocean depths that convey trust and data precision.</p>
                </div>
                <button
                  type="button"
                  id="clearPaletteBtn"
                  class="ml-auto btn-ghost text-sm text-ink-secondary"
                  aria-label="Clear palette selection"
                >
                  Change ✕
                </button>
              </div>
            </div>

            <!-- ── STEP NAV ── -->
            <div class="step-nav flex justify-between items-center mt-10">
              <button type="button" data-go-back class="btn-secondary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                Back
              </button>
              <button
                type="button"
                data-go-next
                id="step2NextBtn"
                disabled
                class="btn-primary disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-y-0"
              >
                Next: Style
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </button>
            </div>

          </section>

          <!-- ============================================== -->
          <!-- STEP 3: STYLE PICKER                          -->
          <!-- ============================================== -->
          <section data-step-content="3" class="hidden">

            <!-- Header -->
            <div class="mb-8">
              <span class="pill-pink">Step 3 of 4</span>
              <h2 class="mt-4 headline-h1 text-ink-primary">
                Set the <em>style</em>.
              </h2>
              <p class="mt-3 body-base">
                Three quick choices to fine-tune the look and feel.
              </p>
            </div>

            <!-- Connector style -->
            <div class="mb-10">
              <h2 class="font-serif text-xl font-medium mb-2">Connector style</h2>
              <p class="text-sm text-ink-secondary mb-4">How lines and arrows are drawn between elements.</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {CONNECTOR_STYLES.map((style) => (
                  <button
                    type="button"
                    data-style-card
                    data-style-type="connector"
                    data-style-id={style.id}
                    class="style-card group text-left rounded-card border-1.5 border-ink-primary bg-cream-lighter transition-all hover:-translate-y-0.5 hover:shadow-hard overflow-hidden flex flex-col relative"
                  >
                    <div class="aspect-[16/9] w-full bg-ink-primary/[0.02] flex items-center justify-center text-ink-primary p-4 border-b-1.5 border-ink-primary/10 group-hover:border-ink-primary/30 transition-colors">
                      <div class="w-16 h-8 text-ink-primary flex items-center justify-center" set:html={style.iconSvg}></div>
                    </div>
                    <div class="p-3.5 bg-transparent flex-1">
                      <h3 class="font-serif text-sm font-medium leading-tight">{style.name}</h3>
                      <p class="text-[11px] text-ink-secondary mt-1 leading-normal">{style.description}</p>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- Icon style -->
            <div class="mb-10">
              <h2 class="font-serif text-xl font-medium mb-2">Icon style</h2>
              <p class="text-sm text-ink-secondary mb-4">How icons are rendered if your visualization includes them.</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {ICON_STYLES.map((style) => (
                  <button
                    type="button"
                    data-style-card
                    data-style-type="icon"
                    data-style-id={style.id}
                    class="style-card group text-left rounded-card border-1.5 border-ink-primary bg-cream-lighter transition-all hover:-translate-y-0.5 hover:shadow-hard overflow-hidden flex flex-col relative"
                  >
                    <div class="aspect-[16/9] w-full bg-ink-primary/[0.02] flex items-center justify-center text-ink-primary p-4 border-b-1.5 border-ink-primary/10 group-hover:border-ink-primary/30 transition-colors">
                      <div class="w-16 h-8 text-ink-primary flex items-center justify-center" set:html={style.iconSvg}></div>
                    </div>
                    <div class="p-3.5 bg-transparent flex-1">
                      <h3 class="font-serif text-sm font-medium leading-tight">{style.name}</h3>
                      <p class="text-[11px] text-ink-secondary mt-1 leading-normal">{style.description}</p>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- Layout mood -->
            <div class="mb-10">
              <h2 class="font-serif text-xl font-medium mb-2">Layout mood</h2>
              <p class="text-sm text-ink-secondary mb-4">The overall aesthetic direction.</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {LAYOUT_MOODS.map((style) => (
                  <button
                    type="button"
                    data-style-card
                    data-style-type="mood"
                    data-style-id={style.id}
                    class="style-card group text-left rounded-card border-1.5 border-ink-primary bg-cream-lighter transition-all hover:-translate-y-0.5 hover:shadow-hard overflow-hidden flex flex-col relative"
                  >
                    <div class="aspect-[16/9] w-full bg-ink-primary/[0.02] flex items-center justify-center text-ink-primary p-4 border-b-1.5 border-ink-primary/10 group-hover:border-ink-primary/30 transition-colors">
                      <div class="w-16 h-8 text-ink-primary flex items-center justify-center" set:html={style.iconSvg}></div>
                    </div>
                    <div class="p-3.5 bg-transparent flex-1">
                      <h3 class="font-serif text-sm font-medium leading-tight">{style.name}</h3>
                      <p class="text-[11px] text-ink-secondary mt-1 leading-normal">{style.description}</p>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-10 flex justify-between items-center">
              <button type="button" data-go-back class="btn-secondary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                Back
              </button>
              <button
                type="button"
                data-go-next
                disabled
                class="btn-primary disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-y-0"
              >
                Generate Prompt
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </button>
            </div>

          </section>

          <!-- ============================================== -->
          <!-- STEP 4: PROMPT RESULT                         -->
          <!-- ============================================== -->
          <section data-step-content="4" class="hidden">

            <!-- Header -->
            <div class="mb-8">
              <span class="pill bg-accent-lime text-ink-primary">Step 4 of 4 — Your prompt is ready</span>
              <h2 class="mt-4 headline-h1 text-ink-primary">
                Copy and <em>paste</em>.
              </h2>
              <p class="mt-3 body-base">
                Your AI-ready visualization prompt. Paste it into any AI tool.
              </p>
            </div>

            <!-- Selection summary tags -->
            <div id="summary-tags" class="flex flex-wrap gap-2 mb-8"></div>

            <!-- User content input -->
            <div class="mb-6">
              <label for="user-content" class="block font-serif text-lg font-medium mb-2">
                Your content
              </label>
              <p class="text-sm text-ink-secondary mb-3">
                Paste the text, data, or topic you want visualized. Leave blank to keep the placeholder.
              </p>
              <textarea
                id="user-content"
                rows="4"
                placeholder="Example: SWOT analysis of opening a coffee shop in downtown Seattle. Strengths include high foot traffic and premium location. Weaknesses include high rent and saturated market..."
                class="w-full p-4 rounded-card-sm border-1.5 border-border-medium bg-cream-lightest text-ink-primary placeholder:text-ink-tertiary font-sans text-base leading-relaxed focus:outline-none focus:ring-2 focus:ring-accent-lavender resize-none"
              ></textarea>
            </div>

            <!-- Generated prompt display -->
            <div class="mb-6">
              <div class="flex items-center justify-between mb-2">
                <label for="generated-prompt" class="font-serif text-lg font-medium">
                  Your generated prompt
                </label>
                <span id="prompt-char-count" class="text-xs text-ink-secondary">0 characters</span>
              </div>
              <div class="relative">
                <textarea
                  id="generated-prompt"
                  rows="12"
                  readonly
                  class="w-full p-6 rounded-card border border-border-on-dark bg-forest text-ink-on-dark font-mono text-sm leading-relaxed resize-none"
                ></textarea>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="flex flex-wrap gap-3 mb-10">
              <button id="copy-btn" type="button" class="btn-accent flex-1 min-w-[200px]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                Copy Prompt
              </button>
              <button id="download-btn" type="button" class="btn-secondary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download .txt
              </button>
              <button id="reset-btn" type="button" class="btn-ghost">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Start Over
              </button>
            </div>

            <!-- AI tool launcher cards -->
            <div class="border-t border-ink-primary/10 pt-10">
              <h2 class="font-serif text-2xl font-medium mb-2">
                Now paste it into your favorite AI tool
              </h2>
              <p class="text-ink-secondary mb-6">
                Open one of these tools, paste your prompt, and get your visualization.
              </p>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <a href="https://gemini.google.com" target="_blank" rel="noopener noreferrer" class="ai-tool-card card p-4 text-center group block">
                  <div class="font-serif font-semibold text-lg text-ink-primary">Gemini</div>
                  <div class="text-xs text-ink-secondary mt-1 inline-flex items-center justify-center gap-1">
                    Open Tool
                    <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </div>
                </a>
                <a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" class="ai-tool-card card p-4 text-center group block">
                  <div class="font-serif font-semibold text-lg text-ink-primary">ChatGPT</div>
                  <div class="text-xs text-ink-secondary mt-1 inline-flex items-center justify-center gap-1">
                    Open Tool
                    <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </div>
                </a>
                <a href="https://claude.ai" target="_blank" rel="noopener noreferrer" class="ai-tool-card card p-4 text-center group block">
                  <div class="font-serif font-semibold text-lg text-ink-primary">Claude</div>
                  <div class="text-xs text-ink-secondary mt-1 inline-flex items-center justify-center gap-1">
                    Open Tool
                    <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </div>
                </a>
                <a href="https://midjourney.com" target="_blank" rel="noopener noreferrer" class="ai-tool-card card p-4 text-center group block">
                  <div class="font-serif font-semibold text-lg text-ink-primary">Midjourney</div>
                  <div class="text-xs text-ink-secondary mt-1 inline-flex items-center justify-center gap-1">
                    Open Tool
                    <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </div>
                </a>
              </div>
            </div>

          </section>

        </main>

      </div>
    </div>
  </div>

  <!-- Toast notification for copy feedback -->
  <div id="toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 px-6 py-3 bg-ink-primary text-cream rounded-full font-medium shadow-hard opacity-0 pointer-events-none transition-opacity duration-300 z-50">
    Copied to clipboard! ✓
  </div>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- PALETTE DETAIL POPOVER (shared, injected once)         -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <div
    id="palettePopover"
    class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="popoverPaletteName"
  >
    <!-- Backdrop -->
    <div
      id="palettePopoverBackdrop"
      class="absolute inset-0 bg-ink-primary/40 cursor-pointer"
    ></div>

    <!-- Panel -->
    <div
      class="relative z-10 w-full max-w-sm bg-cream rounded-card border-1.5 border-ink-primary shadow-hard"
      id="palettePopoverPanel"
    >

      <!-- Swatch strip (large) -->
      <div class="flex h-16 rounded-t-[18px] overflow-hidden border-b-1.5 border-ink-primary" id="popoverSwatchStrip">
        <!-- populated by JS -->
      </div>

      <!-- Body -->
      <div class="p-5">

        <!-- Name + badges -->
        <div class="flex items-start justify-between gap-2 mb-1">
          <h3 id="popoverPaletteName" class="font-serif text-xl font-medium text-ink-primary leading-tight"></h3>
          <div class="flex gap-1.5 flex-wrap justify-end" id="popoverBadges"></div>
        </div>

        <!-- Description -->
        <p class="text-sm text-ink-secondary mb-4 leading-relaxed" id="popoverDescription"></p>

        <!-- Color labels grid (2 columns, 5 items) -->
        <div class="grid grid-cols-2 gap-2 mb-5" id="popoverColorLabels">
          <!-- populated by JS -->
        </div>

        <!-- Action buttons -->
        <div class="flex gap-2">
          <button
            type="button"
            class="btn-secondary flex-1"
            id="popoverCancelBtn"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn-primary flex-1"
            id="popoverConfirmBtn"
          >
            Use this palette →
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- WIZARD STATE LOGIC                            -->
  <!-- ============================================== -->
  <script>
    import {
      CATEGORIES,
      PALETTES,
      CONNECTOR_STYLES,
      ICON_STYLES,
      LAYOUT_MOODS,
    } from '../data/visualizations.js';

    // ---- Data lookups ---------------------------------------------------
    const allTypes = CATEGORIES.flatMap((cat) =>
      cat.types.map((t) => ({ ...t, categoryId: cat.id, categoryName: cat.name }))
    );

    const getTypeById = (id) => allTypes.find((t) => t.id === id);
    const getPaletteById = (id) => PALETTES.find((p) => p.id === id);
    const getConnectorById = (id) => CONNECTOR_STYLES.find((s) => s.id === id);
    const getIconById = (id) => ICON_STYLES.find((s) => s.id === id);
    const getMoodById = (id) => LAYOUT_MOODS.find((s) => s.id === id);

    const stepTitles = ['', 'Visualization', 'Palette', 'Style', 'Prompt'];

    // ---- State ---------------------------------------------------------
    const state = {
      currentStep: 1,
      selectedTypeId: null,
      selectedCategoryFilter: 'all',
      selectedPaletteId: null,
      selectedMoodFilter: 'all',
      selectedVibeFilter: 'all',
      selectedConnectorId: null,
      selectedIconId: null,
      selectedMoodId: null,
      userContent: '',
      searchQuery: '',
    };

    function loadState() {
      try {
        const saved = localStorage.getItem('illustratewords-wizard-v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          Object.assign(state, parsed);
        }
      } catch (e) {
        console.warn('Failed to load saved state', e);
      }

      const params = new URLSearchParams(window.location.search);
      
      // Override category filter from URL ?category=xxx
      const urlCategory = params.get('category');
      if (urlCategory && (urlCategory === 'all' || CATEGORIES.some((c) => c.id === urlCategory))) {
        state.selectedCategoryFilter = urlCategory;
      }

      // Override type from URL ?type=xxx
      const urlType = params.get('type');
      if (urlType && allTypes.some((t) => t.id === urlType)) {
        state.selectedTypeId = urlType;
        const selectedType = allTypes.find((t) => t.id === urlType);
        if (selectedType) {
          state.selectedCategoryFilter = selectedType.categoryId;
        }
      }

      // Handle breadcrumb visibility
      const fromGallery = params.get('from') === 'gallery';
      const breadcrumbEl = document.getElementById('gallery-breadcrumb');
      if (breadcrumbEl) {
        if (fromGallery) {
          breadcrumbEl.classList.remove('hidden');
        } else {
          breadcrumbEl.classList.add('hidden');
        }
      }
    }

    function saveState() {
      try {
        localStorage.setItem('illustratewords-wizard-v1', JSON.stringify(state));
      } catch (e) {
        console.warn('Failed to save state', e);
      }
    }

    // ---- Validation -----------------------------------------------------
    function canGoToStep(n) {
      if (n <= 1) return true;
      if (n === 2) return !!state.selectedTypeId;
      if (n === 3) return !!state.selectedTypeId && !!state.selectedPaletteId;
      if (n === 4)
        return (
          !!state.selectedTypeId &&
          !!state.selectedPaletteId &&
          !!state.selectedConnectorId &&
          !!state.selectedIconId &&
          !!state.selectedMoodId
        );
      return false;
    }

    function canAdvance() {
      const n = state.currentStep;
      if (n === 1) return !!state.selectedTypeId;
      if (n === 2) return !!state.selectedPaletteId;
      if (n === 3)
        return !!state.selectedConnectorId && !!state.selectedIconId && !!state.selectedMoodId;
      return false;
    }

    // ---- Navigation -----------------------------------------------------
    function goToStep(n) {
      if (n < 1 || n > 4) return;
      if (!canGoToStep(n)) return;
      state.currentStep = n;
      saveState();
      render();
      document.querySelector('.wizard-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // ---- Selection handlers --------------------------------------------
    function selectType(id) {
      state.selectedTypeId = id;
      saveState();
      render();
      setTimeout(() => {
        if (state.currentStep === 1) {
          goToStep(2);
        }
      }, 300);
    }

    function selectPalette(id) {
      state.selectedPaletteId = id;
      saveState();
      render();
      setTimeout(() => {
        if (state.currentStep === 2) {
          goToStep(3);
        }
      }, 300);
    }

    function selectStyle(type, id) {
      if (type === 'connector') state.selectedConnectorId = id;
      else if (type === 'icon') state.selectedIconId = id;
      else if (type === 'mood') state.selectedMoodId = id;
      saveState();
      render();
    }

    function setCategoryFilter(catId) {
      state.selectedCategoryFilter = catId;
      saveState();
      renderTypeFilter();
    }

    function setSearchQuery(q) {
      state.searchQuery = q.toLowerCase();
      renderTypeFilter();
    }

    function setUserContent(text) {
      state.userContent = text;
      saveState();
      renderPrompt();
    }

    // ---- Prompt generation ---------------------------------------------
    function generatePrompt() {
      const type = getTypeById(state.selectedTypeId);
      const palette = getPaletteById(state.selectedPaletteId);
      const connector = getConnectorById(state.selectedConnectorId);
      const icon = getIconById(state.selectedIconId);
      const mood = getMoodById(state.selectedMoodId);

      if (!type) return '';

      const content = state.userContent.trim() || '[Paste your content here]';
      let prompt = type.promptTemplate.replace('[USER_CONTENT]', content);

      if (palette) {
        // Build named color pairs: "Mist: #E3F2FD, Sky: #90CAF9, ..."
        const namedColors = palette.colors
          .map((hex, i) => {
            const label = palette.labels && palette.labels[i] ? palette.labels[i] : `Stop ${i + 1}`;
            return `${label}: ${hex}`;
          })
          .join(', ');

        prompt += `\n\nCOLOR PALETTE — "${palette.name}"`;
        prompt += `\nMood: ${palette.mood} | Vibe: ${palette.vibe}`;
        prompt += `\n${palette.description}`;
        prompt += `\nApply these named colors throughout the visualization:`;
        prompt += `\n  ${namedColors}`;
        prompt += `\nDominant accent color: ${palette.preview}`;
        prompt += `\nUse the lightest stop (${palette.colors[0]}) for backgrounds and large fill areas.`;
        prompt += `\nUse the darkest stop (${palette.colors[4]}) for text, borders, and strong emphasis.`;
      }

      prompt += `\n\nVISUAL STYLE GUIDANCE (Napkin AI Aesthetic):`;
      prompt += `\n- Layout Format: Flat 2D vector schematic illustration, clean diagram line art.`;
      prompt += `\n- Spacing & Composition: Crisp, modern minimalist layout with generous whitespace. Clear alignment and visual breathing room.`;
      prompt += `\n- Background: Pure white background (#FFFFFF).`;
      if (connector) prompt += `\n- Connector Lines: ${connector.name} style connectors (${connector.description.toLowerCase()}).`;
      if (icon) prompt += `\n- Iconography: ${icon.name} icon style (${icon.description.toLowerCase()}).`;
      if (mood) prompt += `\n- Overall Aesthetic Direction: ${mood.name} style (${mood.description.toLowerCase()}).`;
      prompt += `\n- Outlines & Borders: Thin, clean, uniform dark borders (${palette ? palette.colors[4] : '#000000'}, 1.5px stroke width) on all nodes, blocks, and shapes.`;
      prompt += `\n- Fills & Color: Subtle, flat color fills using only the specified color palette stops. No gradients, no bevels, no 3D extrusion, and no drop shadows.`;
      prompt += `\n- Text & Alignment: Clean typography with text perfectly centered within shape nodes. High text contrast.`;
      prompt += `\n- Design Quality: Simple, clean vector graphic that looks hand-drawn or precisely created in Figma or Illustrator. Avoid complex illustrations, photo components, or artistic filters.`;

      return prompt;
    }

    // ---- Actions: copy, download, reset --------------------------------
    async function copyPrompt() {
      const text = generatePrompt();
      try {
        await navigator.clipboard.writeText(text);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
        } catch (err) {
          console.error('Copy failed', err);
        }
        document.body.removeChild(ta);
      }
      showToast('Copied to clipboard! ✓');
    }

    function downloadPrompt() {
      const text = generatePrompt();
      const type = getTypeById(state.selectedTypeId);
      const filename = `visualcraft-${type?.id || 'prompt'}.txt`;

      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function resetAll() {
      if (!confirm('Reset all selections and start over?')) return;
      state.currentStep = 1;
      state.selectedTypeId = null;
      state.selectedCategoryFilter = 'all';
      state.selectedPaletteId = null;
      state.selectedMoodFilter = 'all';
      state.selectedVibeFilter = 'all';
      state.selectedConnectorId = null;
      state.selectedIconId = null;
      state.selectedMoodId = null;
      state.userContent = '';
      state.searchQuery = '';
      saveState();

      const searchInput = document.getElementById('search-input');
      if (searchInput) searchInput.value = '';
      const userContent = document.getElementById('user-content');
      if (userContent) userContent.value = '';

      initStep2();
      render();
    }

    // ---- Toast ---------------------------------------------------------
    let toastTimeout;
    function showToast(message) {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message;
      toast.style.opacity = '1';
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.style.opacity = '0';
      }, 2200);
    }

    // ---- Rendering -----------------------------------------------------
    function render() {
      renderStepVisibility();
      renderSidebar();
      renderMobileProgress();
      renderSummary();
      renderTypeFilter();
      renderTypeSelections();
      renderPaletteSelections();
      renderStyleSelections();
      renderSummaryTags();
      renderPrompt();
      renderNavButtons();
    }

    function renderStepVisibility() {
      document.querySelectorAll('[data-step-content]').forEach((el) => {
        const step = parseInt(el.getAttribute('data-step-content'));
        if (step === state.currentStep) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    function renderSidebar() {
      document.querySelectorAll('[data-step-indicator]').forEach((el) => {
        const step = parseInt(el.getAttribute('data-step-indicator'));
        const circle = el.querySelector('.step-circle');
        const numberEl = el.querySelector('.step-number');

        el.className = 'step-btn w-full flex items-center gap-3 p-4 rounded-card border-1.5 transition-all text-left hover:-translate-y-0.5';
        if (circle) circle.className = 'step-circle w-10 h-10 rounded-full border-1.5 flex items-center justify-center font-serif font-medium text-base flex-shrink-0';

        if (step === state.currentStep) {
          el.classList.add('bg-accent-lavender', 'text-white', 'border-accent-lavender-dark');
          circle?.classList.add('bg-accent-lavender-deep', 'border-white');
          if (numberEl) numberEl.textContent = String(step);
        } else if (canGoToStep(step) && step < state.currentStep) {
          el.classList.add('bg-forest', 'text-ink-on-dark', 'border-forest-ink');
          circle?.classList.add('bg-forest-light', 'border-border-on-dark');
          if (numberEl) numberEl.innerHTML = '✓';
        } else {
          el.classList.add('bg-cream-darker', 'text-ink-tertiary', 'border-border-medium');
          circle?.classList.add('bg-cream-lightest', 'border-border-medium');
          if (numberEl) numberEl.textContent = String(step);
        }

        if (canGoToStep(step)) {
          el.removeAttribute('disabled');
          el.style.cursor = 'pointer';
          el.style.opacity = '1';
        } else {
          el.setAttribute('disabled', 'true');
          el.style.cursor = 'not-allowed';
          el.style.opacity = '0.5';
        }
      });
    }

    function renderMobileProgress() {
      document.querySelectorAll('[data-mobile-step]').forEach((el) => {
        const step = parseInt(el.getAttribute('data-mobile-step'));
        el.className = 'flex-1 h-2 rounded-full transition-all duration-300';
        if (step < state.currentStep) {
          el.classList.add('bg-forest');
        } else if (step === state.currentStep) {
          el.classList.add('bg-accent-lavender');
        } else {
          el.classList.add('bg-cream-darker');
        }
      });

      const num = document.getElementById('mobile-step-number');
      if (num) num.textContent = String(state.currentStep);
      const title = document.getElementById('mobile-step-title');
      if (title) title.textContent = stepTitles[state.currentStep];
    }

    function renderSummary() {
      const el = document.getElementById('summary-content');
      if (!el) return;

      const items = [];
      if (state.selectedTypeId) {
        const t = getTypeById(state.selectedTypeId);
        if (t) items.push({ label: 'Type', value: t.name });
      }
      if (state.selectedPaletteId) {
        const p = getPaletteById(state.selectedPaletteId);
        if (p) items.push({ label: 'Palette', value: p.name, swatch: p.preview });
      }
      if (state.selectedConnectorId) {
        const s = getConnectorById(state.selectedConnectorId);
        if (s) items.push({ label: 'Connector', value: s.name });
      }
      if (state.selectedIconId) {
        const s = getIconById(state.selectedIconId);
        if (s) items.push({ label: 'Icons', value: s.name });
      }
      if (state.selectedMoodId) {
        const s = getMoodById(state.selectedMoodId);
        if (s) items.push({ label: 'Mood', value: s.name });
      }

      if (items.length === 0) {
        el.innerHTML = '<div class="text-ink-secondary italic">Nothing selected yet</div>';
        return;
      }

      el.innerHTML = items
        .map(
          (item) => `
        <div class="flex items-start gap-2">
          ${item.swatch ? `<div class="w-3 h-3 rounded-full border border-ink-primary mt-1 flex-shrink-0" style="background-color: ${item.swatch}"></div>` : ''}
          <div class="flex-1 min-w-0">
            <div class="text-xs text-ink-secondary uppercase tracking-wide">${item.label}</div>
            <div class="font-medium truncate">${item.value}</div>
          </div>
        </div>
      `
        )
        .join('');
    }

    function renderTypeFilter() {
      document.querySelectorAll('[data-category-filter]').forEach((el) => {
        const cat = el.getAttribute('data-category-filter');
        el.classList.remove('bg-ink-primary', 'text-white', 'border-ink-primary', 'text-cream', 'bg-cream-lighter');
        el.classList.add('bg-transparent', 'text-ink-secondary', 'border-border-medium');
        if (cat === state.selectedCategoryFilter) {
          el.classList.remove('bg-transparent', 'text-ink-secondary', 'border-border-medium');
          el.classList.add('bg-ink-primary', 'text-white', 'border-ink-primary');
        }
      });

      let visibleCount = 0;
      document.querySelectorAll('[data-type-card]').forEach((el) => {
        const typeName = el.getAttribute('data-type-name') || '';
        const catId = el.getAttribute('data-category-id') || '';
        const matchesCategory =
          state.selectedCategoryFilter === 'all' || catId === state.selectedCategoryFilter;
        const matchesSearch = !state.searchQuery || typeName.includes(state.searchQuery);

        if (matchesCategory && matchesSearch) {
          el.classList.remove('hidden');
          visibleCount++;
        } else {
          el.classList.add('hidden');
        }
      });

      const emptyState = document.getElementById('type-empty-state');
      if (emptyState) {
        if (visibleCount === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }
    }

    function renderTypeSelections() {
      document.querySelectorAll('[data-type-card]').forEach((el) => {
        const id = el.getAttribute('data-type-id');
        const check = el.querySelector('.check-icon');

        if (id === state.selectedTypeId) {
          el.classList.add('selected');
          check?.classList.remove('hidden');
        } else {
          el.classList.remove('selected');
          check?.classList.add('hidden');
        }
      });
    }

    const MOODS_FILTER = [
      { value: 'all', label: 'All moods' },
      { value: 'professional', label: 'Professional' },
      { value: 'corporate', label: 'Corporate' },
      { value: 'creative', label: 'Creative' },
      { value: 'natural', label: 'Natural' },
      { value: 'energetic', label: 'Energetic' },
      { value: 'elegant', label: 'Elegant' },
      { value: 'playful', label: 'Playful' },
      { value: 'minimal', label: 'Minimal' },
    ];

    const VIBES_FILTER = [
      { value: 'all', label: 'All vibes' },
      { value: 'warm', label: '☀ Warm' },
      { value: 'cool', label: '❄ Cool' },
      { value: 'fresh', label: '🌿 Fresh' },
      { value: 'calm', label: '🌊 Calm' },
      { value: 'bold', label: '⚡ Bold' },
      { value: 'grounded', label: '🌱 Grounded' },
    ];

    function getFilteredPalettes() {
      return PALETTES.filter(p => {
        const moodMatch = state.selectedMoodFilter === 'all' || p.mood === state.selectedMoodFilter;
        const vibeMatch = state.selectedVibeFilter === 'all' || p.vibe === state.selectedVibeFilter;
        return moodMatch && vibeMatch;
      });
    }

    function renderMoodFilterChips() {
      const container = document.getElementById('moodFilterChips');
      if (!container) return;
      container.innerHTML = '';
      MOODS_FILTER.forEach(({ value, label }) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = [
          'filter-chip',
          'px-3 py-1.5 rounded-full border-1.5 text-sm font-medium transition-all duration-150',
          state.selectedMoodFilter === value
            ? 'bg-ink-primary text-cream border-ink-primary'
            : 'bg-cream-lighter text-ink-secondary border-ink-primary/30 hover:border-ink-primary',
        ].join(' ');
        btn.textContent = label;
        btn.setAttribute('aria-pressed', state.selectedMoodFilter === value ? 'true' : 'false');
        btn.addEventListener('click', () => {
          state.selectedMoodFilter = value;
          renderMoodFilterChips();
          renderVibeFilterChips(); // re-render vibes to keep counts accurate
          renderPaletteGrid();
          updatePaletteCountLabel();
        });
        container.appendChild(btn);
      });
    }

    function renderVibeFilterChips() {
      const container = document.getElementById('vibeFilterChips');
      if (!container) return;
      container.innerHTML = '';
      VIBES_FILTER.forEach(({ value, label }) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = [
          'filter-chip',
          'px-3 py-1.5 rounded-full border-1.5 text-sm font-medium transition-all duration-150',
          state.selectedVibeFilter === value
            ? 'bg-ink-primary text-cream border-ink-primary'
            : 'bg-cream-lighter text-ink-secondary border-ink-primary/30 hover:border-ink-primary',
        ].join(' ');
        btn.textContent = label;
        btn.setAttribute('aria-pressed', state.selectedVibeFilter === value ? 'true' : 'false');
        btn.addEventListener('click', () => {
          state.selectedVibeFilter = value;
          renderVibeFilterChips();
          renderPaletteGrid();
          updatePaletteCountLabel();
        });
        container.appendChild(btn);
      });
    }

    function updatePaletteCountLabel() {
      const label = document.getElementById('paletteCountLabel');
      if (!label) return;
      const count = getFilteredPalettes().length;
      const moodActive = state.selectedMoodFilter !== 'all';
      const vibeActive = state.selectedVibeFilter !== 'all';
      if (!moodActive && !vibeActive) {
        label.textContent = `Showing all ${PALETTES.length} palettes`;
      } else {
        label.textContent = `Showing ${count} palette${count !== 1 ? 's' : ''}`;
      }
    }

    function renderPaletteGrid() {
      const grid = document.getElementById('paletteGrid');
      if (!grid) return;

      const filtered = getFilteredPalettes();

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center">
            <p class="font-serif text-xl text-ink-secondary mb-2">No palettes match these filters</p>
            <p class="text-sm text-ink-tertiary mb-4">Try loosening the mood or vibe filter to see more options.</p>
            <button type="button" id="resetPaletteFiltersBtn" class="btn-secondary text-sm">Reset filters</button>
          </div>`;
        
        // Bind the reset filters button after injection
        const resetBtn = document.getElementById('resetPaletteFiltersBtn');
        resetBtn?.addEventListener('click', resetPaletteFilters);
        return;
      }

      grid.innerHTML = '';

      filtered.forEach(palette => {
        const isSelected = state.selectedPaletteId === palette.id;

        const card = document.createElement('button');
        card.type = 'button';
        card.role = 'radio';
        card.setAttribute('data-palette-card', '');
        card.setAttribute('data-palette-id', palette.id);
        card.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        card.setAttribute('aria-label', `${palette.name} — ${palette.mood}, ${palette.vibe}`);
        card.className = [
          'palette-card group relative overflow-hidden rounded-card text-left',
          'border-1.5 border-ink-primary bg-cream-lighter',
          'transition-all duration-200',
          'hover:-translate-y-0.5 hover:shadow-hard',
          'focus:outline-none focus-visible:ring-4 focus-visible:ring-accent-lavender focus-visible:ring-offset-2',
          isSelected ? 'shadow-hard ring-4 ring-accent-lavender ring-offset-2' : '',
        ].join(' ');

        // Swatch strip
        const swatchStrip = document.createElement('div');
        swatchStrip.className = 'flex h-12 w-full overflow-hidden rounded-t-[18px]';
        palette.colors.forEach(color => {
          const swatch = document.createElement('span');
          swatch.style.cssText = `background:${color};flex:1;display:block;`;
          swatchStrip.appendChild(swatch);
        });

        // Card body
        const body = document.createElement('div');
        body.className = 'p-3';

        // Name line with optional New badge
        const nameLine = document.createElement('p');
        nameLine.className = 'font-serif text-sm font-medium text-ink-primary leading-tight mb-1.5 flex items-center gap-1.5 flex-wrap';
        nameLine.textContent = palette.name;
        if (palette.isNew) {
          const badge = document.createElement('span');
          badge.className = 'text-[9px] font-sans font-semibold bg-accent-lime text-ink-primary px-1.5 py-0.5 rounded-full uppercase tracking-wide';
          badge.textContent = 'New';
          nameLine.appendChild(badge);
        }

        // Pill chips
        const chips = document.createElement('div');
        chips.className = 'flex gap-1.5 mb-2 flex-wrap';
        chips.innerHTML = `
          <span class="pill-lavender text-[10px] px-2 py-0.5">${palette.mood}</span>
          <span class="pill-cream text-[10px] px-2 py-0.5">${palette.vibe}</span>
        `;

        // Hex values
        const hexRow = document.createElement('div');
        hexRow.className = 'flex gap-1 flex-wrap';
        palette.colors.forEach(color => {
          const chip = document.createElement('span');
          chip.className = 'font-mono text-[9px] text-ink-tertiary bg-cream-darker px-1 py-0.5 rounded';
          chip.textContent = color;
          hexRow.appendChild(chip);
        });

        body.appendChild(nameLine);
        body.appendChild(chips);
        body.appendChild(hexRow);
        card.appendChild(swatchStrip);
        card.appendChild(body);

        // Checkmark badge (visible only when selected)
        const checkBadge = document.createElement('div');
        checkBadge.className = [
          'absolute top-2 right-2 w-6 h-6 rounded-full',
          'bg-accent-lavender border-1.5 border-ink-primary shadow-hard',
          'flex items-center justify-center',
          'transition-opacity duration-150',
          isSelected ? 'opacity-100' : 'opacity-0',
        ].join(' ');
        checkBadge.setAttribute('aria-hidden', 'true');
        checkBadge.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polyline points="2,6 5,9 10,3" stroke="#0A0A0A" stroke-width="1.75"
                      stroke-linecap="round" stroke-linejoin="round"/>
          </svg>`;
        card.appendChild(checkBadge);

        // Click handler — select palette and go to style
        card.addEventListener('click', () => selectPalette(palette.id));

        grid.appendChild(card);
      });
    }

    function resetPaletteFilters() {
      state.selectedMoodFilter = 'all';
      state.selectedVibeFilter = 'all';
      saveState();
      renderMoodFilterChips();
      renderVibeFilterChips();
      renderPaletteGrid();
      updatePaletteCountLabel();
    }

    function clearPaletteSelection() {
      state.selectedPaletteId = null;
      saveState();
      render();
    }

    function updateSelectedPaletteSummary() {
      const summary = document.getElementById('selectedPaletteSummary');
      const swatchContainer = summary?.querySelector('.selected-palette-swatches');
      const nameEl = document.getElementById('selectedPaletteName');
      const descEl = document.getElementById('selectedPaletteDesc');
      const nextBtn = document.getElementById('step2NextBtn');

      if (!state.selectedPaletteId) {
        summary?.classList.add('hidden');
        if (nextBtn) nextBtn.disabled = true;
        return;
      }

      const palette = getPaletteById(state.selectedPaletteId);
      if (!palette) return;

      // Populate swatches
      if (swatchContainer) {
        swatchContainer.innerHTML = palette.colors
          .map(c => `<span style="background:${c};flex:1;display:block;"></span>`)
          .join('');
      }

      if (nameEl) nameEl.textContent = palette.name;
      if (descEl) descEl.textContent = palette.description;

      summary?.classList.remove('hidden');
      if (nextBtn) nextBtn.disabled = false;
    }

    let popoverTargetPaletteId = null;
    let popoverTriggerCard = null;

    function openPalettePopover(palette, cardElement) {
      popoverTargetPaletteId = palette.id;
      popoverTriggerCard = cardElement;

      // Swatches
      const swatchStrip = document.getElementById('popoverSwatchStrip');
      if (swatchStrip) {
        swatchStrip.innerHTML = palette.colors
          .map(c => `<span style="background:${c};flex:1;display:block;"></span>`)
          .join('');
      }

      // Name
      const nameEl = document.getElementById('popoverPaletteName');
      if (nameEl) nameEl.textContent = palette.name;

      // Badges
      const badgesEl = document.getElementById('popoverBadges');
      if (badgesEl) {
        badgesEl.innerHTML = `
          <span class="pill-lavender text-[10px] px-2 py-0.5">${palette.mood}</span>
          <span class="pill-cream text-[10px] px-2 py-0.5">${palette.vibe}</span>
          ${palette.isNew ? '<span class="text-[9px] font-sans font-semibold bg-accent-lime text-ink-primary px-1.5 py-0.5 rounded-full uppercase tracking-wide">New</span>' : ''}
        `;
      }

      // Description
      const descEl = document.getElementById('popoverDescription');
      if (descEl) descEl.textContent = palette.description;

      // Color labels grid
      const labelsGrid = document.getElementById('popoverColorLabels');
      if (labelsGrid) {
        labelsGrid.innerHTML = palette.colors.map((color, i) => `
          <div class="flex items-center gap-2 p-2 rounded-card-sm bg-cream-lighter border-1.5 border-ink-primary/10">
            <span
              class="w-7 h-7 rounded-[6px] border-1.5 border-ink-primary/20 flex-shrink-0"
              style="background:${color}"
            ></span>
            <div class="min-w-0">
              <p class="text-[11px] font-medium text-ink-primary leading-none mb-0.5">
                ${palette.labels ? palette.labels[i] : `Stop ${i + 1}`}
              </p>
              <p class="font-mono text-[10px] text-ink-tertiary leading-none">${color}</p>
            </div>
          </div>
        `).join('');
      }

      // Show popover
      const popover = document.getElementById('palettePopover');
      if (popover) {
        popover.classList.remove('hidden');
        // Focus the confirm button for keyboard users
        setTimeout(() => {
          document.getElementById('popoverConfirmBtn')?.focus();
        }, 50);
      }

      // Trap Escape key
      document.addEventListener('keydown', handlePopoverKeydown);
    }

    function closePalettePopover() {
      const popover = document.getElementById('palettePopover');
      if (popover) popover.classList.add('hidden');
      popoverTargetPaletteId = null;
      document.removeEventListener('keydown', handlePopoverKeydown);

      // Restore focus
      if (popoverTriggerCard) {
        popoverTriggerCard.focus();
        popoverTriggerCard = null;
      }
    }

    function handlePopoverKeydown(e) {
      if (e.key === 'Escape') closePalettePopover();
    }

    function confirmPaletteSelection() {
      if (!popoverTargetPaletteId) return;
      selectPalette(popoverTargetPaletteId);
      closePalettePopover();
    }

    function renderPaletteSelections() {
      renderPaletteGrid();
      updateSelectedPaletteSummary();
    }

    function renderStyleSelections() {
      document.querySelectorAll('[data-style-card]').forEach((el) => {
        const type = el.getAttribute('data-style-type');
        const id = el.getAttribute('data-style-id');
        let selectedId = null;
        if (type === 'connector') selectedId = state.selectedConnectorId;
        else if (type === 'icon') selectedId = state.selectedIconId;
        else if (type === 'mood') selectedId = state.selectedMoodId;

        if (id === selectedId) {
          el.classList.add('bg-accent-lavender-light', 'shadow-hard');
        } else {
          el.classList.remove('bg-accent-lavender-light', 'shadow-hard');
        }
      });
    }

    function renderSummaryTags() {
      const el = document.getElementById('summary-tags');
      if (!el) return;

      const tags = [];
      const t = getTypeById(state.selectedTypeId);
      const p = getPaletteById(state.selectedPaletteId);
      const c = getConnectorById(state.selectedConnectorId);
      const i = getIconById(state.selectedIconId);
      const m = getMoodById(state.selectedMoodId);

      if (t) tags.push({ label: t.name, color: 'bg-accent-lavender' });
      if (p) tags.push({ label: p.name, color: 'bg-accent-pink' });
      if (c) tags.push({ label: `${c.name} lines`, color: 'bg-accent-lime' });
      if (i) tags.push({ label: `${i.name} icons`, color: 'bg-accent-sky' });
      if (m) tags.push({ label: `${m.name} mood`, color: 'bg-accent-orange' });

      el.innerHTML = tags
        .map(
          (tag) =>
            `<span class="pill ${tag.color} text-ink-primary text-xs">${tag.label}</span>`
        )
        .join('');
    }

    function renderPrompt() {
      const ta = document.getElementById('generated-prompt');
      const charCount = document.getElementById('prompt-char-count');
      if (!ta) return;

      const text = generatePrompt();
      ta.value = text;
      if (charCount) charCount.textContent = `${text.length} characters`;
    }

    function renderNavButtons() {
      document.querySelectorAll('[data-go-next]').forEach((btn) => {
        if (canAdvance()) {
          btn.removeAttribute('disabled');
        } else {
          btn.setAttribute('disabled', 'true');
        }
      });
    }

    // ---- Event listeners -----------------------------------------------
    function attachEventListeners() {
      document.querySelectorAll('[data-step-indicator]').forEach((el) => {
        el.addEventListener('click', () => {
          const step = parseInt(el.getAttribute('data-step-indicator'));
          goToStep(step);
        });
      });

      document.querySelectorAll('[data-type-card]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-type-id');
          if (id) selectType(id);
        });
      });

      // Palette Popover listeners
      document.getElementById('palettePopoverBackdrop')?.addEventListener('click', closePalettePopover);
      document.getElementById('popoverCancelBtn')?.addEventListener('click', closePalettePopover);
      document.getElementById('popoverConfirmBtn')?.addEventListener('click', confirmPaletteSelection);
      document.getElementById('clearPaletteBtn')?.addEventListener('click', clearPaletteSelection);

      document.querySelectorAll('[data-style-card]').forEach((el) => {
        el.addEventListener('click', () => {
          const type = el.getAttribute('data-style-type');
          const id = el.getAttribute('data-style-id');
          if (type && id) selectStyle(type, id);
        });
      });

      document.querySelectorAll('[data-category-filter]').forEach((el) => {
        el.addEventListener('click', () => {
          const cat = el.getAttribute('data-category-filter');
          if (cat) setCategoryFilter(cat);
        });
      });

      const searchInput = document.getElementById('search-input');
      searchInput?.addEventListener('input', (e) => {
        setSearchQuery(e.target.value);
      });

      const userContent = document.getElementById('user-content');
      userContent?.addEventListener('input', (e) => {
        setUserContent(e.target.value);
      });

      document.querySelectorAll('[data-go-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
          goToStep(state.currentStep + 1);
        });
      });

      document.querySelectorAll('[data-go-back]').forEach((btn) => {
        btn.addEventListener('click', () => {
          goToStep(state.currentStep - 1);
        });
      });

      document.getElementById('copy-btn')?.addEventListener('click', copyPrompt);
      document.getElementById('download-btn')?.addEventListener('click', downloadPrompt);
      document.getElementById('reset-btn')?.addEventListener('click', resetAll);
    }

    function initStep2() {
      renderMoodFilterChips();
      renderVibeFilterChips();
      renderPaletteGrid();
      updatePaletteCountLabel();
      updateSelectedPaletteSummary();
    }

    function init() {
      loadState();
      attachEventListeners();

      const searchInput = document.getElementById('search-input');
      if (searchInput && state.searchQuery) searchInput.value = state.searchQuery;

      const userContent = document.getElementById('user-content');
      if (userContent) userContent.value = state.userContent;

      initStep2();
      render();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>

</Layout>

