    role="dialog"
    aria-modal="true"
    aria-labelledby="popoverPaletteName"
  >
    <!-- Backdrop -->
    <div
      id="palettePopoverBackdrop"
      class="absolute inset-0 bg-ink-primary/40 cursor-pointer"
    ></div>

    <!-- Panel -->
    <div
      class="relative z-10 w-full max-w-sm bg-cream rounded-card border-1.5 border-ink-primary shadow-hard"
      id="palettePopoverPanel"
    >

      <!-- Swatch strip (large) -->
      <div class="flex h-16 rounded-t-[18px] overflow-hidden border-b-1.5 border-ink-primary" id="popoverSwatchStrip">
        <!-- populated by JS -->
      </div>

      <!-- Body -->
      <div class="p-5">

        <!-- Name + badges -->
        <div class="flex items-start justify-between gap-2 mb-1">
          <h3 id="popoverPaletteName" class="font-serif text-xl font-medium text-ink-primary leading-tight"></h3>
          <div class="flex gap-1.5 flex-wrap justify-end" id="popoverBadges"></div>
        </div>

        <!-- Description -->
        <p class="text-sm text-ink-secondary mb-4 leading-relaxed" id="popoverDescription"></p>

        <!-- Color labels grid (2 columns, 5 items) -->
        <div class="grid grid-cols-2 gap-2 mb-5" id="popoverColorLabels">
          <!-- populated by JS -->
        </div>

        <!-- Action buttons -->
        <div class="flex gap-2">
          <button
            type="button"
            class="btn-secondary flex-1"
            id="popoverCancelBtn"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn-primary flex-1"
            id="popoverConfirmBtn"
          >
            Use this palette →
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- WIZARD STATE LOGIC                            -->
  <!-- ============================================== -->
  <script>
    import {
      CATEGORIES,
      PALETTES,
      CONNECTOR_STYLES,
      ICON_STYLES,
      LAYOUT_MOODS,
    } from '../data/visualizations.js';

    // ---- Data lookups ---------------------------------------------------
    const allTypes = CATEGORIES.flatMap((cat) =>
      cat.types.map((t) => ({ ...t, categoryId: cat.id, categoryName: cat.name }))
    );

    const getTypeById = (id) => allTypes.find((t) => t.id === id);
    const getPaletteById = (id) => PALETTES.find((p) => p.id === id);
    const getConnectorById = (id) => CONNECTOR_STYLES.find((s) => s.id === id);
    const getIconById = (id) => ICON_STYLES.find((s) => s.id === id);
    const getMoodById = (id) => LAYOUT_MOODS.find((s) => s.id === id);

    const stepTitles = ['', 'Visualization', 'Palette', 'Style', 'Prompt'];

    // ---- State ---------------------------------------------------------
    const state = {
      currentStep: 1,
      selectedTypeId: null,
      selectedCategoryFilter: 'all',
      selectedPaletteId: null,
      selectedMoodFilter: 'all',
      selectedVibeFilter: 'all',
      selectedConnectorId: null,
      selectedIconId: null,
      selectedMoodId: null,
      userContent: '',
      searchQuery: '',
    };

    function loadState() {
      try {
        const saved = localStorage.getItem('illustratewords-wizard-v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          Object.assign(state, parsed);
        }
      } catch (e) {
        console.warn('Failed to load saved state', e);
      }

      // Override category filter from URL ?category=xxx
      const params = new URLSearchParams(window.location.search);
      const urlCategory = params.get('category');
      if (urlCategory && (urlCategory === 'all' || CATEGORIES.some((c) => c.id === urlCategory))) {
        state.selectedCategoryFilter = urlCategory;
      }
    }

    function saveState() {
      try {
        localStorage.setItem('illustratewords-wizard-v1', JSON.stringify(state));
      } catch (e) {
        console.warn('Failed to save state', e);
      }
    }

    // ---- Validation -----------------------------------------------------
    function canGoToStep(n) {
      if (n <= 1) return true;
      if (n === 2) return !!state.selectedTypeId;
      if (n === 3) return !!state.selectedTypeId && !!state.selectedPaletteId;
      if (n === 4)
        return (
          !!state.selectedTypeId &&
          !!state.selectedPaletteId &&
          !!state.selectedConnectorId &&
          !!state.selectedIconId &&
          !!state.selectedMoodId
        );
      return false;
    }

    function canAdvance() {
      const n = state.currentStep;
      if (n === 1) return !!state.selectedTypeId;
      if (n === 2) return !!state.selectedPaletteId;
      if (n === 3)
        return !!state.selectedConnectorId && !!state.selectedIconId && !!state.selectedMoodId;
      return false;
    }

    // ---- Navigation -----------------------------------------------------
    function goToStep(n) {
      if (n < 1 || n > 4) return;
      if (!canGoToStep(n)) return;
      state.currentStep = n;
      saveState();
      render();
      document.querySelector('.wizard-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // ---- Selection handlers --------------------------------------------
    function selectType(id) {
      state.selectedTypeId = id;
      saveState();
      render();
      setTimeout(() => {
        if (state.currentStep === 1) {
          goToStep(2);
        }
      }, 300);
    }

    function selectPalette(id) {
      state.selectedPaletteId = id;
      saveState();
      render();
      setTimeout(() => {
        if (state.currentStep === 2) {
          goToStep(3);
        }
      }, 300);
    }

    function selectStyle(type, id) {
      if (type === 'connector') state.selectedConnectorId = id;
      else if (type === 'icon') state.selectedIconId = id;
      else if (type === 'mood') state.selectedMoodId = id;
      saveState();
      render();
    }

    function setCategoryFilter(catId) {
      state.selectedCategoryFilter = catId;
      saveState();
      renderTypeFilter();
    }

    function setSearchQuery(q) {
      state.searchQuery = q.toLowerCase();
      renderTypeFilter();
    }

    function setUserContent(text) {
      state.userContent = text;
      saveState();
      renderPrompt();
    }

    // ---- Prompt generation ---------------------------------------------
    function generatePrompt() {
      const type = getTypeById(state.selectedTypeId);
      const palette = getPaletteById(state.selectedPaletteId);
      const connector = getConnectorById(state.selectedConnectorId);
      const icon = getIconById(state.selectedIconId);
      const mood = getMoodById(state.selectedMoodId);

      if (!type) return '';

      const content = state.userContent.trim() || '[Paste your content here]';
      let prompt = type.promptTemplate.replace('[USER_CONTENT]', content);

      if (palette) {
        // Build named color pairs: "Mist: #E3F2FD, Sky: #90CAF9, ..."
        const namedColors = palette.colors
          .map((hex, i) => {
            const label = palette.labels && palette.labels[i] ? palette.labels[i] : `Stop ${i + 1}`;
            return `${label}: ${hex}`;
          })
          .join(', ');

        prompt += `\n\nCOLOR PALETTE — "${palette.name}"`;
        prompt += `\nMood: ${palette.mood} | Vibe: ${palette.vibe}`;
        prompt += `\n${palette.description}`;
        prompt += `\nApply these named colors throughout the visualization:`;
        prompt += `\n  ${namedColors}`;
        prompt += `\nDominant accent color: ${palette.preview}`;
        prompt += `\nUse the lightest stop (${palette.colors[0]}) for backgrounds and large fill areas.`;
        prompt += `\nUse the darkest stop (${palette.colors[4]}) for text, borders, and strong emphasis.`;
      }

      prompt += `\n\nVISUAL STYLE GUIDANCE (Napkin AI Aesthetic):`;
      prompt += `\n- Layout Format: Flat 2D vector schematic illustration, clean diagram line art.`;
      prompt += `\n- Spacing & Composition: Crisp, modern minimalist layout with generous whitespace. Clear alignment and visual breathing room.`;
      prompt += `\n- Background: Pure white background (#FFFFFF).`;
      if (connector) prompt += `\n- Connector Lines: ${connector.name} style connectors (${connector.description.toLowerCase()}).`;
      if (icon) prompt += `\n- Iconography: ${icon.name} icon style (${icon.description.toLowerCase()}).`;
      if (mood) prompt += `\n- Overall Aesthetic Direction: ${mood.name} style (${mood.description.toLowerCase()}).`;
      prompt += `\n- Outlines & Borders: Thin, clean, uniform dark borders (${palette ? palette.colors[4] : '#000000'}, 1.5px stroke width) on all nodes, blocks, and shapes.`;
      prompt += `\n- Fills & Color: Subtle, flat color fills using only the specified color palette stops. No gradients, no bevels, no 3D extrusion, and no drop shadows.`;
      prompt += `\n- Text & Alignment: Clean typography with text perfectly centered within shape nodes. High text contrast.`;
      prompt += `\n- Design Quality: Simple, clean vector graphic that looks hand-drawn or precisely created in Figma or Illustrator. Avoid complex illustrations, photo components, or artistic filters.`;

      return prompt;
    }

    // ---- Actions: copy, download, reset --------------------------------
    async function copyPrompt() {
      const text = generatePrompt();
      try {
        await navigator.clipboard.writeText(text);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
        } catch (err) {
          console.error('Copy failed', err);
        }
        document.body.removeChild(ta);
      }
      showToast('Copied to clipboard! ✓');
    }

    function downloadPrompt() {
      const text = generatePrompt();
      const type = getTypeById(state.selectedTypeId);
      const filename = `visualcraft-${type?.id || 'prompt'}.txt`;

      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function resetAll() {
      if (!confirm('Reset all selections and start over?')) return;
      state.currentStep = 1;
      state.selectedTypeId = null;
      state.selectedCategoryFilter = 'all';
      state.selectedPaletteId = null;
      state.selectedMoodFilter = 'all';
      state.selectedVibeFilter = 'all';
      state.selectedConnectorId = null;
      state.selectedIconId = null;
      state.selectedMoodId = null;
      state.userContent = '';
      state.searchQuery = '';
      saveState();

      const searchInput = document.getElementById('search-input');
      if (searchInput) searchInput.value = '';
      const userContent = document.getElementById('user-content');
      if (userContent) userContent.value = '';

      initStep2();
      render();
    }

    // ---- Toast ---------------------------------------------------------
    let toastTimeout;
    function showToast(message) {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message;
      toast.style.opacity = '1';
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.style.opacity = '0';
      }, 2200);
    }

    // ---- Rendering -----------------------------------------------------
    function render() {
      renderStepVisibility();
      renderSidebar();
      renderMobileProgress();
      renderSummary();
      renderTypeFilter();
      renderTypeSelections();
      renderPaletteSelections();
      renderStyleSelections();
      renderSummaryTags();
      renderPrompt();
      renderNavButtons();
    }

    function renderStepVisibility() {
      document.querySelectorAll('[data-step-content]').forEach((el) => {
        const step = parseInt(el.getAttribute('data-step-content'));
        if (step === state.currentStep) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    function renderSidebar() {
      document.querySelectorAll('[data-step-indicator]').forEach((el) => {
        const step = parseInt(el.getAttribute('data-step-indicator'));
        const circle = el.querySelector('.step-circle');
        const numberEl = el.querySelector('.step-number');

        el.classList.remove('bg-ink-primary', 'text-cream', 'bg-cream-lighter', 'bg-accent-lime');
        circle?.classList.remove('bg-accent-lavender', 'bg-accent-lime');

        if (step === state.currentStep) {
          el.classList.add('bg-ink-primary', 'text-cream');
          circle?.classList.add('bg-accent-lavender');
        } else if (canGoToStep(step) && step < state.currentStep) {
          el.classList.add('bg-cream-lighter');
          circle?.classList.add('bg-accent-lime');
          if (numberEl) numberEl.innerHTML = '✓';
        } else {
          el.classList.add('bg-cream-lighter');
          if (numberEl) numberEl.textContent = String(step);
        }

        if (canGoToStep(step)) {
          el.removeAttribute('disabled');
          el.style.cursor = 'pointer';
          el.style.opacity = '1';
        } else {
          el.setAttribute('disabled', 'true');
          el.style.cursor = 'not-allowed';
          el.style.opacity = '0.5';
        }
      });
    }

    function renderMobileProgress() {
      document.querySelectorAll('[data-mobile-step]').forEach((el) => {
        const step = parseInt(el.getAttribute('data-mobile-step'));
        el.classList.remove('bg-ink-primary', 'bg-accent-lavender', 'bg-accent-lime');
        if (step < state.currentStep) {
          el.classList.add('bg-accent-lime');
        } else if (step === state.currentStep) {
          el.classList.add('bg-accent-lavender');
        } else {
          el.classList.add('bg-ink-primary');
          el.style.opacity = '0.1';
        }
      });

      const num = document.getElementById('mobile-step-number');
      if (num) num.textContent = String(state.currentStep);
      const title = document.getElementById('mobile-step-title');
      if (title) title.textContent = stepTitles[state.currentStep];
    }

    function renderSummary() {
      const el = document.getElementById('summary-content');
      if (!el) return;

      const items = [];
      if (state.selectedTypeId) {
        const t = getTypeById(state.selectedTypeId);
        if (t) items.push({ label: 'Type', value: t.name });
      }
      if (state.selectedPaletteId) {
        const p = getPaletteById(state.selectedPaletteId);
        if (p) items.push({ label: 'Palette', value: p.name, swatch: p.preview });
      }
      if (state.selectedConnectorId) {
        const s = getConnectorById(state.selectedConnectorId);
        if (s) items.push({ label: 'Connector', value: s.name });
      }
      if (state.selectedIconId) {
        const s = getIconById(state.selectedIconId);
        if (s) items.push({ label: 'Icons', value: s.name });
      }
      if (state.selectedMoodId) {
        const s = getMoodById(state.selectedMoodId);
        if (s) items.push({ label: 'Mood', value: s.name });
      }

      if (items.length === 0) {
        el.innerHTML = '<div class="text-ink-secondary italic">Nothing selected yet</div>';
        return;
      }

      el.innerHTML = items
        .map(
          (item) => `
        <div class="flex items-start gap-2">
          ${item.swatch ? `<div class="w-3 h-3 rounded-full border border-ink-primary mt-1 flex-shrink-0" style="background-color: ${item.swatch}"></div>` : ''}
          <div class="flex-1 min-w-0">
            <div class="text-xs text-ink-secondary uppercase tracking-wide">${item.label}</div>
            <div class="font-medium truncate">${item.value}</div>
          </div>
        </div>
      `
        )
        .join('');
    }

    function renderTypeFilter() {
      document.querySelectorAll('[data-category-filter]').forEach((el) => {
        const cat = el.getAttribute('data-category-filter');
        el.classList.remove('bg-ink-primary', 'text-cream', 'bg-cream-lighter');
        if (cat === state.selectedCategoryFilter) {
          el.classList.add('bg-ink-primary', 'text-cream');
        } else {
          el.classList.add('bg-cream-lighter');
        }
      });

      let visibleCount = 0;
      document.querySelectorAll('[data-type-card]').forEach((el) => {
        const typeName = el.getAttribute('data-type-name') || '';
        const catId = el.getAttribute('data-category-id') || '';
        const matchesCategory =
          state.selectedCategoryFilter === 'all' || catId === state.selectedCategoryFilter;
        const matchesSearch = !state.searchQuery || typeName.includes(state.searchQuery);

        if (matchesCategory && matchesSearch) {
          el.classList.remove('hidden');
          visibleCount++;
        } else {
          el.classList.add('hidden');
        }
      });

      const emptyState = document.getElementById('type-empty-state');
      if (emptyState) {
        if (visibleCount === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }
    }

    function renderTypeSelections() {
      document.querySelectorAll('[data-type-card]').forEach((el) => {
        const id = el.getAttribute('data-type-id');
        const check = el.querySelector('.check-icon');
        const iconArea = el.querySelector('.aspect-square');

        if (id === state.selectedTypeId) {
          el.classList.add('shadow-hard', 'ring-2', 'ring-accent-lavender');
          check?.classList.remove('hidden');
          iconArea?.classList.add('bg-accent-lavender-light');
        } else {
          el.classList.remove('shadow-hard', 'ring-2', 'ring-accent-lavender');
          check?.classList.add('hidden');
          iconArea?.classList.remove('bg-accent-lavender-light');
        }
      });
    }

    const MOODS_FILTER = [
      { value: 'all', label: 'All moods' },
      { value: 'professional', label: 'Professional' },
      { value: 'corporate', label: 'Corporate' },
      { value: 'creative', label: 'Creative' },
      { value: 'natural', label: 'Natural' },
      { value: 'energetic', label: 'Energetic' },
      { value: 'elegant', label: 'Elegant' },
      { value: 'playful', label: 'Playful' },
      { value: 'minimal', label: 'Minimal' },
    ];

    const VIBES_FILTER = [
      { value: 'all', label: 'All vibes' },
      { value: 'warm', label: '☀ Warm' },
      { value: 'cool', label: '❄ Cool' },
      { value: 'fresh', label: '🌿 Fresh' },
      { value: 'calm', label: '🌊 Calm' },
      { value: 'bold', label: '⚡ Bold' },
      { value: 'grounded', label: '🌱 Grounded' },
    ];

    function getFilteredPalettes() {
      return PALETTES.filter(p => {
        const moodMatch = state.selectedMoodFilter === 'all' || p.mood === state.selectedMoodFilter;
        const vibeMatch = state.selectedVibeFilter === 'all' || p.vibe === state.selectedVibeFilter;
        return moodMatch && vibeMatch;
      });
    }

    function renderMoodFilterChips() {
      const container = document.getElementById('moodFilterChips');
      if (!container) return;
      container.innerHTML = '';
      MOODS_FILTER.forEach(({ value, label }) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = [
          'filter-chip',
          'px-3 py-1.5 rounded-full border-1.5 text-sm font-medium transition-all duration-150',
          state.selectedMoodFilter === value
            ? 'bg-ink-primary text-cream border-ink-primary'
            : 'bg-cream-lighter text-ink-secondary border-ink-primary/30 hover:border-ink-primary',
        ].join(' ');
        btn.textContent = label;
        btn.setAttribute('aria-pressed', state.selectedMoodFilter === value ? 'true' : 'false');
        btn.addEventListener('click', () => {
          state.selectedMoodFilter = value;
          renderMoodFilterChips();
          renderVibeFilterChips(); // re-render vibes to keep counts accurate
          renderPaletteGrid();
          updatePaletteCountLabel();
        });
        container.appendChild(btn);
      });
    }

    function renderVibeFilterChips() {
      const container = document.getElementById('vibeFilterChips');
      if (!container) return;
      container.innerHTML = '';
      VIBES_FILTER.forEach(({ value, label }) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = [
          'filter-chip',
          'px-3 py-1.5 rounded-full border-1.5 text-sm font-medium transition-all duration-150',
          state.selectedVibeFilter === value
            ? 'bg-ink-primary text-cream border-ink-primary'
            : 'bg-cream-lighter text-ink-secondary border-ink-primary/30 hover:border-ink-primary',
        ].join(' ');
        btn.textContent = label;
        btn.setAttribute('aria-pressed', state.selectedVibeFilter === value ? 'true' : 'false');
        btn.addEventListener('click', () => {
          state.selectedVibeFilter = value;
          renderVibeFilterChips();
          renderPaletteGrid();
          updatePaletteCountLabel();
        });
        container.appendChild(btn);
      });
    }

    function updatePaletteCountLabel() {
      const label = document.getElementById('paletteCountLabel');
      if (!label) return;
      const count = getFilteredPalettes().length;
      const moodActive = state.selectedMoodFilter !== 'all';
      const vibeActive = state.selectedVibeFilter !== 'all';
      if (!moodActive && !vibeActive) {
        label.textContent = `Showing all ${PALETTES.length} palettes`;
      } else {
        label.textContent = `Showing ${count} palette${count !== 1 ? 's' : ''}`;
      }
    }

    function renderPaletteGrid() {
      const grid = document.getElementById('paletteGrid');
      if (!grid) return;

      const filtered = getFilteredPalettes();

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center">
            <p class="font-serif text-xl text-ink-secondary mb-2">No palettes match these filters</p>
            <p class="text-sm text-ink-tertiary mb-4">Try loosening the mood or vibe filter to see more options.</p>
            <button type="button" id="resetPaletteFiltersBtn" class="btn-secondary text-sm">Reset filters</button>
          </div>`;
        
        // Bind the reset filters button after injection
        const resetBtn = document.getElementById('resetPaletteFiltersBtn');
        resetBtn?.addEventListener('click', resetPaletteFilters);
        return;
      }

      grid.innerHTML = '';

      filtered.forEach(palette => {
        const isSelected = state.selectedPaletteId === palette.id;

        const card = document.createElement('button');
        card.type = 'button';
        card.role = 'radio';
        card.setAttribute('data-palette-card', '');
        card.setAttribute('data-palette-id', palette.id);
        card.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        card.setAttribute('aria-label', `${palette.name} — ${palette.mood}, ${palette.vibe}`);
        card.className = [
          'palette-card group relative overflow-hidden rounded-card text-left',
          'border-1.5 border-ink-primary bg-cream-lighter',
          'transition-all duration-200',
          'hover:-translate-y-0.5 hover:shadow-hard',
          'focus:outline-none focus-visible:ring-4 focus-visible:ring-accent-lavender focus-visible:ring-offset-2',
          isSelected ? 'shadow-hard ring-4 ring-accent-lavender ring-offset-2' : '',
        ].join(' ');

        // Swatch strip
        const swatchStrip = document.createElement('div');
        swatchStrip.className = 'flex h-12 w-full overflow-hidden rounded-t-[18px]';
        palette.colors.forEach(color => {
          const swatch = document.createElement('span');
          swatch.style.cssText = `background:${color};flex:1;display:block;`;
          swatchStrip.appendChild(swatch);
        });

        // Card body
        const body = document.createElement('div');
        body.className = 'p-3';

        // Name line with optional New badge
        const nameLine = document.createElement('p');
        nameLine.className = 'font-serif text-sm font-medium text-ink-primary leading-tight mb-1.5 flex items-center gap-1.5 flex-wrap';
        nameLine.textContent = palette.name;
        if (palette.isNew) {
          const badge = document.createElement('span');
          badge.className = 'text-[9px] font-sans font-semibold bg-accent-lime text-ink-primary px-1.5 py-0.5 rounded-full uppercase tracking-wide';
          badge.textContent = 'New';
          nameLine.appendChild(badge);
        }

        // Pill chips
        const chips = document.createElement('div');
        chips.className = 'flex gap-1.5 mb-2 flex-wrap';
        chips.innerHTML = `
          <span class="pill-lavender text-[10px] px-2 py-0.5">${palette.mood}</span>
          <span class="pill-cream text-[10px] px-2 py-0.5">${palette.vibe}</span>
        `;

        // Hex values
        const hexRow = document.createElement('div');
        hexRow.className = 'flex gap-1 flex-wrap';
        palette.colors.forEach(color => {
          const chip = document.createElement('span');
          chip.className = 'font-mono text-[9px] text-ink-tertiary bg-cream-darker px-1 py-0.5 rounded';
          chip.textContent = color;
          hexRow.appendChild(chip);
        });

        body.appendChild(nameLine);
        body.appendChild(chips);
        body.appendChild(hexRow);
        card.appendChild(swatchStrip);
        card.appendChild(body);

        // Checkmark badge (visible only when selected)
        const checkBadge = document.createElement('div');
        checkBadge.className = [
          'absolute top-2 right-2 w-6 h-6 rounded-full',
          'bg-accent-lavender border-1.5 border-ink-primary shadow-hard',
          'flex items-center justify-center',
          'transition-opacity duration-150',
          isSelected ? 'opacity-100' : 'opacity-0',
        ].join(' ');
        checkBadge.setAttribute('aria-hidden', 'true');
        checkBadge.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polyline points="2,6 5,9 10,3" stroke="#0A0A0A" stroke-width="1.75"
                      stroke-linecap="round" stroke-linejoin="round"/>
          </svg>`;
        card.appendChild(checkBadge);

        // Click handler — open detail popover
        card.addEventListener('click', () => openPalettePopover(palette, card));

        grid.appendChild(card);
      });
    }

    function resetPaletteFilters() {
      state.selectedMoodFilter = 'all';
      state.selectedVibeFilter = 'all';
      saveState();
      renderMoodFilterChips();
      renderVibeFilterChips();
      renderPaletteGrid();
      updatePaletteCountLabel();
    }

    function clearPaletteSelection() {
      state.selectedPaletteId = null;
      saveState();
      render();
    }

    function updateSelectedPaletteSummary() {
      const summary = document.getElementById('selectedPaletteSummary');
      const swatchContainer = summary?.querySelector('.selected-palette-swatches');
      const nameEl = document.getElementById('selectedPaletteName');
      const descEl = document.getElementById('selectedPaletteDesc');
      const nextBtn = document.getElementById('step2NextBtn');

      if (!state.selectedPaletteId) {
        summary?.classList.add('hidden');
        if (nextBtn) nextBtn.disabled = true;
        return;
      }

      const palette = getPaletteById(state.selectedPaletteId);
      if (!palette) return;

      // Populate swatches
      if (swatchContainer) {
        swatchContainer.innerHTML = palette.colors
          .map(c => `<span style="background:${c};flex:1;display:block;"></span>`)
          .join('');
      }

      if (nameEl) nameEl.textContent = palette.name;
      if (descEl) descEl.textContent = palette.description;

      summary?.classList.remove('hidden');
      if (nextBtn) nextBtn.disabled = false;
    }

    let popoverTargetPaletteId = null;
    let popoverTriggerCard = null;

    function openPalettePopover(palette, cardElement) {
      popoverTargetPaletteId = palette.id;
      popoverTriggerCard = cardElement;

      // Swatches
      const swatchStrip = document.getElementById('popoverSwatchStrip');
      if (swatchStrip) {
        swatchStrip.innerHTML = palette.colors
          .map(c => `<span style="background:${c};flex:1;display:block;"></span>`)
          .join('');
      }

      // Name
      const nameEl = document.getElementById('popoverPaletteName');
      if (nameEl) nameEl.textContent = palette.name;

      // Badges
      const badgesEl = document.getElementById('popoverBadges');
      if (badgesEl) {
        badgesEl.innerHTML = `
          <span class="pill-lavender text-[10px] px-2 py-0.5">${palette.mood}</span>
          <span class="pill-cream text-[10px] px-2 py-0.5">${palette.vibe}</span>
          ${palette.isNew ? '<span class="text-[9px] font-sans font-semibold bg-accent-lime text-ink-primary px-1.5 py-0.5 rounded-full uppercase tracking-wide">New</span>' : ''}
        `;
      }

      // Description
      const descEl = document.getElementById('popoverDescription');
      if (descEl) descEl.textContent = palette.description;

      // Color labels grid
      const labelsGrid = document.getElementById('popoverColorLabels');
      if (labelsGrid) {
        labelsGrid.innerHTML = palette.colors.map((color, i) => `
          <div class="flex items-center gap-2 p-2 rounded-card-sm bg-cream-lighter border-1.5 border-ink-primary/10">
            <span
              class="w-7 h-7 rounded-[6px] border-1.5 border-ink-primary/20 flex-shrink-0"
              style="background:${color}"
            ></span>
            <div class="min-w-0">
              <p class="text-[11px] font-medium text-ink-primary leading-none mb-0.5">
                ${palette.labels ? palette.labels[i] : `Stop ${i + 1}`}
              </p>
              <p class="font-mono text-[10px] text-ink-tertiary leading-none">${color}</p>
            </div>
          </div>
        `).join('');
      }

      // Show popover
      const popover = document.getElementById('palettePopover');
      if (popover) {
        popover.classList.remove('hidden');
        // Focus the confirm button for keyboard users
        setTimeout(() => {
          document.getElementById('popoverConfirmBtn')?.focus();
        }, 50);
      }

      // Trap Escape key
      document.addEventListener('keydown', handlePopoverKeydown);
    }

    function closePalettePopover() {
      const popover = document.getElementById('palettePopover');
      if (popover) popover.classList.add('hidden');
      popoverTargetPaletteId = null;
      document.removeEventListener('keydown', handlePopoverKeydown);

      // Restore focus
      if (popoverTriggerCard) {
        popoverTriggerCard.focus();
        popoverTriggerCard = null;
      }
    }

    function handlePopoverKeydown(e) {
      if (e.key === 'Escape') closePalettePopover();
    }

    function confirmPaletteSelection() {
      if (!popoverTargetPaletteId) return;
      selectPalette(popoverTargetPaletteId);
      closePalettePopover();
    }

    function renderPaletteSelections() {
      renderPaletteGrid();
      updateSelectedPaletteSummary();
    }

    function renderStyleSelections() {
      document.querySelectorAll('[data-style-card]').forEach((el) => {
        const type = el.getAttribute('data-style-type');
        const id = el.getAttribute('data-style-id');
        let selectedId = null;
        if (type === 'connector') selectedId = state.selectedConnectorId;
        else if (type === 'icon') selectedId = state.selectedIconId;
        else if (type === 'mood') selectedId = state.selectedMoodId;

        if (id === selectedId) {
          el.classList.add('bg-accent-lavender-light', 'shadow-hard');
        } else {
          el.classList.remove('bg-accent-lavender-light', 'shadow-hard');
        }
      });
    }

    function renderSummaryTags() {
      const el = document.getElementById('summary-tags');
      if (!el) return;

      const tags = [];
      const t = getTypeById(state.selectedTypeId);
      const p = getPaletteById(state.selectedPaletteId);
      const c = getConnectorById(state.selectedConnectorId);
      const i = getIconById(state.selectedIconId);
      const m = getMoodById(state.selectedMoodId);

      if (t) tags.push({ label: t.name, color: 'bg-accent-lavender' });
      if (p) tags.push({ label: p.name, color: 'bg-accent-pink' });
      if (c) tags.push({ label: `${c.name} lines`, color: 'bg-accent-lime' });
      if (i) tags.push({ label: `${i.name} icons`, color: 'bg-accent-sky' });
      if (m) tags.push({ label: `${m.name} mood`, color: 'bg-accent-orange' });

      el.innerHTML = tags
        .map(
          (tag) =>
            `<span class="pill ${tag.color} text-ink-primary text-xs">${tag.label}</span>`
        )
        .join('');
    }

    function renderPrompt() {
      const ta = document.getElementById('generated-prompt');
      const charCount = document.getElementById('prompt-char-count');
      if (!ta) return;

      const text = generatePrompt();
      ta.value = text;
      if (charCount) charCount.textContent = `${text.length} characters`;
    }

    function renderNavButtons() {
      document.querySelectorAll('[data-go-next]').forEach((btn) => {
        if (canAdvance()) {
          btn.removeAttribute('disabled');
        } else {
          btn.setAttribute('disabled', 'true');
        }
      });
    }

    // ---- Event listeners -----------------------------------------------
    function attachEventListeners() {
      document.querySelectorAll('[data-step-indicator]').forEach((el) => {
        el.addEventListener('click', () => {
          const step = parseInt(el.getAttribute('data-step-indicator'));
          goToStep(step);
        });
      });

      document.querySelectorAll('[data-type-card]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-type-id');
          if (id) selectType(id);
        });
      });

      // Palette Popover listeners
      document.getElementById('palettePopoverBackdrop')?.addEventListener('click', closePalettePopover);
      document.getElementById('popoverCancelBtn')?.addEventListener('click', closePalettePopover);
      document.getElementById('popoverConfirmBtn')?.addEventListener('click', confirmPaletteSelection);
      document.getElementById('clearPaletteBtn')?.addEventListener('click', clearPaletteSelection);

      document.querySelectorAll('[data-style-card]').forEach((el) => {
        el.addEventListener('click', () => {
          const type = el.getAttribute('data-style-type');
          const id = el.getAttribute('data-style-id');
          if (type && id) selectStyle(type, id);
        });
      });

      document.querySelectorAll('[data-category-filter]').forEach((el) => {
        el.addEventListener('click', () => {
          const cat = el.getAttribute('data-category-filter');
          if (cat) setCategoryFilter(cat);
        });
      });

      const searchInput = document.getElementById('search-input');
      searchInput?.addEventListener('input', (e) => {
        setSearchQuery(e.target.value);
      });

      const userContent = document.getElementById('user-content');
      userContent?.addEventListener('input', (e) => {
        setUserContent(e.target.value);
      });

      document.querySelectorAll('[data-go-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
          goToStep(state.currentStep + 1);
        });
      });

      document.querySelectorAll('[data-go-back]').forEach((btn) => {
        btn.addEventListener('click', () => {
          goToStep(state.currentStep - 1);
        });
      });

      document.getElementById('copy-btn')?.addEventListener('click', copyPrompt);
      document.getElementById('download-btn')?.addEventListener('click', downloadPrompt);
      document.getElementById('reset-btn')?.addEventListener('click', resetAll);
    }

    function initStep2() {
      renderMoodFilterChips();
      renderVibeFilterChips();
      renderPaletteGrid();
      updatePaletteCountLabel();
      updateSelectedPaletteSummary();
    }

    function init() {
      loadState();
      attachEventListeners();

      const searchInput = document.getElementById('search-input');
      if (searchInput && state.searchQuery) searchInput.value = state.searchQuery;

      const userContent = document.getElementById('user-content');
      if (userContent) userContent.value = state.userContent;

      initStep2();
      render();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>

</Layout>

