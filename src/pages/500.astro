---
import Layout from '../layouts/Layout.astro';
import Squiggle from '../components/Squiggle.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : 'Unknown server exception';
---

<Layout 
  title="Server Error (500) — VisualCraft"
  description="Sorry, a critical server-side exception occurred. Please try reloading the page or return to the main dashboard."
  noindex={true}
>
  <section class="min-h-[80vh] flex items-center justify-center bg-cream relative overflow-hidden py-16 px-4">
    <!-- Floating background decorative elements -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute top-1/4 left-10 w-4 h-4 rounded-full bg-accent-pink animate-float"></div>
      <div class="absolute bottom-1/4 right-10 w-3 h-3 rounded-full bg-accent-orange animate-float delay-200"></div>
      <div class="absolute top-1/3 right-1/4 w-3.5 h-3.5 rounded-full bg-accent-lavender animate-float delay-500"></div>
      <div class="absolute bottom-1/3 left-1/4 w-2.5 h-2.5 rounded-full bg-accent-lime animate-float delay-100"></div>
    </div>

    <div class="max-w-2xl w-full text-center relative z-10">
      <!-- Animated Visual Illustration -->
      <div class="flex justify-center mb-8 relative">
        <div class="w-32 h-32 rounded-full bg-accent-pink border-2 border-ink-primary flex items-center justify-center relative animate-pulse shadow-card">
          <!-- Server Crash SVG -->
          <svg viewBox="0 0 24 24" class="w-16 h-16 text-ink-primary" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <!-- Server Rack 1 -->
            <rect x="2" y="3" width="20" height="5" rx="1"></rect>
            <circle cx="6" cy="5.5" r="1" fill="currentColor"></circle>
            <circle cx="10" cy="5.5" r="1" fill="#EE7A53"></circle>
            
            <!-- Server Rack 2 (slanted/falling over) -->
            <g transform="rotate(-5 12 13)">
              <rect x="2" y="10" width="20" height="5" rx="1" stroke="#EE7A53"></rect>
              <circle cx="6" cy="12.5" r="1" fill="#EE7A53"></circle>
              <!-- Spark lines -->
              <path d="M16 12.5l2-2m-1 3l2 2" stroke="#EE7A53" stroke-width="1.5"></path>
            </g>

            <!-- Server Rack 3 -->
            <rect x="2" y="17" width="20" height="5" rx="1"></rect>
            <circle cx="6" cy="19.5" r="1" fill="currentColor"></circle>
            <circle cx="10" cy="19.5" r="1" fill="currentColor"></circle>
          </svg>

          <!-- Floating badge: 500 -->
          <span class="absolute -top-3 -right-3 pill bg-accent-orange text-cream font-bold text-xs uppercase border-ink-primary px-3 py-1 shadow-card -rotate-12">
            Crash
          </span>
        </div>
      </div>

      <!-- Large Typography Header -->
      <h1 class="font-serif text-8xl md:text-9xl font-bold text-ink-primary tracking-tight leading-none">
        500
      </h1>
      
      <h2 class="mt-6 font-serif text-3xl md:text-4xl font-medium text-ink-primary">
        Internal system <em>failure</em>.
      </h2>

      <p class="mt-4 body-base text-ink-secondary max-w-md mx-auto">
        Something snapped under the hood. A critical runtime exception was caught by our layout processor.
      </p>

      <!-- Diagnostics Panel (Folds nicely, matches clean aesthetic) -->
      <div class="mt-8 max-w-lg mx-auto bg-cream-darker/35 border-1.5 border-ink-primary/20 rounded-xl p-4 text-left font-mono text-xs text-ink-secondary overflow-x-auto shadow-sm">
        <p class="text-ink-tertiary font-semibold uppercase tracking-wider mb-2 text-[10px]">Diagnostics</p>
        <p class="break-all">{errorMessage}</p>
        <p class="text-ink-tertiary mt-2">Time: {new Date().toISOString()}</p>
      </div>

      <div class="mt-8 flex justify-center">
        <Squiggle color="#5822F4" width="120" />
      </div>

      <!-- Navigation Actions -->
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button 
          id="reload-button"
          class="btn-primary text-base px-8 py-3.5 shadow-card hover:-translate-y-0.5 hover:shadow-card-hover active:translate-y-0 transition-all cursor-pointer"
        >
          Try Reloading
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
        </button>
        <a href="/" class="btn-secondary text-base px-8 py-3.5">
          Back to Homepage
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Simple client-side page reload script
  const reloadBtn = document.getElementById('reload-button');
  if (reloadBtn) {
    reloadBtn.addEventListener('click', () => {
      window.location.reload();
    });
  }
</script>
