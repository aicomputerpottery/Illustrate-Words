---
import Layout from '../layouts/Layout.astro';
import Squiggle from '../components/Squiggle.astro';
import { CATEGORIES } from '../data/visualizations.js';

// Pull the 13 categories for the preview section
const categoryPreview = CATEGORIES.map((cat) => ({
  id: cat.id,
  name: cat.name,
  icon: cat.icon,
  description: cat.description,
  count: cat.types.length,
}));

// Comparison data
const comparison = [
  { feature: 'Free forever, no subscription', us: true, them: false },
  { feature: 'No account or login required', us: true, them: false },
  { feature: 'Works with any AI tool', us: true, them: false },
  { feature: '60+ visualization types', us: true, them: true },
  { feature: '25 curated color palettes', us: true, them: false },
  { feature: 'Custom style options', us: true, them: false },
  { feature: 'Open source code', us: true, them: false },
];

// Use cases
const useCases = [
  {
    title: 'Consultants & Analysts',
    description: 'Generate SWOT analyses, business model canvases, and comparison charts for client decks in seconds.',
    icon: '📊',
    bg: 'bg-accent-lavender',
    rotate: '-rotate-2',
  },
  {
    title: 'Students & Educators',
    description: 'Visualize concepts, timelines, and processes for assignments and presentations.',
    icon: '🎓',
    bg: 'bg-accent-lime',
    rotate: 'rotate-1',
  },
  {
    title: 'Designers & PMs',
    description: 'Create user journey maps, flowcharts, and product diagrams ready for stakeholder review.',
    icon: '✨',
    bg: 'bg-accent-pink',
    rotate: '-rotate-1',
  },
];

// Steps
const steps = [
  {
    number: '01',
    title: 'Pick your visualization',
    description: 'Choose from 13 categories and 60+ chart types — from mindmaps to SWOT analyses, every visual format Napkin AI offers.',
    accent: 'bg-accent-lavender',
  },
  {
    number: '02',
    title: 'Choose your style',
    description: 'Select a color palette from 25 curated combinations, then pick connector style, icon style, and layout mood.',
    accent: 'bg-accent-lime',
  },
  {
    number: '03',
    title: 'Copy your prompt',
    description: 'Get a detailed, AI-ready prompt. Paste it into Gemini, ChatGPT, Claude, or Midjourney and get your visualization.',
    accent: 'bg-accent-pink',
  },
];
---

<Layout>

  <!-- ============================================================ -->
  <!-- 1. HERO SECTION                                              -->
  <!-- ============================================================ -->
  <section class="relative bg-cream pt-8 pb-20 md:pb-32 overflow-hidden">

    <!-- Decorative scattered dots -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-32 left-8 md:left-32 w-3 h-3 rounded-full bg-accent-lavender animate-float"></div>
      <div class="absolute top-48 right-12 md:right-48 w-4 h-4 rounded-full bg-accent-lime animate-float delay-200"></div>
      <div class="absolute bottom-24 left-1/4 w-2.5 h-2.5 rounded-full bg-accent-pink animate-float delay-300"></div>
      <div class="absolute top-1/3 right-1/3 w-2 h-2 rounded-full bg-accent-orange animate-float delay-400"></div>
    </div>

    <div class="container-page relative">

      <!-- Pre-headline pill -->
      <div class="flex justify-center pt-8 md:pt-12">
        <span class="pill-cream">
          <span class="w-2 h-2 rounded-full bg-accent-lime"></span>
          Free forever. No login required.
        </span>
      </div>

      <!-- Main headline -->
      <h1 class="text-center mt-8 headline-display max-w-5xl mx-auto">
        Turn any idea<br />
        into a <em>stunning</em><br />
        visualization.
      </h1>

      <!-- Subheadline -->
      <p class="text-center mt-8 body-lg max-w-2xl mx-auto">
        Choose your chart type, pick your colors, and get an AI-ready prompt
        in seconds. Works with Gemini, ChatGPT, Claude, and Midjourney.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/generate" class="btn-primary text-base">
          Start Generating
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/gallery" class="btn-secondary text-base">
          See Examples
        </a>
      </div>

      <!-- Trust microcopy with squiggle -->
      <div class="mt-8 flex flex-col items-center gap-2">
        <Squiggle color="#B5A5F0" width="100" />
        <p class="text-sm text-ink-secondary text-center">
          Built for designers, consultants, students, and product teams
        </p>
      </div>

      <!-- Hero visual mockup (a stylized preview of the 3-step wizard) -->
      <div class="mt-16 md:mt-20 relative max-w-4xl mx-auto">

        <!-- Mockup card with thick border and shadow -->
        <div class="bg-cream-lighter rounded-card border-1.5 border-ink-primary shadow-hard p-6 md:p-10 transform -rotate-1 hover:rotate-0 transition-transform duration-300">

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

            <!-- Step 1 preview -->
            <div class="bg-cream rounded-card-sm border-1.5 border-ink-primary p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="font-serif text-2xl">01</span>
                <span class="text-xs uppercase font-medium tracking-wider">Type</span>
              </div>
              <div class="text-3xl mb-2">🧠</div>
              <p class="font-medium">Mindmap</p>
              <p class="text-xs text-ink-secondary mt-1">Central node map</p>
            </div>

            <!-- Step 2 preview -->
            <div class="bg-cream rounded-card-sm border-1.5 border-ink-primary p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="font-serif text-2xl">02</span>
                <span class="text-xs uppercase font-medium tracking-wider">Palette</span>
              </div>
              <div class="flex gap-1 mb-3">
                <div class="w-7 h-7 rounded-full bg-accent-lavender border-1.5 border-ink-primary"></div>
                <div class="w-7 h-7 rounded-full bg-accent-pink border-1.5 border-ink-primary"></div>
                <div class="w-7 h-7 rounded-full bg-accent-lime border-1.5 border-ink-primary"></div>
                <div class="w-7 h-7 rounded-full bg-accent-orange border-1.5 border-ink-primary"></div>
              </div>
              <p class="font-medium">Tropical</p>
              <p class="text-xs text-ink-secondary mt-1">Energetic mood</p>
            </div>

            <!-- Step 3 preview -->
            <div class="bg-ink-primary text-cream rounded-card-sm border-1.5 border-ink-primary p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="font-serif text-2xl">03</span>
                <span class="text-xs uppercase font-medium tracking-wider opacity-70">Prompt</span>
              </div>
              <div class="bg-forest-light rounded-md p-3 text-xs leading-relaxed font-mono">
                Create a professional central node mindmap...
              </div>
              <button class="mt-3 w-full bg-accent-lavender text-ink-primary border-1.5 border-cream py-2 rounded-full text-sm font-medium">
                Copy Prompt ✓
              </button>
            </div>

          </div>
        </div>

        <!-- Decorative arrow squiggle -->
        <div class="absolute -top-6 -right-6 hidden md:block transform rotate-12">
          <Squiggle color="#F26835" width="80" rotate="20deg" />
        </div>

      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 2. TRUST BAR — "Works with"                                  -->
  <!-- ============================================================ -->
  <section class="bg-cream-darker py-12 md:py-16 border-y-1.5 border-ink-primary">
    <div class="container-page">
      <p class="text-center label mb-8">
        Works with every major AI tool
      </p>
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12 lg:gap-16">
        <div class="flex items-center gap-2.5 text-ink-primary opacity-80 hover:opacity-100 transition-opacity">
          <span class="text-2xl">✨</span>
          <span class="font-serif text-xl font-medium">Gemini</span>
        </div>
        <div class="flex items-center gap-2.5 text-ink-primary opacity-80 hover:opacity-100 transition-opacity">
          <span class="text-2xl">💬</span>
          <span class="font-serif text-xl font-medium">ChatGPT</span>
        </div>
        <div class="flex items-center gap-2.5 text-ink-primary opacity-80 hover:opacity-100 transition-opacity">
          <span class="text-2xl">🧡</span>
          <span class="font-serif text-xl font-medium">Claude</span>
        </div>
        <div class="flex items-center gap-2.5 text-ink-primary opacity-80 hover:opacity-100 transition-opacity">
          <span class="text-2xl">🎨</span>
          <span class="font-serif text-xl font-medium">Midjourney</span>
        </div>
        <div class="flex items-center gap-2.5 text-ink-primary opacity-80 hover:opacity-100 transition-opacity">
          <span class="text-2xl">🌟</span>
          <span class="font-serif text-xl font-medium">DALL·E</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3. HOW IT WORKS — Dark forest section                        -->
  <!-- ============================================================ -->
  <section class="section bg-forest text-cream relative overflow-hidden">

    <!-- Decorative dots -->
    <div class="absolute inset-0 pointer-events-none opacity-30">
      <div class="absolute top-20 left-1/4 w-3 h-3 rounded-full bg-accent-lavender"></div>
      <div class="absolute top-1/2 right-12 w-2 h-2 rounded-full bg-accent-lime"></div>
      <div class="absolute bottom-32 left-12 w-2.5 h-2.5 rounded-full bg-accent-pink"></div>
    </div>

    <div class="container-page relative">

      <!-- Section header -->
      <div class="text-center max-w-3xl mx-auto">
        <span class="pill bg-accent-lavender text-ink-primary">
          How it works
        </span>
        <h2 class="mt-6 headline-h1">
          From idea to <em>visualization</em><br />
          in three steps.
        </h2>
        <p class="mt-6 body-lg !text-ink-on-dark-secondary">
          No subscriptions. No learning curve. No magic — just clear prompts that any AI tool can turn into a beautiful visual.
        </p>
      </div>

      <!-- Steps grid -->
      <div class="mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-3 gap-6">
        {steps.map((step, idx) => (
          <div class="relative">
            <!-- Step card -->
            <div class="card-dark h-full p-8">

              <!-- Step number -->
              <div class={`inline-flex items-center justify-center w-14 h-14 ${step.accent} text-ink-primary rounded-full border-1.5 border-cream font-serif text-2xl font-medium`}>
                {step.number}
              </div>

              <!-- Title -->
              <h3 class="mt-6 font-serif text-2xl font-medium">
                {step.title}
              </h3>

              <!-- Description -->
              <p class="mt-3 text-ink-on-dark-secondary leading-relaxed">
                {step.description}
              </p>

            </div>

            <!-- Connecting squiggle (desktop only, between steps) -->
            {idx < steps.length - 1 && (
              <div class="hidden md:block absolute top-1/2 -right-6 transform -translate-y-1/2 z-10">
                <Squiggle color="#D4E84A" width="48" />
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 4. CATEGORIES PREVIEW                                        -->
  <!-- ============================================================ -->
  <section class="section bg-cream relative overflow-hidden">

    <!-- Decorative squiggles -->
    <div class="absolute top-32 right-8 opacity-50 hidden md:block">
      <Squiggle color="#B5A5F0" width="150" rotate="-12deg" />
    </div>

    <div class="container-page relative">

      <!-- Section header -->
      <div class="text-center max-w-3xl mx-auto">
        <span class="pill-lime">
          13 categories
        </span>
        <h2 class="mt-6 headline-h1">
          Every type of visualization, <em>covered</em>.
        </h2>
        <p class="mt-6 body-lg">
          From mindmaps to SWOT analyses, business model canvases to Gantt charts.
          76 visualization types across 13 categories — completely free.
        </p>
      </div>

      <!-- Categories grid -->
      <div class="mt-16 md:mt-20 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {categoryPreview.map((cat, idx) => {
          const colors = ['bg-accent-lavender', 'bg-accent-lime', 'bg-accent-pink', 'bg-accent-orange', 'bg-accent-sky'];
          const colorClass = colors[idx % colors.length];
          return (
            <a
              href={`/generate?category=${cat.id}`}
              class="group block card card-hover"
            >
              <div class={`w-14 h-14 ${colorClass} rounded-full border-1.5 border-ink-primary flex items-center justify-center text-2xl mb-4 transition-transform duration-200 group-hover:rotate-12`}>
                {cat.icon}
              </div>
              <h3 class="font-serif text-lg font-medium">{cat.name}</h3>
              <p class="text-xs text-ink-secondary mt-1">{cat.count} types</p>
            </a>
          );
        })}
      </div>

      <!-- Browse all CTA -->
      <div class="mt-12 flex justify-center">
        <a href="/generate" class="btn-secondary">
          Browse all 76 types
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 5. COMPARISON — VisualCraft vs Napkin AI                     -->
  <!-- ============================================================ -->
  <section class="section bg-forest text-cream relative overflow-hidden">

    <div class="container-page relative">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto">
        <span class="pill bg-accent-pink text-ink-primary">
          The difference
        </span>
        <h2 class="mt-6 headline-h1">
          Why <em>VisualCraft</em>?
        </h2>
        <p class="mt-6 body-lg !text-ink-on-dark-secondary">
          We do one thing — generate AI prompts — and we do it without subscriptions, accounts, or lock-in.
        </p>
      </div>

      <!-- Comparison table -->
      <div class="mt-16 max-w-4xl mx-auto">

        <!-- Header row -->
        <div class="grid grid-cols-12 gap-4 pb-4 border-b border-cream/20">
          <div class="col-span-6"></div>
          <div class="col-span-3 text-center">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent-lavender text-ink-primary rounded-full border-1.5 border-cream font-serif font-medium">
              <span class="w-2 h-2 rounded-full bg-accent-lime"></span>
              VisualCraft
            </div>
          </div>
          <div class="col-span-3 text-center">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-forest-light text-ink-on-dark-secondary rounded-full border border-cream/20 font-medium">
              Napkin AI
            </div>
          </div>
        </div>

        <!-- Comparison rows -->
        {comparison.map((row, idx) => (
          <div class:list={[
            'grid grid-cols-12 gap-4 py-5',
            idx < comparison.length - 1 ? 'border-b border-cream/10' : ''
          ]}>
            <div class="col-span-6 font-medium">
              {row.feature}
            </div>
            <div class="col-span-3 text-center">
              {row.us ? (
                <span class="inline-flex items-center justify-center w-8 h-8 bg-accent-lime text-ink-primary rounded-full">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
              ) : (
                <span class="inline-flex items-center justify-center w-8 h-8 bg-forest-light text-cream/30 rounded-full">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </span>
              )}
            </div>
            <div class="col-span-3 text-center">
              {row.them ? (
                <span class="inline-flex items-center justify-center w-8 h-8 bg-cream/10 text-cream rounded-full">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
              ) : (
                <span class="inline-flex items-center justify-center w-8 h-8 bg-cream/5 text-cream/30 rounded-full">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </span>
              )}
            </div>
          </div>
        ))}

      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 6. USE CASES                                                 -->
  <!-- ============================================================ -->
  <section class="section bg-cream relative overflow-hidden">

    <div class="container-page relative">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto">
        <span class="pill-pink">
          Built for everyone
        </span>
        <h2 class="mt-6 headline-h1">
          Who uses <em>VisualCraft</em>?
        </h2>
        <p class="mt-6 body-lg">
          From boardrooms to classrooms, anyone who needs to visualize an idea fast.
        </p>
      </div>

      <!-- Use case cards -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {useCases.map((useCase) => (
          <div class={`card card-hover ${useCase.rotate} hover:rotate-0`}>
            <div class={`w-16 h-16 ${useCase.bg} rounded-full border-1.5 border-ink-primary flex items-center justify-center text-3xl mb-5`}>
              {useCase.icon}
            </div>
            <h3 class="font-serif text-2xl font-medium">{useCase.title}</h3>
            <p class="mt-3 text-ink-secondary leading-relaxed">{useCase.description}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 7. FINAL CTA                                                 -->
  <!-- ============================================================ -->
  <section class="section bg-accent-lavender relative overflow-hidden border-y-1.5 border-ink-primary">

    <!-- Decorative elements -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-12 left-12 text-6xl opacity-30 transform -rotate-12">✦</div>
      <div class="absolute top-1/2 right-12 text-5xl opacity-30 transform rotate-12">✦</div>
      <div class="absolute bottom-12 left-1/3 text-4xl opacity-30">✦</div>
      <div class="absolute top-1/3 left-1/2 text-5xl opacity-30 transform -rotate-6">✦</div>
    </div>

    <div class="container-page relative text-center">

      <h2 class="headline-h1 max-w-3xl mx-auto">
        Ready to <em>visualize</em><br />
        your ideas?
      </h2>

      <p class="mt-6 body-lg !text-ink-primary max-w-2xl mx-auto">
        Free, instant, no account needed. Get your first AI-ready visualization prompt in under 60 seconds.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/generate" class="btn-primary text-base">
          Start Generating Now
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/gallery" class="btn-secondary text-base">
          Browse Examples
        </a>
      </div>

      <p class="mt-8 text-sm text-ink-primary/70">
        Works with Gemini · ChatGPT · Claude · Midjourney · DALL·E
      </p>

    </div>
  </section>

</Layout>

