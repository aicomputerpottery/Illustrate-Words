<style is:global>
  /* Force injected SVGs in category card rounded wrappers to scale properly */
  .group .rounded-full svg {
    width: 1.75rem !important;
    height: 1.75rem !important;
  }

  /* ── Hero demo: words → visual ─────────────────────────── */
  .hero-caret {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    background: #4824DE;
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: heroBlink 1s steps(1) infinite;
  }
  @keyframes heroBlink { 50% { opacity: 0; } }

  .hero-stage {
    background-color: #FFFFFF;
    background-image: radial-gradient(circle, rgba(10, 10, 10, 0.07) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .hero-scene.scene-active { opacity: 1; }

  .hero-scene .draw {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .hero-scene.scene-active .draw {
    animation: heroDraw 0.7s ease forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes heroDraw { to { stroke-dashoffset: 0; } }

  .hero-scene .pop {
    opacity: 0;
    transform: scale(0.6);
    transform-origin: center;
    transform-box: fill-box;
  }
  .hero-scene.scene-active .pop {
    animation: heroPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes heroPop { to { opacity: 1; transform: scale(1); } }

  .hero-scene .grow {
    transform: scaleY(0);
    transform-origin: bottom;
    transform-box: fill-box;
  }
  .hero-scene.scene-active .grow {
    animation: heroGrow 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes heroGrow { to { transform: scaleY(1); } }

  .hero-chip { transition: opacity 0.3s ease, transform 0.3s ease; }
  .hero-chip.chip-in { opacity: 1 !important; transform: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .hero-caret { animation: none; }
    .hero-scene { transition: none; }
    .hero-scene .draw,
    .hero-scene .pop,
    .hero-scene .grow {
      animation: none !important;
      stroke-dashoffset: 0;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  function initHeroDemo() {
    const typedEl = document.getElementById('hero-typed');
    const scenes = Array.from(document.querySelectorAll('.hero-scene'));
    const chipRows = Array.from(document.querySelectorAll('.hero-chip-row'));
    if (!typedEl || scenes.length === 0) return;

    const texts = [
      'Launch plan for a new coffee shop',
      'Onboarding: from signup to first win',
      'Q3 revenue by product line',
    ];

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    let idx = 0;

    async function typeText(text) {
      typedEl.textContent = '';
      if (reduced) { typedEl.textContent = text; return; }
      for (let i = 0; i < text.length; i++) {
        typedEl.textContent += text[i];
        await sleep(24);
      }
    }

    function showChips(i) {
      chipRows.forEach((row, r) => {
        row.classList.toggle('hidden', r !== i);
        row.classList.toggle('flex', r === i);
        if (r === i) {
          row.querySelectorAll('.hero-chip').forEach((chip, c) => {
            chip.classList.remove('chip-in');
            if (reduced) { chip.classList.add('chip-in'); return; }
            setTimeout(() => chip.classList.add('chip-in'), 140 * c);
          });
        }
      });
    }

    function showScene(i) {
      scenes.forEach((s, si) => s.classList.toggle('scene-active', si === i));
    }

    async function cycle() {
      while (true) {
        showScene(-1);
        await sleep(reduced ? 60 : 380);
        await typeText(texts[idx]);
        showChips(idx);
        await sleep(reduced ? 60 : 420);
        showScene(idx);
        await sleep(reduced ? 5600 : 4800);
        idx = (idx + 1) % scenes.length;
      }
    }
    cycle();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroDemo);
  } else {
    initHeroDemo();
  }
</script>

