---
import Layout from '../layouts/Layout.astro';
import Squiggle from '../components/Squiggle.astro';
import LandingWalkthrough from '../components/LandingWalkthrough.astro';
import { CATEGORIES } from '../data/visualizations.js';
import VisualizationMarquee from '../components/VisualizationMarquee.astro';

// Comparison data
const comparison = [
  { feature: 'Free forever',            note: 'No trial timer, no paywall, no upsell',        us: true, them: false, dot: 'bg-accent-lime'     },
  { feature: 'No account or login',     note: 'Open the page and go — nothing to sign up for', us: true, them: false, dot: 'bg-accent-pink'     },
  { feature: 'Works with any AI tool',  note: 'ChatGPT, Claude, Gemini, Midjourney, DALL·E',   us: true, them: false, dot: 'bg-accent-sky'      },
  { feature: '76 visualization types',  note: '13 categories, mindmaps to SWOT',               us: true, them: true,  dot: 'bg-accent-lavender' },
  { feature: '25 curated palettes',     note: 'Hand-picked color sets, ready to drop in',      us: true, them: false, dot: 'bg-accent-orange'   },
  { feature: 'Custom style controls',   note: 'Connectors, icons, mood — all yours',           us: true, them: false, dot: 'bg-accent-lime'     },
  { feature: 'Open source',             note: 'Every line on GitHub, forever',                 us: true, them: false, dot: 'bg-accent-pink'     },
];

// Use cases
const useCases = [
  {
    title: 'Consultants',
    description: 'Structure your thinking before the deck. SWOT, BCG Matrix, Porter\'s Five Forces — built for the boardroom.',
    iconSvg: `<svg viewBox="0 0 24 24" fill="none" stroke="#4824DE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>`
  },
  {
    title: 'Analysts',
    description: 'Turn raw data into a story. Scatterplots, heatmaps, waterfall charts — make the numbers land.',
    iconSvg: `<svg viewBox="0 0 24 24" fill="none" stroke="#4824DE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line><line x1="2" y1="20" x2="22" y2="20"></line></svg>`
  },
  {
    title: 'Product & Design Teams',
    description: 'Roadmaps. User flows. Journey maps. Stop explaining. Start showing.',
    iconSvg: `<svg viewBox="0 0 24 24" fill="none" stroke="#4824DE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg>`
  }
];

---

<Layout
  title="Illustrate Words — AI Prompt Builder for Visuals"
  description="Pick a visual type, choose a style, copy the prompt. Works with ChatGPT, Claude, Gemini, Midjourney. Free, no login, no catch."
>

  <!-- ============================================================ -->
  <!-- 1. HERO SECTION                                              -->
  <!-- ============================================================ -->
  <section class="relative bg-cream-lightest pt-8 pb-20 md:pb-32 overflow-hidden">

    <!-- Decorative scattered dots -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-32 left-8 md:left-32 w-3 h-3 rounded-full bg-accent-lavender animate-float"></div>
      <div class="absolute top-48 right-12 md:right-48 w-4 h-4 rounded-full bg-accent-lime animate-float delay-200"></div>
      <div class="absolute bottom-24 left-1/4 w-2.5 h-2.5 rounded-full bg-accent-pink animate-float delay-300"></div>
      <div class="absolute top-1/3 right-1/3 w-2 h-2 rounded-full bg-accent-orange animate-float delay-400"></div>
    </div>

    <div class="container-page relative">

      <!-- Pre-headline pill -->
      <div class="flex justify-center pt-8 md:pt-12">
        <span class="pill">
          <span class="w-2 h-2 rounded-full bg-accent-lime mr-2"></span>
          Free. Forever. No login. No catch.
        </span>
      </div>

      <!-- Main headline -->
      <h1 class="text-center mt-8 headline-display max-w-5xl mx-auto">
        Your idea deserves<br />
        to be <em>seen</em>.
      </h1>

      <!-- Subheadline -->
      <p class="text-center mt-8 text-lead text-ink-secondary max-w-headline mx-auto">
        Pick a visual. Pick a style. Copy the prompt.<br />
        Paste it into ChatGPT, Claude, or Midjourney. Done.<br />
        No account. No tutorial. No waiting.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/generate" class="btn-primary text-base">
          Start Building
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/gallery" class="btn-secondary text-base">
          See Examples
        </a>
      </div>

      <!-- Trust microcopy with squiggle -->
      <div class="mt-8 flex flex-col items-center gap-2">
        <Squiggle color="#4824DE" width="100" />
        <p class="text-sm text-ink-secondary text-center font-medium">
          Used by consultants, creators, founders, and anyone who thinks in visuals.
        </p>
      </div>

      <!-- Hero visual: your words on the left, the diagram drawing itself on the right -->
      <div class="mt-16 md:mt-20 relative max-w-5xl mx-auto">

        <div class="relative bg-cream-lightest rounded-[24px] border-2 border-ink-primary shadow-hard overflow-hidden">

          <!-- Browser bar -->
          <div class="flex items-center gap-3 px-5 py-3 bg-forest border-b-2 border-ink-primary">
            <div class="flex gap-1.5 flex-shrink-0">
              <span class="w-3 h-3 rounded-full bg-[#FF5F56]"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
              <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
            </div>
            <div class="flex-1 max-w-md mx-auto bg-forest-light border border-white/10 rounded-md text-[11px] text-ink-on-dark-muted py-1 px-4 text-center select-none font-mono tracking-tight truncate">
              illustratewords.com/generate
            </div>
            <span class="hidden sm:inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-accent-lime flex-shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-lime animate-pulse"></span>
              Live demo
            </span>
          </div>

          <!-- Split: words → visual -->
          <div class="grid grid-cols-1 md:grid-cols-[5fr_auto_7fr] items-stretch">

            <!-- Left: your words -->
            <div class="p-6 md:p-8 flex flex-col justify-center gap-5 text-left">
              <span class="text-eyebrow text-ink-tertiary">Your words</span>
              <div class="bg-white border-1.5 border-ink-primary/15 rounded-2xl p-4 md:p-5 min-h-[92px]">
                <p class="font-serif text-lg md:text-xl text-ink-primary leading-snug">
                  <span id="hero-typed"></span><span class="hero-caret" aria-hidden="true"></span>
                </p>
              </div>

              <div>
                <p class="text-xs text-ink-tertiary font-medium mb-2">Your picks</p>
                <!-- Scene 1 chips -->
                <div class="hero-chip-row flex flex-wrap gap-2">
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <span class="w-2 h-2 rounded-full bg-accent-lavender"></span>Mindmap
                  </span>
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <span class="flex -space-x-0.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-[#DED6FF] border border-ink-primary/30"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#8C6FF0] border border-ink-primary/30"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#4824DE] border border-ink-primary/30"></span>
                    </span>Lavender Fields
                  </span>
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 15 C 8 15, 12 5, 17 5"/></svg>Curved
                  </span>
                </div>
                <!-- Scene 2 chips -->
                <div class="hero-chip-row hidden flex-wrap gap-2">
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <span class="w-2 h-2 rounded-full bg-forest"></span>Flowchart
                  </span>
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <span class="flex -space-x-0.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-[#E8F5E9] border border-ink-primary/30"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#81C784] border border-ink-primary/30"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#2E7D32] border border-ink-primary/30"></span>
                    </span>Forest Sage
                  </span>
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 15 V 8 Q 3 5 6 5 H 17"/></svg>Rounded
                  </span>
                </div>
                <!-- Scene 3 chips -->
                <div class="hero-chip-row hidden flex-wrap gap-2">
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <span class="w-2 h-2 rounded-full bg-accent-orange"></span>Bar Chart
                  </span>
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <span class="flex -space-x-0.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-[#FFE0D1] border border-ink-primary/30"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#F0956A] border border-ink-primary/30"></span>
                      <span class="w-2.5 h-2.5 rounded-full bg-[#E85A28] border border-ink-primary/30"></span>
                    </span>Sunset Coral
                  </span>
                  <span class="hero-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border-1.5 border-ink-primary bg-white text-xs font-semibold text-ink-primary shadow-hard-sm opacity-0 translate-y-1">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 10 H 17"/></svg>Minimal
                  </span>
                </div>
              </div>
            </div>

            <!-- Divider: the prompt hand-off (desktop) -->
            <div class="hidden md:flex flex-col items-center justify-center relative w-16">
              <div class="absolute inset-y-8 left-1/2 -translate-x-1/2 border-l-2 border-dashed border-ink-primary/15"></div>
              <span class="relative z-10 w-11 h-11 rounded-full bg-accent-lavender text-white border-2 border-ink-primary shadow-hard-sm flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
              <span class="relative z-10 mt-2 text-[10px] font-bold uppercase tracking-widest text-ink-tertiary">prompt</span>
            </div>
            <!-- Divider (mobile) -->
            <div class="md:hidden flex items-center gap-3 px-6 -my-1">
              <div class="flex-1 border-t-2 border-dashed border-ink-primary/15"></div>
              <span class="w-9 h-9 rounded-full bg-accent-lavender text-white border-2 border-ink-primary shadow-hard-sm flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M6 13l6 6 6-6"/></svg>
              </span>
              <div class="flex-1 border-t-2 border-dashed border-ink-primary/15"></div>
            </div>

            <!-- Right: the visual, drawing itself -->
            <div class="relative hero-stage m-5 md:ml-0 rounded-2xl border-1.5 border-ink-primary/15 min-h-[300px] md:min-h-[360px] overflow-hidden">
              <span class="absolute top-3.5 left-4 z-10 text-eyebrow text-ink-tertiary">The visual</span>

              <!-- Scene 1: Mindmap (lavender) -->
              <div class="hero-scene scene-active" aria-hidden="true">
                <svg viewBox="0 0 480 340" class="w-full h-full" font-family="Figtree, system-ui, sans-serif">
                  <path class="draw" pathLength="100" d="M 220 148 C 200 115, 160 90, 122 82" fill="none" stroke="#4824DE" stroke-width="2" style="--d:.1s"/>
                  <path class="draw" pathLength="100" d="M 268 148 C 290 115, 330 88, 360 74" fill="none" stroke="#4824DE" stroke-width="2" style="--d:.2s"/>
                  <path class="draw" pathLength="100" d="M 214 192 C 190 220, 150 240, 118 252" fill="none" stroke="#4824DE" stroke-width="2" style="--d:.3s"/>
                  <path class="draw" pathLength="100" d="M 268 192 C 292 218, 330 236, 356 248" fill="none" stroke="#4824DE" stroke-width="2" style="--d:.4s"/>
                  <path class="draw" pathLength="100" d="M 240 194 C 240 220, 240 245, 240 270" fill="none" stroke="#4824DE" stroke-width="2" style="--d:.5s"/>
                  <g class="pop" style="--d:0s">
                    <rect x="176" y="147" width="128" height="46" rx="23" fill="#DED6FF" stroke="#0A0A0A" stroke-width="1.5"/>
                    <text x="240" y="176" text-anchor="middle" font-size="14" font-weight="700" fill="#0A0A0A">Coffee Shop</text>
                  </g>
                  <g class="pop" style="--d:.45s">
                    <rect x="74" y="52" width="96" height="34" rx="17" fill="#FFFFFF" stroke="#4824DE" stroke-width="1.5"/>
                    <text x="122" y="74" text-anchor="middle" font-size="12" font-weight="600" fill="#0A0A0A">Brand</text>
                  </g>
                  <g class="pop" style="--d:.55s">
                    <rect x="316" y="44" width="96" height="34" rx="17" fill="#FFFFFF" stroke="#4824DE" stroke-width="1.5"/>
                    <text x="364" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#0A0A0A">Menu</text>
                  </g>
                  <g class="pop" style="--d:.65s">
                    <rect x="70" y="244" width="96" height="34" rx="17" fill="#FFFFFF" stroke="#4824DE" stroke-width="1.5"/>
                    <text x="118" y="266" text-anchor="middle" font-size="12" font-weight="600" fill="#0A0A0A">Location</text>
                  </g>
                  <g class="pop" style="--d:.75s">
                    <rect x="312" y="240" width="104" height="34" rx="17" fill="#FFFFFF" stroke="#4824DE" stroke-width="1.5"/>
                    <text x="364" y="262" text-anchor="middle" font-size="12" font-weight="600" fill="#0A0A0A">Marketing</text>
                  </g>
                  <g class="pop" style="--d:.85s">
                    <rect x="192" y="272" width="96" height="34" rx="17" fill="#FFFFFF" stroke="#4824DE" stroke-width="1.5"/>
                    <text x="240" y="294" text-anchor="middle" font-size="12" font-weight="600" fill="#0A0A0A">Budget</text>
                  </g>
                </svg>
              </div>

              <!-- Scene 2: Flowchart (forest + lime) -->
              <div class="hero-scene" aria-hidden="true">
                <svg viewBox="0 0 480 340" class="w-full h-full" font-family="Figtree, system-ui, sans-serif">
                  <g class="pop" style="--d:0s">
                    <rect x="26" y="96" width="104" height="46" rx="10" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="1.5"/>
                    <text x="78" y="124" text-anchor="middle" font-size="13" font-weight="600" fill="#0A0A0A">Sign up</text>
                  </g>
                  <path class="draw" pathLength="100" d="M 130 119 L 192 119" fill="none" stroke="#1A2820" stroke-width="2" style="--d:.15s"/>
                  <polygon class="pop" points="192,113 204,119 192,125" fill="#1A2820" style="--d:.28s"/>
                  <g class="pop" style="--d:.3s">
                    <rect x="204" y="96" width="104" height="46" rx="10" fill="#E0EE6A" stroke="#0A0A0A" stroke-width="1.5"/>
                    <text x="256" y="124" text-anchor="middle" font-size="13" font-weight="600" fill="#0A0A0A">Verify email</text>
                  </g>
                  <path class="draw" pathLength="100" d="M 308 119 L 364 119" fill="none" stroke="#1A2820" stroke-width="2" style="--d:.45s"/>
                  <polygon class="pop" points="364,113 376,119 364,125" fill="#1A2820" style="--d:.58s"/>
                  <g class="pop" style="--d:.6s">
                    <polygon points="416,87 456,119 416,151 376,119" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="1.5"/>
                    <text x="416" y="123" text-anchor="middle" font-size="12" font-weight="600" fill="#0A0A0A">Data in?</text>
                  </g>
                  <path class="draw" pathLength="100" d="M 416 151 L 416 210" fill="none" stroke="#1A2820" stroke-width="2" style="--d:.75s"/>
                  <polygon class="pop" points="410,210 416,222 422,210" fill="#1A2820" style="--d:.88s"/>
                  <text class="pop" x="428" y="185" font-size="11" font-weight="600" fill="#4A4642" style="--d:.8s">yes</text>
                  <g class="pop" style="--d:.9s">
                    <rect x="364" y="222" width="104" height="46" rx="10" fill="#1A2820" stroke="#0A0A0A" stroke-width="1.5"/>
                    <text x="416" y="250" text-anchor="middle" font-size="13" font-weight="600" fill="#F5EFE0">Success</text>
                  </g>
                  <path class="draw" pathLength="100" d="M 376 119 C 320 140, 290 180, 282 222" fill="none" stroke="#1A2820" stroke-width="1.5" stroke-dasharray="5 4" style="--d:1.05s"/>
                  <text class="pop" x="316" y="168" font-size="11" font-weight="600" fill="#4A4642" style="--d:1.1s">no</text>
                  <g class="pop" style="--d:1.2s">
                    <rect x="232" y="222" width="100" height="44" rx="10" fill="#FFFFFF" stroke="#7A7468" stroke-width="1.5" stroke-dasharray="5 4"/>
                    <text x="282" y="249" text-anchor="middle" font-size="12" font-weight="600" fill="#4A4642">Send nudge</text>
                  </g>
                </svg>
              </div>

              <!-- Scene 3: Bar chart (sunset accents) -->
              <div class="hero-scene" aria-hidden="true">
                <svg viewBox="0 0 480 340" class="w-full h-full" font-family="Figtree, system-ui, sans-serif">
                  <path class="draw" pathLength="100" d="M 64 36 L 64 276 L 444 276" fill="none" stroke="#0A0A0A" stroke-width="2" style="--d:0s"/>
                  <path class="draw" pathLength="100" d="M 64 196 L 444 196" fill="none" stroke="#0A0A0A" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="4 5" style="--d:.2s"/>
                  <path class="draw" pathLength="100" d="M 64 116 L 444 116" fill="none" stroke="#0A0A0A" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="4 5" style="--d:.25s"/>
                  <rect class="grow" x="96" y="166" width="52" height="110" rx="6" fill="#8CC8EE" stroke="#0A0A0A" stroke-width="1.5" style="--d:.3s"/>
                  <rect class="grow" x="166" y="126" width="52" height="150" rx="6" fill="#E85A28" stroke="#0A0A0A" stroke-width="1.5" style="--d:.42s"/>
                  <rect class="grow" x="236" y="186" width="52" height="90" rx="6" fill="#C8DC2E" stroke="#0A0A0A" stroke-width="1.5" style="--d:.54s"/>
                  <rect class="grow" x="306" y="86" width="52" height="190" rx="6" fill="#4824DE" stroke="#0A0A0A" stroke-width="1.5" style="--d:.66s"/>
                  <rect class="grow" x="376" y="136" width="52" height="140" rx="6" fill="#EF8CBD" stroke="#0A0A0A" stroke-width="1.5" style="--d:.78s"/>
                  <text class="pop" x="122" y="156" text-anchor="middle" font-size="12" font-weight="700" fill="#0A0A0A" style="--d:.9s">12k</text>
                  <text class="pop" x="192" y="116" text-anchor="middle" font-size="12" font-weight="700" fill="#0A0A0A" style="--d:1s">18k</text>
                  <text class="pop" x="262" y="176" text-anchor="middle" font-size="12" font-weight="700" fill="#0A0A0A" style="--d:1.1s">9k</text>
                  <text class="pop" x="332" y="76" text-anchor="middle" font-size="12" font-weight="700" fill="#0A0A0A" style="--d:1.2s">24k</text>
                  <text class="pop" x="402" y="126" text-anchor="middle" font-size="12" font-weight="700" fill="#0A0A0A" style="--d:1.3s">16k</text>
                  <text x="122" y="296" text-anchor="middle" font-size="11" font-weight="600" fill="#7A7468">Core</text>
                  <text x="192" y="296" text-anchor="middle" font-size="11" font-weight="600" fill="#7A7468">Pro</text>
                  <text x="262" y="296" text-anchor="middle" font-size="11" font-weight="600" fill="#7A7468">Add-on</text>
                  <text x="332" y="296" text-anchor="middle" font-size="11" font-weight="600" fill="#7A7468">Teams</text>
                  <text x="402" y="296" text-anchor="middle" font-size="11" font-weight="600" fill="#7A7468">API</text>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating accents -->
        <div class="hidden lg:flex absolute -top-8 -right-6 rotate-3 z-20 items-center gap-2.5 bg-white border-2 border-ink-primary rounded-2xl shadow-hard px-4 py-3">
          <span class="flex -space-x-1">
            <span class="w-5 h-5 rounded-full bg-[#4824DE] border-2 border-white"></span>
