---
import Layout from '../layouts/Layout.astro';
import Squiggle from '../components/Squiggle.astro';
import StepFlow from '../components/StepFlow.astro';
import LandingWalkthrough from '../components/LandingWalkthrough.astro';
import { CATEGORIES } from '../data/visualizations.js';
import VisualizationMarquee from '../components/VisualizationMarquee.astro';

// Comparison data
const comparison = [
  { feature: 'Free forever, no subscription', us: true, them: false },
  { feature: 'No account or login required', us: true, them: false },
  { feature: 'Works with any AI tool', us: true, them: false },
  { feature: '60+ visualization types', us: true, them: true },
  { feature: '25 curated color palettes', us: true, them: false },
  { feature: 'Custom style options', us: true, them: false },
  { feature: 'Open source code', us: true, them: false },
];

// Use cases
const useCases = [
  {
    title: 'Consultants & Advisory',
    description: 'Design MECE Issue Trees, Strategy Alignment Frameworks, and BCG Growth Matrices to structure complex client recommendations.',
    iconSvg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><rect x="3" y="16" width="8" height="8" rx="1.5"/><rect x="20" y="5" width="8" height="8" rx="1.5"/><rect x="20" y="27" width="8" height="8" rx="1.5"/><path d="M11 20 h 5 v -11 h 4 M16 20 v 11 h 4"/></svg>`,
    bg: 'bg-accent-lavender',
    rotate: '-rotate-2',
  },
  {
    title: 'Analysts & Researchers',
    description: 'Map Trend Scatterplots, Venn Overlaps, and 2x2 Prioritization Grids to synthesize findings for executive summaries.',
    iconSvg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><line x1="6" y1="34" x2="34" y2="34"/><line x1="6" y1="6" x2="6" y2="34"/><circle cx="13" cy="27" r="1.5" fill="currentColor"/><circle cx="19" cy="19" r="1.5" fill="currentColor"/><circle cx="25" cy="23" r="1.5" fill="currentColor"/><circle cx="31" cy="11" r="1.5" fill="currentColor"/><line x1="8" y1="29" x2="32" y2="9" stroke-dasharray="3 3"/></svg>`,
    bg: 'bg-accent-lime',
    rotate: 'rotate-1',
  },
  {
    title: 'Designers & Product Teams',
    description: 'Layout User Flow Charts, Wireframe Grid Schemas, and Agile Roadmap Timelines to orchestrate feature delivery.',
    iconSvg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M6 20 q 7 -10, 14 0 t 14 0" stroke-dasharray="2.5 2.5"/><circle cx="6" cy="20" r="3" fill="currentColor"/><circle cx="20" cy="20" r="3" fill="currentColor"/><circle cx="34" cy="20" r="3" fill="currentColor"/><path d="M6 24 v 4 M20 24 v 4 M34 24 v 4"/></svg>`,
    bg: 'bg-accent-pink',
    rotate: '-rotate-1',
  },
];

// Steps
const steps = [
  {
    number: '01',
    title: 'Pick your visualization',
    description: 'Choose from 13 categories and 60+ chart types — from mindmaps to SWOT analyses, every visual format Napkin AI offers.',
    accent: 'bg-accent-lavender',
  },
  {
    number: '02',
    title: 'Choose your style',
    description: 'Select a color palette from 25 curated combinations, then pick connector style, icon style, and layout mood.',
    accent: 'bg-accent-lime',
  },
  {
    number: '03',
    title: 'Copy your prompt',
    description: 'Get a detailed, AI-ready prompt. Paste it into Gemini, ChatGPT, Claude, or Midjourney and get your visualization.',
    accent: 'bg-accent-pink',
  },
];
---

<Layout
  title="Illustrate Words — Free AI Prompt Builder for Stunning Visuals"
  description="Turn any idea into a stunning visualization. Pick a type, palette, and style; get a copy-paste AI prompt. Free, no login, runs in your browser."
>

  <!-- ============================================================ -->
  <!-- 1. HERO SECTION                                              -->
  <!-- ============================================================ -->
  <section class="relative bg-cream-lightest pt-8 pb-20 md:pb-32 overflow-hidden">

    <!-- Decorative scattered dots -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-32 left-8 md:left-32 w-3 h-3 rounded-full bg-accent-lavender animate-float"></div>
      <div class="absolute top-48 right-12 md:right-48 w-4 h-4 rounded-full bg-accent-lime animate-float delay-200"></div>
      <div class="absolute bottom-24 left-1/4 w-2.5 h-2.5 rounded-full bg-accent-pink animate-float delay-300"></div>
      <div class="absolute top-1/3 right-1/3 w-2 h-2 rounded-full bg-accent-orange animate-float delay-400"></div>
    </div>

    <div class="container-page relative">

      <!-- Pre-headline pill -->
      <div class="flex justify-center pt-8 md:pt-12">
        <span class="pill">
          <span class="w-2 h-2 rounded-full bg-accent-lime mr-2"></span>
          Free forever. No login required.
        </span>
      </div>

      <!-- Main headline -->
      <h1 class="text-center mt-8 headline-display max-w-5xl mx-auto">
        Turn any idea<br />
        into a <em>stunning</em><br />
        visualization.
      </h1>

      <!-- Subheadline -->
      <p class="text-center mt-8 text-lead text-ink-secondary max-w-headline mx-auto">
        Choose your chart type, pick your colors, and get an AI-ready prompt
        in seconds. Works with Gemini, ChatGPT, Claude, and Midjourney.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/generate" class="btn-primary text-base">
          Start Generating
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/gallery" class="btn-secondary text-base">
          See Examples
        </a>
      </div>

      <!-- Trust microcopy with squiggle -->
      <div class="mt-8 flex flex-col items-center gap-2">
        <Squiggle color="#4824DE" width="100" />
        <p class="text-sm text-ink-secondary text-center font-medium">
          Built for designers, consultants, analysts, and product teams
        </p>
      </div>

      <!-- Hero visual mockup (Interactive Agent Simulator) -->
      <div class="mt-16 md:mt-20 relative max-w-4xl mx-auto">

        <!-- Browser Mockup Window -->
        <div class="bg-cream-lighter rounded-card border border-cream-darker shadow-card overflow-hidden flex flex-col relative transition-all duration-300">
          
          <!-- Window Header (Browser Bar) -->
          <div class="bg-cream-darker border-b border-cream-darker px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F56] border border-ink-primary/20"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-ink-primary/20"></span>
              <span class="w-3 h-3 rounded-full bg-[#27C93F] border border-ink-primary/20"></span>
            </div>
            <div class="bg-cream-lighter border border-ink-primary/20 rounded px-4 py-0.5 text-xs text-ink-secondary font-mono flex items-center gap-1">
              <svg class="w-3 h-3 text-ink-tertiary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              illustratewords.com/generate
            </div>
            <div class="w-12"></div>
          </div>

          <!-- Window Content -->
          <div class="p-6 md:p-10 relative min-h-[380px] bg-cream-lighter flex flex-col justify-between">
            
            <!-- Simulated Step Contents -->
            <div id="sim-step-1" class="sim-view grid grid-cols-1 sm:grid-cols-3 gap-4 transition-all duration-300">
              <!-- Grid item 1 (Selected) -->
              <div id="sim-card-mindmap" class="bg-cream rounded-card-sm border border-cream-darker p-5 transition-all shadow-sm">
                <div class="flex items-center justify-between mb-3">
                  <span class="font-serif text-2xl">01</span>
                  <div class="sim-check w-5 h-5 rounded-full border border-ink-primary flex items-center justify-center text-[10px] bg-accent-lavender text-ink-primary opacity-0 transition-opacity">✓</div>
                </div>
                <div class="text-ink-primary w-10 h-10 mb-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><circle cx="12" cy="12" r="3"/><path d="M12 9V4M12 15v5M9 12H4M15 12h5"/></svg>
                </div>
                <p class="font-medium text-sm">Mindmap</p>
                <p class="text-[11px] text-ink-secondary mt-1">Radial idea structure</p>
              </div>

              <!-- Grid item 2 -->
              <div class="bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5">
                <div class="flex items-center justify-between mb-3">
                  <span class="font-serif text-2xl text-ink-tertiary">02</span>
                </div>
                <div class="text-ink-tertiary w-10 h-10 mb-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><rect x="3" y="5" width="6" height="6" rx="1"/><rect x="15" y="5" width="6" height="6" rx="1"/><path d="M9 8h6M12 5l3 3-3 3"/></svg>
                </div>
                <p class="font-medium text-sm">Flowchart</p>
                <p class="text-[11px] text-ink-secondary mt-1">Sequential workflow</p>
              </div>

              <!-- Grid item 3 -->
              <div class="bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5">
                <div class="flex items-center justify-between mb-3">
                  <span class="font-serif text-2xl text-ink-tertiary">03</span>
                </div>
                <div class="text-ink-tertiary w-10 h-10 mb-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                </div>
                <p class="font-medium text-sm">Scatterplot</p>
                <p class="text-[11px] text-ink-secondary mt-1">Data correlations</p>
              </div>
            </div>

            <!-- Simulated Step 2 Contents (Hidden initially) -->
            <div id="sim-step-2" class="sim-view hidden grid grid-cols-1 sm:grid-cols-3 gap-4 transition-all duration-300">
              <!-- Palette 1 -->
              <div class="bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5">
                <p class="font-medium text-sm">Steel Storm</p>
                <div class="flex gap-1 mt-2">
                  <div class="w-4 h-4 rounded bg-[#ECEFF1]"></div>
                  <div class="w-4 h-4 rounded bg-[#CFD8DC]"></div>
                  <div class="w-4 h-4 rounded bg-[#90A4AE]"></div>
                </div>
              </div>

              <!-- Palette 2 (Selected) -->
              <div id="sim-card-palette" class="bg-cream rounded-card-sm border border-cream-darker p-5 transition-all shadow-sm">
                <div class="flex justify-between items-center mb-1">
                  <p class="font-medium text-sm">Midnight Purple</p>
                  <div class="sim-check w-5 h-5 rounded-full border border-ink-primary flex items-center justify-center text-[10px] bg-accent-lavender text-ink-primary opacity-0 transition-opacity">✓</div>
                </div>
                <div class="flex gap-1 mt-2">
                  <div class="w-4 h-4 rounded bg-[#F3E5F5]"></div>
                  <div class="w-4 h-4 rounded bg-[#BA68C8]"></div>
                  <div class="w-4 h-4 rounded bg-[#7B1FA2]"></div>
                  <div class="w-4 h-4 rounded bg-[#4A148C]"></div>
                </div>
              </div>

              <!-- Palette 3 -->
              <div class="bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5">
                <p class="font-medium text-sm">Sage Linen</p>
                <div class="flex gap-1 mt-2">
                  <div class="w-4 h-4 rounded bg-[#E8F5E9]"></div>
                  <div class="w-4 h-4 rounded bg-[#81C784]"></div>
                  <div class="w-4 h-4 rounded bg-[#2E7D32]"></div>
                </div>
              </div>
            </div>

            <!-- Simulated Step 3 Contents (Hidden initially) -->
            <div id="sim-step-3" class="sim-view hidden grid grid-cols-1 sm:grid-cols-3 gap-4 transition-all duration-300">
              <!-- Style 1 (Selected) -->
              <div id="sim-card-connector" class="bg-cream rounded-card-sm border border-cream-darker p-5 transition-all shadow-sm">
                <div class="flex justify-between items-center mb-1">
                  <p class="font-medium text-sm">Curved</p>
                  <div class="sim-check w-5 h-5 rounded-full border border-ink-primary flex items-center justify-center text-[10px] bg-accent-lavender text-ink-primary opacity-0 transition-opacity">✓</div>
                </div>
                <div class="w-12 h-6 mt-2 text-ink-primary">
                  <svg viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 30 C 25 30, 35 10, 50 10"/></svg>
                </div>
              </div>

              <!-- Style 2 -->
              <div class="bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5">
                <p class="font-medium text-sm">Straight</p>
                <div class="w-12 h-6 mt-2 text-ink-tertiary">
                  <svg viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="10" y1="30" x2="50" y2="10"/></svg>
                </div>
              </div>

              <!-- Style 3 -->
              <div class="bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5">
                <p class="font-medium text-sm">Rounded</p>
                <div class="w-12 h-6 mt-2 text-ink-tertiary">
                  <svg viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 30 V 10 H 50"/></svg>
                </div>
              </div>
            </div>

            <!-- Simulated Step 4 Contents (Hidden initially) -->
            <div id="sim-step-4" class="sim-view hidden w-full transition-all duration-300">
              <div class="bg-ink-primary text-cream rounded-card-sm border border-ink-primary/10 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs uppercase font-medium tracking-wider opacity-70">Your AI-Ready Prompt</span>
                  <span class="text-[10px] bg-accent-lavender text-ink-primary px-2 py-0.5 rounded">Napkin AI Vector style</span>
                </div>
                <div class="bg-forest-light text-cream-lighter rounded-md p-4 text-xs leading-relaxed font-mono select-none overflow-hidden h-24 relative">
                  Create a professional central node mindmap... COLOR PALETTE: Midnight Purple (#F3E5F5, #BA68C8, #7B1FA2, #4A148C). Outline weight: 1.5px. Style: curved lines...
                  <div class="absolute inset-0 bg-gradient-to-t from-forest-light via-transparent to-transparent"></div>
                </div>
                <button id="sim-copy-btn" class="mt-4 w-full bg-accent-lavender text-cream border border-accent-lavender/10 py-3 rounded-full text-sm font-semibold transition-all shadow-btn flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                  <span>Copy Prompt</span>
                </button>
              </div>
            </div>

            <!-- Simulation Footer Status Bar -->
            <div class="mt-6 pt-4 border-t border-ink-primary/10 flex items-center justify-between text-xs text-ink-secondary">
              <span id="sim-status-text">Step 1: Pick a visualization</span>
              <div class="flex gap-1.5">
                <span id="sim-dot-1" class="w-2.5 h-2.5 rounded-full bg-accent-lavender border border-ink-primary/20"></span>
                <span id="sim-dot-2" class="w-2.5 h-2.5 rounded-full bg-cream-darker border border-ink-primary/20"></span>
                <span id="sim-dot-3" class="w-2.5 h-2.5 rounded-full bg-cream-darker border border-ink-primary/20"></span>
                <span id="sim-dot-4" class="w-2.5 h-2.5 rounded-full bg-cream-darker border border-ink-primary/20"></span>
              </div>
            </div>

            <!-- Simulated Mouse Cursor -->
            <div id="sim-cursor" class="absolute pointer-events-none w-6 h-6 z-50 transition-all duration-700 ease-in-out transform scale-100" style="top: 80%; left: 50%;">
              <svg viewBox="0 0 24 24" class="w-full h-full text-ink-primary drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]" fill="currentColor" stroke="white" stroke-width="1.5">
                <path d="M3 3l7.07 16.97 2.51-6.9 6.9-2.51L3 3z"/>
              </svg>
            </div>

            <!-- Floating Simulated Toast Notification -->
            <div id="sim-toast" class="absolute left-1/2 -translate-x-1/2 bottom-20 bg-ink-primary text-cream px-4 py-2.5 rounded-full border border-cream/20 text-xs font-medium shadow-hard opacity-0 transform translate-y-4 transition-all duration-300 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent-lime" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Prompt copied to clipboard!
            </div>

          </div>
        </div>

        <!-- Decorative squiggle -->
        <div class="absolute -top-6 -right-6 hidden md:block transform rotate-12">
          <Squiggle color="#F26835" width="80" rotate="20deg" />
        </div>
      </div>

    </div>
  </section>

  <section class="bg-cream py-12 md:py-16 border-y border-border-light relative overflow-hidden">
    <div class="container-page">
      <p class="text-center text-eyebrow text-ink-quaternary mb-8 text-balance">
        Trusted by creators, strategists, and thinkers everywhere
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6 mask-fade-x">
        <span class="px-5 py-2.5 rounded-full border border-border-medium bg-cream-lightest text-ink-secondary font-sans text-sm font-semibold shadow-card-soft opacity-60 hover:opacity-100 transition-opacity duration-200 cursor-default">Gemini</span>
        <span class="px-5 py-2.5 rounded-full border border-border-medium bg-cream-lightest text-ink-secondary font-sans text-sm font-semibold shadow-card-soft opacity-60 hover:opacity-100 transition-opacity duration-200 cursor-default">ChatGPT</span>
        <span class="px-5 py-2.5 rounded-full border border-border-medium bg-cream-lightest text-ink-secondary font-sans text-sm font-semibold shadow-card-soft opacity-60 hover:opacity-100 transition-opacity duration-200 cursor-default">Claude</span>
        <span class="px-5 py-2.5 rounded-full border border-border-medium bg-cream-lightest text-ink-secondary font-sans text-sm font-semibold shadow-card-soft opacity-60 hover:opacity-100 transition-opacity duration-200 cursor-default">Midjourney</span>
        <span class="px-5 py-2.5 rounded-full border border-border-medium bg-cream-lightest text-ink-secondary font-sans text-sm font-semibold shadow-card-soft opacity-60 hover:opacity-100 transition-opacity duration-200 cursor-default">DALL·E</span>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3. HOW IT WORKS — Dark forest section                        -->
  <!-- ============================================================ -->
  <section class="section bg-forest text-ink-on-dark relative overflow-hidden">

    <div class="container-page relative">

      <!-- Section header -->
      <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
        <span class="pill-on-dark mb-6">
          How it works
        </span>
        <h2 class="headline-h1 text-white">
          From idea to <em>visualization</em><br />
          in three steps.
        </h2>
        <p class="mt-6 text-lead text-ink-on-dark-muted max-w-2xl mx-auto">
          No subscriptions. No learning curve. No magic — just clear prompts that any AI tool can turn into a beautiful visual.
        </p>
      </div>

      <!-- Animated Step Flow -->
      <div class="mt-16 md:mt-24">
        <LandingWalkthrough />
      </div>

    </div>
  </section>

  <section class="section bg-cream relative overflow-hidden pb-0">

    <!-- Decorative squiggles -->
    <div class="absolute top-32 right-8 opacity-50 hidden md:block">
      <Squiggle color="#4824DE" width="150" rotate="-12deg" />
    </div>

    <div class="container-page relative">

      <!-- Section header -->
      <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
        <span class="pill-lime mb-6">
          76 templates
        </span>
        <h2 class="headline-h1">
          Every type of visualization, <em>covered</em>.
        </h2>
        <p class="mt-6 text-lead text-ink-secondary max-w-2xl mx-auto">
          From mindmaps to SWOT analyses, business model canvases to Gantt charts.
          76 visualization types across 13 categories — completely free.
        </p>
      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 4.5. THE FULL RANGE SHOWCASE (MARQUEE)                        -->
  <!-- ============================================================ -->
  <VisualizationMarquee variant="compact" heading={false} tone="cream" />

  <!-- ============================================================ -->
  <!-- 5. COMPARISON — Illustrate Words vs Napkin AI                -->
  <!-- ============================================================ -->
  <section class="section bg-cream-darker text-ink-primary relative overflow-hidden">

    <div class="container-page relative">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
        <span class="pill-lavender mb-6">
          The difference
        </span>
        <h2 class="headline-h1 text-ink-primary">
          Why <em>Illustrate Words</em>?
        </h2>
        <p class="mt-6 text-lead text-ink-secondary max-w-2xl mx-auto">
          We do one thing — generate AI prompts — and we do it without subscriptions, accounts, or lock-in.
        </p>
      </div>

      <!-- Comparison table -->
      <div class="mt-16 max-w-4xl mx-auto bg-cream border-2 border-ink-primary rounded-3xl shadow-hard overflow-hidden">

        <!-- Header row (Dark Forest Theme) -->
        <div class="grid grid-cols-12 gap-4 py-6 px-8 bg-forest text-cream-lightest items-center border-b-2 border-ink-primary">
          <div class="col-span-6 font-serif text-lg font-medium">Feature comparison</div>
          <div class="col-span-3 text-center">
            <div class="inline-flex items-center gap-1.5 px-4 py-2 bg-accent-lavender text-white rounded-full border border-white/20 font-sans text-sm font-semibold shadow-[0_2px_8px_rgba(72,36,222,0.3)]">
              <span class="w-2 h-2 rounded-full bg-accent-lime animate-pulse"></span>
              Illustrate Words
            </div>
          </div>
          <div class="col-span-3 text-center">
            <div class="inline-flex items-center gap-1.5 px-4 py-2 bg-white/10 text-cream-lightest/80 rounded-full border border-white/10 font-sans text-sm font-medium">
              Napkin AI
            </div>
          </div>
        </div>

        <!-- Comparison rows -->
        <div class="divide-y divide-ink-primary/10">
          {comparison.map((row, idx) => (
            <div class:list={[
              'grid grid-cols-12 gap-4 py-5 px-8 items-center hover:bg-cream-darker/35 transition-colors duration-150',
              idx % 2 === 0 ? 'bg-cream-lightest/50' : 'bg-cream'
            ]}>
              <!-- Feature Name -->
              <div class="col-span-6 font-medium text-ink-primary flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-ink-primary/30"></span>
                {row.feature}
              </div>
              
              <!-- Illustrate Words Column (Highlight Column) -->
              <div class="col-span-3 text-center flex justify-center py-1 bg-accent-lavender/5 rounded-xl border border-accent-lavender/10">
                {row.us ? (
                  <span class="inline-flex items-center justify-center w-8 h-8 bg-accent-lavender text-white rounded-full shadow-[0_2px_6px_rgba(72,36,222,0.3)]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                ) : (
                  <span class="inline-flex items-center justify-center w-8 h-8 bg-ink-primary/10 text-ink-quaternary rounded-full">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </span>
                )}
              </div>

              <!-- Napkin AI Column -->
              <div class="col-span-3 text-center flex justify-center">
                {row.them ? (
                  <span class="inline-flex items-center justify-center w-8 h-8 bg-white text-ink-primary rounded-full border border-ink-primary/20 shadow-sm">
                    <svg class="w-4 h-4 text-forest" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                ) : (
                  <span class="inline-flex items-center justify-center w-8 h-8 bg-ink-primary/5 text-ink-quaternary rounded-full">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 6. USE CASES                                                 -->
  <!-- ============================================================ -->
  <section class="section bg-cream-lightest text-ink-primary relative overflow-hidden">

    <div class="container-page relative">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
        <span class="pill mb-6">
          <span class="w-2 h-2 rounded-full bg-accent-lime mr-2"></span>
          Built for everyone
        </span>
        <h2 class="headline-h1 text-ink-primary">
          Who uses <em>Illustrate Words</em>?
        </h2>
        <p class="mt-6 text-lead text-ink-secondary max-w-2xl mx-auto">
          From boardrooms to classrooms, anyone who needs to visualize an idea fast.
        </p>
      </div>

      <!-- Use case cards -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {useCases.map((useCase) => (
          <div class="bg-white border-2 border-ink-primary rounded-3xl p-8 shadow-hard hover:-translate-y-1 transition-all duration-200 flex flex-col relative">
            <div class="w-14 h-14 bg-accent-lavender/10 rounded-full border border-accent-lavender/25 flex items-center justify-center text-accent-lavender mb-5">
              <Fragment set:html={useCase.iconSvg} />
            </div>
            <h3 class="font-serif text-2xl font-semibold text-ink-primary">{useCase.title}</h3>
            <p class="mt-3 text-ink-secondary leading-relaxed">{useCase.description}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 7. FINAL CTA                                                 -->
  <!-- ============================================================ -->
  <section class="section bg-cream text-ink-primary relative overflow-hidden">
    <span aria-hidden="true" class="absolute left-[10%] top-[25%] text-4xl text-accent-lavender/25 pointer-events-none select-none">✦</span>
    <span aria-hidden="true" class="absolute right-[12%] bottom-[20%] text-5xl text-accent-lavender/20 pointer-events-none select-none">✦</span>

    <div class="container-page relative z-10">
      <div class="bg-white border-2 border-ink-primary rounded-3xl shadow-hard max-w-5xl mx-auto p-8 md:p-12 relative overflow-hidden flex flex-col md:flex-row items-center gap-8 justify-between text-left">
        
        <!-- Left Side: Content -->
        <div class="md:w-3/5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-accent-lime/25 text-ink-primary rounded-full border border-accent-lime/40 text-xs font-semibold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-lime animate-pulse"></span>
            Start immediately
          </span>
          <h2 class="font-serif text-3xl md:text-4xl text-ink-primary font-medium tracking-tight mt-4">
            Ready to <em>visualize</em><br />
            your ideas?
          </h2>

          <p class="mt-4 text-base md:text-lg text-ink-secondary leading-relaxed">
            Free, instant, no account needed. Get your first AI-ready visualization prompt in under 60 seconds.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-3 items-start sm:items-center">
            <a href="/generate" class="btn-accent text-base">
              Start Generating Now
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <a href="/gallery" class="btn-secondary text-base">
              Browse Examples
            </a>
          </div>

          <p class="mt-6 text-xs text-ink-tertiary font-medium">
            Works with Gemini · ChatGPT · Claude · Midjourney · DALL·E
          </p>
        </div>

        <!-- Right Side: Floating Doodle -->
        <div class="md:w-2/5 flex justify-center">
          <div class="relative w-44 h-44 md:w-56 md:h-56 flex justify-center items-center">
            <img 
              src="/images/celebration_doodle.png" 
              alt="Celebration Doodle" 
              class="max-w-full max-h-full object-contain animate-float"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style is:global>
  /* Force injected SVGs in category card rounded wrappers to scale properly */
  .group .rounded-full svg {
    width: 1.75rem !important;
    height: 1.75rem !important;
  }
</style>

<script>
  function initSimulation() {
    const cursor = document.getElementById('sim-cursor');
    const simStep1 = document.getElementById('sim-step-1');
    const simStep2 = document.getElementById('sim-step-2');
    const simStep3 = document.getElementById('sim-step-3');
    const simStep4 = document.getElementById('sim-step-4');
    const simStatus = document.getElementById('sim-status-text');
    const simCopyBtn = document.getElementById('sim-copy-btn');
    const simToast = document.getElementById('sim-toast');

    const dots = [
      document.getElementById('sim-dot-1'),
      document.getElementById('sim-dot-2'),
      document.getElementById('sim-dot-3'),
      document.getElementById('sim-dot-4')
    ];

    const views = [simStep1, simStep2, simStep3, simStep4];

    function setStatus(text, activeDotIndex) {
      if (simStatus) simStatus.innerText = text;
      dots.forEach((dot, idx) => {
        if (dot) {
          if (idx === activeDotIndex) {
            dot.className = 'w-2.5 h-2.5 rounded-full bg-accent-lavender border border-ink-primary/20';
          } else {
            dot.className = 'w-2.5 h-2.5 rounded-full bg-cream-darker border border-ink-primary/20';
          }
        }
      });
    }

    function showView(activeViewIndex) {
      views.forEach((view, idx) => {
        if (view) {
          if (idx === activeViewIndex) {
            view.classList.remove('hidden');
          } else {
            view.classList.add('hidden');
          }
        }
      });
    }

    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    async function runLoop() {
      while (true) {
        // RESET STATE
        showView(0);
        setStatus("Step 1: Pick a visualization type", 0);
        if (simToast) {
          simToast.classList.add('opacity-0', 'translate-y-4');
          simToast.classList.remove('opacity-100', 'translate-y-0');
        }
        
        const cardMindmap = document.getElementById('sim-card-mindmap');
        const cardPalette = document.getElementById('sim-card-palette');
        const cardConnector = document.getElementById('sim-card-connector');
        
        if (cardMindmap) {
          cardMindmap.className = 'bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5 transition-all';
          cardMindmap.querySelector('.sim-check')?.classList.add('opacity-0');
          cardMindmap.querySelector('.sim-check')?.classList.remove('opacity-100');
        }
        if (cardPalette) {
          cardPalette.className = 'bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5 transition-all';
          cardPalette.querySelector('.sim-check')?.classList.add('opacity-0');
          cardPalette.querySelector('.sim-check')?.classList.remove('opacity-100');
        }
        if (cardConnector) {
          cardConnector.className = 'bg-cream rounded-card-sm border border-ink-primary/20 opacity-60 p-5 transition-all';
          cardConnector.querySelector('.sim-check')?.classList.add('opacity-0');
          cardConnector.querySelector('.sim-check')?.classList.remove('opacity-100');
        }
        if (simCopyBtn) {
          simCopyBtn.className = 'mt-4 w-full bg-accent-lavender text-cream border border-accent-lavender/10 py-3 rounded-full text-sm font-semibold transition-all shadow-btn flex items-center justify-center gap-1.5';
          const btnText = simCopyBtn.querySelector('span');
          if (btnText) btnText.innerText = 'Copy Prompt';
        }

        if (cursor) {
          cursor.style.top = '80%';
          cursor.style.left = '80%';
          cursor.style.transform = 'scale(1)';
        }

        await sleep(1500);

        // STEP 1: Select Mindmap
        if (cursor) {
          cursor.style.top = '35%';
          cursor.style.left = '25%';
        }
        await sleep(800);
        if (cursor) cursor.style.transform = 'scale(0.8)';
        await sleep(150);
        if (cursor) cursor.style.transform = 'scale(1)';
        
        if (cardMindmap) {
          cardMindmap.className = 'bg-cream rounded-card-sm border-1.5 border-accent-lavender shadow-hard ring-2 ring-accent-lavender p-5 transition-all';
          cardMindmap.querySelector('.sim-check')?.classList.remove('opacity-0');
          cardMindmap.querySelector('.sim-check')?.classList.add('opacity-100');
        }
        await sleep(1500);

        // STEP 2: Transition & Select Palette
        showView(1);
        setStatus("Step 2: Choose your color palette", 1);
        if (cursor) {
          cursor.style.top = '40%';
          cursor.style.left = '55%';
        }
        await sleep(800);
        if (cursor) cursor.style.transform = 'scale(0.8)';
        await sleep(150);
        if (cursor) cursor.style.transform = 'scale(1)';

        if (cardPalette) {
          cardPalette.className = 'bg-cream rounded-card-sm border-1.5 border-accent-lavender shadow-hard ring-2 ring-accent-lavender p-5 transition-all';
          cardPalette.querySelector('.sim-check')?.classList.remove('opacity-0');
          cardPalette.querySelector('.sim-check')?.classList.add('opacity-100');
        }
        await sleep(1500);

        // STEP 3: Transition & Select Connector Style
        showView(2);
        setStatus("Step 3: Fine-tune visual elements", 2);
        if (cursor) {
          cursor.style.top = '35%';
          cursor.style.left = '25%';
        }
        await sleep(800);
        if (cursor) cursor.style.transform = 'scale(0.8)';
        await sleep(150);
        if (cursor) cursor.style.transform = 'scale(1)';

        if (cardConnector) {
          cardConnector.className = 'bg-cream rounded-card-sm border-1.5 border-accent-lavender shadow-hard ring-2 ring-accent-lavender p-5 transition-all';
          cardConnector.querySelector('.sim-check')?.classList.remove('opacity-0');
          cardConnector.querySelector('.sim-check')?.classList.add('opacity-100');
        }
        await sleep(1500);

        // STEP 4: Transition & Copy Prompt
        showView(3);
        setStatus("Step 4: Copy prompt for any AI", 3);
        if (cursor) {
          cursor.style.top = '72%';
          cursor.style.left = '50%';
        }
        await sleep(1000);
        if (cursor) cursor.style.transform = 'scale(0.8)';
        await sleep(150);
        if (cursor) cursor.style.transform = 'scale(1)';

        if (simCopyBtn) {
          simCopyBtn.className = 'mt-4 w-full bg-accent-lime text-cream border border-accent-lime/10 py-3 rounded-full text-sm font-semibold transition-all shadow-btn flex items-center justify-center gap-1.5';
          const btnText = simCopyBtn.querySelector('span');
          if (btnText) btnText.innerText = 'Copied ✓';
        }
        if (simToast) {
          simToast.classList.remove('opacity-0', 'translate-y-4');
          simToast.classList.add('opacity-100', 'translate-y-0');
        }

        await sleep(3500);
      }
    }

    runLoop();
  }

  // Bind simulation lifecycle to browser DOM readiness
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSimulation);
  } else {
    initSimulation();
  }
</script>

