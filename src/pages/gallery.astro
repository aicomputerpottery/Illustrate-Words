---
import Layout from '../layouts/Layout.astro';
import Squiggle from '../components/Squiggle.astro';
import VisualizationMarquee from '../components/VisualizationMarquee.astro';

const pageTitle = "See What VisualCraft Can Create — Examples & Templates";
const pageDescription = "Watch the full workflow and browse ready-to-use visualization templates. Tap any example to load it into the builder. Free and instant.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="bg-cream min-h-screen">
    
    <!-- ============================================================ -->
    <!-- 1. HERO SECTION                                              -->
    <!-- ============================================================ -->
    <section class="bg-forest relative overflow-hidden py-20 md:py-24 text-cream">
      <div class="container-page text-center relative z-10 max-w-4xl mx-auto">
        <span class="pill-lavender mb-6 inline-flex">
          Watch it work
        </span>

        <h1 class="headline-h1 text-cream mb-5">
          From a sentence to a <em>finished</em> visual
        </h1>

        <p class="text-ink-on-dark-secondary text-lg max-w-xl mx-auto">
          No design skills. No software to learn. Watch the exact steps — then do it yourself in about a minute.
        </p>
      </div>

      <!-- Subtle decorative squiggle in bottom left -->
      <div class="absolute bottom-4 left-6 opacity-20 pointer-events-none">
        <Squiggle color="#B5A5F0" width="120" class="rotate-15" />
      </div>
    </section>

    <!-- Cream lip transition -->
    <div class="relative bg-cream h-10 -mt-1 overflow-hidden pointer-events-none">
      <div class="absolute inset-x-0 top-0 h-10 bg-forest" style="clip-path: ellipse(60% 100% at 50% 0%)"></div>
    </div>

    <!-- ============================================================ -->
    <!-- 2. LIVE WORKFLOW DEMO SECTION                                 -->
    <!-- ============================================================ -->
    <section class="section bg-cream" id="live-demo">
      <div class="container-page max-w-5xl mx-auto">
        
        <!-- Header -->
        <div class="text-center mb-10">
          <span class="pill-lime mb-4 inline-flex">
            The whole workflow, in motion
          </span>
          <h2 class="headline-h2 text-ink-primary">
            Pick. Generate. <em>Paste.</em> Done.
          </h2>
          <p class="text-ink-secondary mt-4 max-w-lg mx-auto">
            The same four steps every time — only the destination changes. Switch tabs to see each one.
          </p>
        </div>

        <!-- Scenario Tabs -->
        <div class="flex justify-center mb-6">
          <div class="inline-flex gap-1.5 p-1.5 bg-cream-darker rounded-full border border-cream-darker"
               role="tablist" aria-label="Demo scenarios" id="demo-tabs">
            <button class="demo-tab active px-4 py-2 rounded-btn text-sm font-medium transition-colors" role="tab" data-scenario="blog" aria-selected="true">Blog</button>
            <button class="demo-tab px-4 py-2 rounded-btn text-sm font-medium transition-colors" role="tab" data-scenario="social" aria-selected="false">Social</button>
            <button class="demo-tab px-4 py-2 rounded-btn text-sm font-medium transition-colors" role="tab" data-scenario="docs" aria-selected="false">Docs</button>
            <button class="demo-tab px-4 py-2 rounded-btn text-sm font-medium transition-colors" role="tab" data-scenario="presentation" aria-selected="false">Presentation</button>
          </div>
        </div>

        <!-- Faux Browser Stage -->
        <div class="relative mx-auto max-w-[860px]">
          <div id="demo-stage"
               class="demo-stage relative rounded-card border border-cream-darker bg-white
                      shadow-card overflow-hidden select-none"
               style="aspect-ratio: 16 / 10;"
               aria-label="Animated demonstration of the VisualCraft workflow"
               role="img">

            <!-- Browser chrome bar -->
            <div class="absolute top-0 inset-x-0 h-9 bg-cream-darker border-b border-cream-darker
                        flex items-center gap-2 px-3 z-30">
              <span class="w-2.5 h-2.5 rounded-full bg-accent-orange/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-accent-lime/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-accent-sky/40"></span>
              <div id="demo-urlbar"
                   class="ml-3 flex-1 max-w-[340px] h-5 rounded-full bg-white border border-cream-darker
                          flex items-center px-3 text-[10px] font-mono text-ink-tertiary truncate">
                visualcraft.app/generate
              </div>
            </div>

            <!-- App panels live below the chrome bar -->
            <div class="absolute inset-0 top-9">
              <div id="panel-visualcraft" class="demo-panel transition-all duration-200"></div>
              <div id="panel-ai"          class="demo-panel opacity-0 pointer-events-none transition-all duration-200"></div>
              <div id="panel-destination" class="demo-panel opacity-0 pointer-events-none transition-all duration-200"></div>
            </div>

            <!-- The cursor — single element, moves over everything -->
            <div id="demo-cursor" class="demo-cursor z-40 absolute pointer-events-none transition-all duration-700 ease-in-out" aria-hidden="true" style="top: 80%; left: 80%;">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <path d="M3 2 L3 17 L7.5 13 L10.5 19.5 L13 18.3 L10 12 L16 12 Z"
                      fill="#1C1A18" stroke="#FFFFFF" stroke-width="1.2" stroke-linejoin="round"/>
              </svg>
            </div>

          </div>
        </div>

        <!-- Progress bar + controls -->
        <div class="max-w-[860px] mx-auto mt-6 flex flex-col items-center gap-3">
          <div id="demo-progress" class="flex items-center gap-2" aria-hidden="true"></div>
          <p class="text-sm font-sans text-ink-secondary">
            <span id="demo-stepnum" class="font-semibold text-ink-primary">Step 1 of 8</span>
            <span class="mx-2 text-ink-tertiary">—</span>
            <span id="demo-caption">Choosing a visualization type</span>
          </p>
          <div class="flex gap-3">
            <button id="demo-pause" class="btn-secondary text-xs px-4 py-2">⏸ Pause</button>
            <button id="demo-replay" class="btn-ghost text-xs px-4 py-2">↻ Replay</button>
          </div>
        </div>

        <!-- Prefers reduced motion static storyboard -->
        <div id="static-storyboard" class="hidden grid grid-cols-1 sm:grid-cols-4 gap-6 max-w-[860px] mx-auto mt-8">
          <!-- Populated by JS storyboard render -->
        </div>

      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. MOVING SHOWCASE (MARQUEE) SECTION                          -->
    <!-- ============================================================ -->
    <VisualizationMarquee tone="cream-darker" />

    <!-- ============================================================ -->
    <!-- 4. FINAL CTA SECTION                                         -->
    <!-- ============================================================ -->
    <section class="bg-forest section relative overflow-hidden text-cream border-t border-cream-darker/10">
      <span class="absolute top-10 left-12 text-3xl text-accent-lavender/10 select-none pointer-events-none" aria-hidden="true">✦</span>
      <span class="absolute bottom-10 right-16 text-4xl text-accent-lime/10 select-none pointer-events-none" aria-hidden="true">✦</span>
      <div class="container-page text-center relative z-10 max-w-2xl mx-auto">
        <h2 class="headline-h2 text-cream mb-4">
          Now make <em>yours</em>
        </h2>
        <p class="text-ink-on-dark-secondary text-lg mb-8">
          Pick a type, choose a palette, paste your content, copy the prompt. About a minute, start to finish.
        </p>
        <a href="/generate" class="btn-accent text-base px-8 py-4 text-cream font-semibold">Start building — it's free →</a>
        <p class="text-xs text-ink-on-dark-secondary mt-6">
          No account. Works with Gemini, ChatGPT, Claude, and Midjourney.
        </p>
      </div>
    </section>

  </main>
</Layout>

<style is:global>
  /* Demo stage styling */
  .demo-panel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .vc-type {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.35rem 0.5rem;
    border-radius: 4px;
    font-size: 10px;
    border: 1px solid transparent;
    transition: all 0.15s ease;
    color: #6E6B66;
  }
  .vc-type.selected {
    background-color: #EFECE6;
    border-color: #1C1A18;
    color: #1C1A18;
    font-weight: 500;
  }
  .vc-btn-primary {
    background-color: #1C1A18;
    color: #F9F8F4;
    border: 1px solid #1C1A18;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 600;
    transition: all 0.15s ease;
  }
  .vc-btn-primary.vc-pressed {
    transform: scale(0.95);
  }
  .vc-btn-secondary {
    background-color: #FAF6EC;
    color: #0A0A0A;
    border: 1px solid #EBE5D5;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 600;
    transition: all 0.15s ease;
  }
  .vc-btn-secondary.vc-pressed {
    transform: scale(0.95);
  }
  .vc-caret {
    animation: vc-blink 1s steps(2, start) infinite;
  }
  @keyframes vc-blink {
    to { visibility: hidden; }
  }
  .ai-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #9C9890;
    animation: ai-bounce 1.4s infinite ease-in-out both;
  }
  .ai-dot:nth-child(1) { animation-delay: -0.32s; }
  .ai-dot:nth-child(2) { animation-delay: -0.16s; }
  @keyframes ai-bounce {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1); }
  }
  .demo-ripple {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(181, 165, 240, 0.4);
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    z-index: 50;
  }
  .demo-ripple.go {
    animation: demo-ripple-anim 0.5s ease-out forwards;
  }
  @keyframes demo-ripple-anim {
    to { transform: translate(-50%, -50%) scale(2); opacity: 0; }
  }

  /* Marquee infinite scroll styling */
  .marquee-track {
    animation: marquee-scroll-left 45s linear infinite;
  }
  [data-dir="right"] .marquee-track {
    animation: marquee-scroll-right 45s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes marquee-scroll-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* Marquee Card styles */
  .marquee-card {
    display: flex;
    flex-direction: column;
    width: 170px;
    height: 175px;
    border-radius: 12px;
    border: 1.5px solid #0A0A0A;
    background-color: #F4EFE2;
    overflow: hidden;
    transition: all 0.2s ease-out;
    box-shadow: 0px 4px 12px rgba(28, 26, 24, 0.05);
    flex-shrink: 0;
  }
  .marquee-card:hover {
    transform: translateY(-2px);
    box-shadow: 0px 12px 32px rgba(10, 10, 10, 0.08);
  }
  .marquee-card-visual {
    width: 100%;
    height: 130px;
    border-bottom: 1.5px solid #0A0A0A;
  }
  .marquee-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    flex-grow: 1;
    background-color: #FAF6EC;
  }
  .marquee-card-label {
    font-size: 11px;
    font-weight: 500;
    color: #0A0A0A;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 110px;
  }
  .marquee-card-go {
    font-size: 10px;
    font-weight: 600;
    color: #B5A5F0;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.15s ease-out;
  }
  .marquee-card:hover .marquee-card-go {
    opacity: 1;
    transform: translateX(0);
  }

  /* Scenario tabs style */
  .demo-tab {
    padding: 0.5rem 1rem;
    color: #6E6B66;
  }
  .demo-tab[aria-selected="true"] {
    background-color: #1C1A18;
    color: #F9F8F4;
  }
</style>

<script>
  let PALETTES = [];
  const h = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  const SCENARIOS = {
    social: {
      vcType: "funnel",
      vcTypeLabel: "Funnel",
      palette: "berry-pop",
      content: "5 lessons from year one of my startup",
      promptShort: "Create a bold 5-stage funnel infographic, square format, Berry Pop palette…",
      url: "yourbrand.social/create",
      destTitle: "Photo post",
      destUrl: "instagram.com/create/style  ·  square 1:1"
    },
    docs: {
      vcType: "bar",
      vcTypeLabel: "Bar chart",
      palette: "slate-gray",
      content: "Urban food insecurity: access, income, transport, education",
      promptShort: "Create a clean horizontal bar chart, minimal style, Slate Gray palette…",
      url: "docs.example.edu/report",
      destTitle: "Document",
      destUrl: "docs.google.com/document  ·  Research report"
    },
    presentation: {
      vcType: "radar",
      vcTypeLabel: "Radar chart",
      palette: "deep-sapphire",
      content: "Competitors: Miro, Lucidchart, Canva, Figma",
      promptShort: "Create a corporate radar chart comparing four competitors, Deep Sapphire palette…",
      url: "deck.example.com/edit",
      destTitle: "Slide",
      destUrl: "slides.example.com  ·  Q3 Competitive Landscape"
    }
  };
  function getPaletteColors(id) {
    const pal = PALETTES.find(p => p.id === id);
    return pal ? pal.colors : ["#F4EFE2", "#EBE5D5", "#F4A8C9", "#B5A5F0", "#0A0A0A"];
  }

  function miniVisualSVG(kind, palId) {
    const c = getPaletteColors(palId);
    const wrap = (inner) => `<svg viewBox="0 0 120 90" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;background:${c[0]}">${inner}</svg>`;
    
    switch (kind) {
      case "bar":
        return wrap(`
          <rect x="18" y="50" width="14" height="28" fill="${c[1]}" stroke="#1C1A18" stroke-width="1.5"/>
          <rect x="38" y="38" width="14" height="40" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.5"/>
          <rect x="58" y="26" width="14" height="52" fill="${c[3]}" stroke="#1C1A18" stroke-width="1.5"/>
          <rect x="78" y="44" width="14" height="34" fill="${c[4]}" stroke="#1C1A18" stroke-width="1.5"/>
          <line x1="12" y1="78" x2="100" y2="78" stroke="#1C1A18" stroke-width="1.5"/>
        `);
      case "mindmap":
        return wrap(`
          <circle cx="60" cy="45" r="13" fill="${c[3]}" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="24" cy="22" r="7" fill="${c[1]}" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="96" cy="22" r="7" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="22" cy="70" r="7" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="98" cy="70" r="7" fill="${c[4]}" stroke="#1C1A18" stroke-width="1.5"/>
          <line x1="50" y1="38" x2="30" y2="27" stroke="#1C1A18" stroke-width="1.5"/>
          <line x1="70" y1="38" x2="90" y2="27" stroke="#1C1A18" stroke-width="1.5"/>
          <line x1="50" y1="52" x2="29" y2="65" stroke="#1C1A18" stroke-width="1.5"/>
          <line x1="70" y1="52" x2="91" y2="65" stroke="#1C1A18" stroke-width="1.5"/>
        `);
      case "funnel":
        return wrap(`
          <polygon points="24,20 96,20 84,36 36,36" fill="${c[1]}" stroke="#1C1A18" stroke-width="1.5"/>
          <polygon points="38,40 82,40 73,56 47,56" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.5"/>
          <polygon points="49,60 71,60 64,76 56,76" fill="${c[4]}" stroke="#1C1A18" stroke-width="1.5"/>
        `);
      case "timeline":
        return wrap(`
          <line x1="12" y1="45" x2="108" y2="45" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="25" cy="45" r="4.5" fill="${c[1]}" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="48" cy="45" r="4.5" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="71" cy="45" r="4.5" fill="${c[3]}" stroke="#1C1A18" stroke-width="1.5"/>
          <circle cx="94" cy="45" r="4.5" fill="${c[4]}" stroke="#1C1A18" stroke-width="1.5"/>
          <line x1="25" y1="45" x2="25" y2="24" stroke="#1C1A18" stroke-width="1.2"/>
          <rect x="15" y="14" width="20" height="10" rx="2" fill="${c[1]}" stroke="#1C1A18" stroke-width="1.2"/>
          <line x1="48" y1="45" x2="48" y2="66" stroke="#1C1A18" stroke-width="1.2"/>
          <rect x="38" y="66" width="20" height="10" rx="2" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.2"/>
          <line x1="71" y1="45" x2="71" y2="24" stroke="#1C1A18" stroke-width="1.2"/>
          <rect x="61" y="14" width="20" height="10" rx="2" fill="${c[3]}" stroke="#1C1A18" stroke-width="1.2"/>
          <line x1="94" y1="45" x2="94" y2="66" stroke="#1C1A18" stroke-width="1.2"/>
          <rect x="84" y="66" width="20" height="10" rx="2" fill="${c[4]}" stroke="#1C1A18" stroke-width="1.2"/>
        `);
      case "radar":
        return wrap(`
          <polygon points="60,15 88,36 78,69 42,69 32,36" fill="none" stroke="#1C1A18" stroke-width="1" stroke-opacity="0.2"/>
          <polygon points="60,30 74,40 69,57 51,57 46,40" fill="none" stroke="#1C1A18" stroke-width="1" stroke-opacity="0.2"/>
          <line x1="60" y1="45" x2="60" y2="15" stroke="#1C1A18" stroke-width="1" stroke-opacity="0.1"/>
          <line x1="60" y1="45" x2="88" y2="36" stroke="#1C1A18" stroke-width="1" stroke-opacity="0.1"/>
          <line x1="60" y1="45" x2="78" y2="69" stroke="#1C1A18" stroke-width="1" stroke-opacity="0.1"/>
          <line x1="60" y1="45" x2="42" y2="69" stroke="#1C1A18" stroke-width="1" stroke-opacity="0.1"/>
          <line x1="60" y1="45" x2="32" y2="36" stroke="#1C1A18" stroke-width="1" stroke-opacity="0.1"/>
          <polygon points="60,25 80,38 72,62 48,59 38,39" fill="${c[3]}" fill-opacity="0.4" stroke="${c[4]}" stroke-width="1.5"/>
          <circle cx="60" cy="25" r="2.5" fill="${c[4]}"/>
          <circle cx="80" cy="38" r="2.5" fill="${c[4]}"/>
          <circle cx="72" cy="62" r="2.5" fill="${c[4]}"/>
          <circle cx="48" cy="59" r="2.5" fill="${c[4]}"/>
          <circle cx="38" cy="39" r="2.5" fill="${c[4]}"/>
        `);
      case "line":
        return wrap(`
          <polyline points="15,72 40,50 65,58 95,22" fill="none" stroke="${c[3]}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="15" cy="72" r="3.5" fill="${c[4]}" stroke="#1C1A18" stroke-width="1"/>
          <circle cx="40" cy="50" r="3.5" fill="${c[4]}" stroke="#1C1A18" stroke-width="1"/>
          <circle cx="65" cy="58" r="3.5" fill="${c[4]}" stroke="#1C1A18" stroke-width="1"/>
          <circle cx="95" cy="22" r="3.5" fill="${c[4]}" stroke="#1C1A18" stroke-width="1"/>
          <line x1="10" y1="78" x2="110" y2="78" stroke="#1C1A18" stroke-width="1.2"/>
        `);
      case "pie":
        return wrap(`
          <path d="M 60 45 L 60 15 A 30 30 0 0 1 90 45 Z" fill="${c[1]}" stroke="#1C1A18" stroke-width="1.2"/>
          <path d="M 60 45 L 90 45 A 30 30 0 0 1 60 75 Z" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.2"/>
          <path d="M 60 45 L 60 75 A 30 30 0 0 1 30 45 Z" fill="${c[3]}" stroke="#1C1A18" stroke-width="1.2"/>
          <path d="M 60 45 L 30 45 A 30 30 0 0 1 60 15 Z" fill="${c[4]}" stroke="#1C1A18" stroke-width="1.2"/>
        `);
      case "flow":
        return wrap(`
          <rect x="12" y="33" width="22" height="24" rx="4" fill="${c[1]}" stroke="#1C1A18" stroke-width="1.2"/>
          <rect x="49" y="33" width="22" height="24" rx="4" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.2"/>
          <rect x="86" y="33" width="22" height="24" rx="4" fill="${c[4]}" stroke="#1C1A18" stroke-width="1.2"/>
          <line x1="34" y1="45" x2="44" y2="45" stroke="#1C1A18" stroke-width="1.5"/>
          <polygon points="44,42 49,45 44,48" fill="#1C1A18"/>
          <line x1="71" y1="45" x2="81" y2="45" stroke="#1C1A18" stroke-width="1.5"/>
          <polygon points="81,42 86,45 81,48" fill="#1C1A18"/>
        `);
      default:
        return wrap(`<rect x="20" y="20" width="80" height="50" fill="${c[2]}" stroke="#1C1A18" stroke-width="1.5"/>`);
    }
  }

  const STAR_SVG = `
    <svg width="14" height="14" viewBox="0 0 13 13" fill="#B5A5F0" aria-hidden="true">
      <path d="M6.5 0 L7.6 5.4 L13 6.5 L7.6 7.6 L6.5 13 L5.4 7.6 L0 6.5 L5.4 5.4 Z"/>
    </svg>
  `;

  function renderVisualCraftPanelHTML() {
    return `
      <div class="w-full h-full bg-cream flex text-ink-primary">
        <!-- left rail -->
        <div class="w-[38%] border-r border-cream-darker p-3 space-y-2 overflow-hidden">
          <div class="text-[9px] font-sans font-semibold text-ink-tertiary uppercase tracking-wide mb-1">Choose a type</div>
          <button class="vc-type" data-vc="bar">Bar chart</button>
          <button class="vc-type" data-vc="mindmap">Mindmap</button>
          <button class="vc-type" data-vc="funnel">Funnel</button>
          <button class="vc-type" data-vc="timeline">Timeline</button>
          <button class="vc-type" data-vc="radar">Radar chart</button>
        </div>
        <!-- right side -->
        <div class="flex-1 p-3 flex flex-col gap-3">
          <div>
            <div class="text-[9px] font-sans font-semibold text-ink-tertiary uppercase tracking-wide mb-1.5">Palette</div>
            <div class="flex gap-1.5" id="vc-palettes"></div>
          </div>
          <div>
            <div class="text-[9px] font-sans font-semibold text-ink-tertiary uppercase tracking-wide mb-1.5">Your content</div>
            <div id="vc-textarea"
