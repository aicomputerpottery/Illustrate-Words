  async function executeScenario(runner, scenarioName, progressUI) {
    const list = STEPS_FACTORY[scenarioName](runner);
    progressUI.setTotal(list.length);
    try {
      for (let i = 0; i < list.length; i++) {
        if (runner.cancelled) return;
        progressUI.setStep(i + 1, list[i].caption);
        await list[i].run();
      }
      progressUI.markComplete();
    } catch (e) {
      if (e !== "cancelled") {
        console.error(e);
      }
    }
  }

  const stage = document.getElementById("demo-stage");
  let runnerInstance = null;
  const order = ["blog", "social", "docs", "presentation"];
  let currentIndex = 0;
  let tabOverrideActive = false;

  const progressUI = {
    setTotal(total) {
      const wrapper = document.getElementById("demo-progress");
      if (wrapper) {
        wrapper.innerHTML = "";
        for (let i = 0; i < total; i++) {
          const point = document.createElement("span");
          point.className = "w-2.5 h-2.5 rounded-full bg-ink-primary/15 transition-all duration-300";
          wrapper.appendChild(point);
          if (i < total - 1) {
            const bar = document.createElement("span");
            bar.className = "w-4 h-0.5 bg-ink-primary/10";
            wrapper.appendChild(bar);
          }
        }
      }
    },
    setStep(stepNum, captionText) {
      const wrapper = document.getElementById("demo-progress");
      const stepEl = document.getElementById("demo-stepnum");
      const captionEl = document.getElementById("demo-caption");
      if (stepEl) {
        stepEl.textContent = `Step ${stepNum} of 8`;
      }
      if (captionEl) {
        captionEl.textContent = captionText;
      }
      if (wrapper) {
        const points = wrapper.querySelectorAll("span:not(.w-4)");
        const bars = wrapper.querySelectorAll("span.w-4");
        points.forEach((pt, idx) => {
          if (idx < stepNum) {
            pt.className = "w-2.5 h-2.5 rounded-full bg-ink-primary transition-all duration-300";
          } else {
            pt.className = "w-2.5 h-2.5 rounded-full bg-ink-primary/15 transition-all duration-300";
          }
        });
        bars.forEach((bar, idx) => {
          if (idx < stepNum - 1) {
            bar.className = "w-4 h-0.5 bg-ink-primary/40";
          } else {
            bar.className = "w-4 h-0.5 bg-ink-primary/10";
          }
        });
      }
    },
    markComplete() {
      const wrapper = document.getElementById("demo-progress");
      if (wrapper) {
        wrapper.querySelectorAll("span").forEach(s => {
          if (s.classList.contains("w-2.5")) {
            s.className = "w-2.5 h-2.5 rounded-full bg-accent-lavender transition-all duration-300";
          }
        });
      }
    }
  };

