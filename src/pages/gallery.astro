  class FlowRunner {
    constructor(stage) {
      this.stage = stage;
      this.cursor = stage.querySelector("#demo-cursor");
      this.cancelled = false;
      this.paused = false;
      this._lastXY = { x: 40, y: 40 };
    }

    cancel() {
      this.cancelled = true;
    }

    async _sleep(ms) {
      const limit = performance.now() + ms;
      while (performance.now() < limit) {
        if (this.cancelled) throw "cancelled";
        if (this.paused) {
          await h(80);
        } else {
          await h(Math.min(40, limit - performance.now()));
        }
      }
    }

    _centerOf(selector) {
      const el = this.stage.querySelector(selector);
      if (!el) return null;
      const stageRect = this.stage.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      return {
        x: elRect.left - stageRect.left + elRect.width / 2,
        y: elRect.top - stageRect.top + elRect.height / 2,
        el: el
      };
    }

    async moveTo(selector, duration = 650) {
      const coord = this._centerOf(selector);
      if (coord) {
        this.cursor.style.transform = `translate(${coord.x}px, ${coord.y}px)`;
        this._lastXY = { x: coord.x, y: coord.y };
        await this._sleep(duration);
      }
    }

    async click(selector) {
      if (selector) {
        await this.moveTo(selector, 0);
      }
      const { x, y } = this._lastXY;
      this.cursor.style.setProperty("--cx", `${x}px`);
      this.cursor.style.setProperty("--cy", `${y}px`);
      this.cursor.classList.add("is-clicking");
      this._ripple(x, y);

      if (selector) {
        const el = this.stage.querySelector(selector);
        el?.classList.add("vc-pressed");
        setTimeout(() => el?.classList.remove("vc-pressed"), 200);
      }
      await this._sleep(300);
      this.cursor.classList.remove("is-clicking");
      this.cursor.style.transform = `translate(${x}px, ${y}px)`;
    }

    _ripple(x, y) {
      const div = document.createElement("div");
      div.className = "demo-ripple";
      div.style.left = `${x}px`;
      div.style.top = `${y}px`;
      this.stage.appendChild(div);
      requestAnimationFrame(() => div.classList.add("go"));
      setTimeout(() => div.remove(), 520);
    }

    async type(selector, text, interval = 28) {
      const el = this.stage.querySelector(selector);
      if (el) {
        el.textContent = "";
        for (const char of text) {
          if (this.cancelled) throw "cancelled";
          while (this.paused) await h(80);
          el.textContent += char;
          await h(interval);
        }
      }
    }

    show(selector) {
      this.stage.querySelector(selector)?.classList.remove("hidden");
    }

    hide(selector) {
      this.stage.querySelector(selector)?.classList.add("hidden");
    }

    setText(selector, text) {
      const el = this.stage.querySelector(selector);
      if (el) el.textContent = text;
    }

    setHTML(selector, html) {
      const el = this.stage.querySelector(selector);
      if (el) el.innerHTML = html;
    }

    async switchPanel(panelSelector, urlText) {
      ["#panel-visualcraft", "#panel-ai", "#panel-destination"].forEach(sel => {
        const p = this.stage.querySelector(sel);
        const match = sel === panelSelector;
        if (p) {
          p.style.opacity = match ? "1" : "0";
          p.style.pointerEvents = match ? "auto" : "none";
          p.style.transform = match ? "translateX(0)" : "translateX(8px)";
        }
      });
      if (urlText) {
        this.setText("#demo-urlbar", urlText);
      }
      await this._sleep(420);
    }
  }

