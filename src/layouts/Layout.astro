---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
  noindex?: boolean;
  type?: string;
}

const {
  title = 'Illustrate Words — Turn any idea into a stunning visualization',
  description = 'Free Napkin AI alternative. Pick your chart type, choose your colors, and get an AI-ready prompt in seconds. Works with Gemini, ChatGPT, Claude, and Midjourney.',
  image = '/og-image.png',
  hideFooter = false,
  noindex = false,
  type = 'website',
} = Astro.props;

const SITE_NAME = 'Illustrate Words';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://illustratewords.com').href.replace(/\/$/, '') || (Astro.site ? Astro.site.href : 'https://illustratewords.com');
const ogImageURL = new URL(image, Astro.site || 'https://illustratewords.com').href;

// Sitewide structured data: who we are + the site itself.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE_NAME,
  "url": Astro.site?.href || 'https://illustratewords.com',
  "logo": new URL("/icon-512.png", Astro.site || 'https://illustratewords.com').href,
  "description": "Free, browser-based tool that turns ideas into copy-paste AI prompts for visualizations."
};

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": Astro.site?.href || 'https://illustratewords.com'
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F9F8F4" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts preconnect and link -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Sitewide structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-cream">
    <Navbar />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BHE0HWPXDL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BHE0HWPXDL');
    </script>
    <main class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
