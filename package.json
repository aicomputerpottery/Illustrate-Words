    "sync-blog:watch": "node scripts/sync-blog.mjs --watch"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.0.0",
    "tailwindcss": "^3.4.17"
  }
}
